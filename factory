# gate_dialog_prompt role [paths]: the approval dialog the agent is to show. Its header tells the
# hook Factory's dialog from the agent's own questions, and its labels are the hook's choices;
# the plan's waiver names in its description the paths it allows, the ones the plan names.
gate_dialog_prompt() {
  local options='"Approve" and "Abort"'
  [[ $1 == build ]] || options="\"Approve\", \"Approve, allow protected paths\" (described as \"Allows the protected paths the plan names: ${2:-none}\") and \"Abort\""
  printf 'Ask the human with your AskUserQuestion tool: one question, header "fy %s", text "Approve the %s for %s, or type a note to have it revised?", options %s, in that order. Factory takes the answer from the dialog itself, so do not act on it or run anything; once it is answered or dismissed, reply with just DONE.' "$1" "$1" "$TASK_ID" "$options"
}

# ----------------------------------------------------------- human gates ----
# human_gate plan|build agent dir: show the plan in the run dir, or the branch's commits and
# diff stat, and wait for the human: an answer in this terminal, or the files `factory
# approve`, `factory reject` and `factory abort` write into Factory's state for the task, out
# of the run dir, which the agents write. A plan note goes to the planner and through a plan
# review round of its own, then the plan is shown again; a build note is left in HUMAN_NOTE and
# 4 is returned for another round. 3 aborts. While the gate listens, waiting in the task's
# state names it and this run for those commands; it says typing while this terminal takes a
# note, and note while a plan note's round runs. The agent also asks the human in a question
# dialog in its pane, whose hook answers the gate as the commands do (show_dialog).
human_gate() {
  local rc=0
  [[ $FACTORY_APPROVAL == ask ]] || return 0
  await_human "$@" || rc=$?
  rm -f "$TASK_STATE/waiting"
  dismiss_dialog "$1" "$2" "$3"
  return "$rc"
}

# await_human plan|build agent dir: human_gate's waiting, for an answer in a pane or with fy
# (file_answer), or in this terminal (terminal_answer), until one ends the gate
await_human() {
  local role=$1 agent=$2 dir=$3 stdin_open=1 rc
  while :; do
    drop_dead_dialog "$role" "$agent" "$dir"
    toast "$TASK_ID $role ready" "$TASK_TITLE. Answer in the $(role_of "$role")'s pane or Factory's terminal." request
    show_for_approval "$role" "$dir"
    open_gate "$role"
    show_dialog "$role" "$agent" "$dir"
    ((stdin_open)) || no_terminal_hint "$role" "$dir"
    while :; do
      rc=0
      file_answer "$role" "$agent" "$dir" || rc=$?
      if ((rc == NO_ANSWER && stdin_open)); then
        rc=0
        terminal_answer "$role" "$agent" "$dir" || rc=$?
      elif ((rc == NO_ANSWER)); then
        sleep "$POLL_SECONDS"
      fi
      case $rc in
        "$NO_ANSWER") ;;
        "$NOTE_TAKEN") continue 2 ;; # the revised plan, shown again
        "$NO_TERMINAL")
          stdin_open=0
          no_terminal_hint "$role" "$dir"
          ;;
        *) return "$rc" ;;
      esac
    done
  done
}

# the statuses of file_answer and terminal_answer besides human_gate's own (0 approved, 3
# aborted, 4 a build note): no answer yet, a plan note taken (the plan revised and reviewed
# again), and this terminal closed
NO_ANSWER=10 NOTE_TAKEN=11 NO_TERMINAL=12

# file_answer plan|build agent dir: the answer a pane's dialog or fy approve, reject or abort
# left in Factory's state for the task, if any
file_answer() {
  local role=$1 agent=$2 dir=$3 st=$TASK_STATE note
  if [[ -e $st/aborted ]]; then
    rm -f "$st/aborted" "$st/waiting"
    printf '\n' >&2
    log "aborted in a pane or with factory abort"
    record_answer "$dir" "$role aborted"
    return 3
  fi
  if [[ -s $st/reject.md ]]; then
    note=$(<"$st/reject.md")
    rm -f "$st/reject.md"
    close_gate "$role" "$agent" "$dir"
    printf '\n' >&2
    log "note received in a pane or with factory reject"
    record_answer "$dir" "note on the $role: $note"
    pause_for_pane_reply
    take_note "$role" "$agent" "$note" || return $?
    return "$NOTE_TAKEN"
  fi
  if [[ -e $st/approved ]]; then
    rm -f "$st/approved" "$st/waiting"
    printf '\n' >&2
    log "approved in a pane or with factory approve"
    if [[ $role == plan ]] && waived; then
      record_answer "$dir" "plan approved, protected paths allowed"
    else
      record_answer "$dir" "$role approved"
    fi
    pause_for_pane_reply
    return 0
  fi
  return "$NO_ANSWER"
}

# terminal_answer plan|build agent dir: a key typed in this terminal within POLL_SECONDS
terminal_answer() {
  local role=$1 agent=$2 dir=$3 answer note rc=0
  read -r -t "$POLL_SECONDS" answer || rc=$?
  ((rc <= 128)) || return "$NO_ANSWER" # timed out
  ((rc == 0)) || return "$NO_TERMINAL"
  case $answer in
    a | A)
      record_answer "$dir" "$role approved"
      return 0
      ;;
    p | P)
      if [[ $role == plan ]]; then
        waive_protected "$TASK_STATE"
        record_answer "$dir" "plan approved, protected paths allowed"
        return 0
      fi
      ;;
    r | R)
      # an answer a pane sent while this terminal waited for its key came first
      [[ ! -e $TASK_STATE/approved && ! -e $TASK_STATE/aborted && ! -s $TASK_STATE/reject.md ]] || return "$NO_ANSWER"
      printf 'typing %s\n' "$$" >"$TASK_STATE/waiting" # the answer comes from this terminal now
      printf '%s note for the %s: ' "$TAG" "$(role_of "$role")" >&2
      if ! read -r note; then
        record_answer "$dir" "$role aborted"
        return 3
      fi
      if [[ -n $note ]]; then
        close_gate "$role" "$agent" "$dir"
        record_answer "$dir" "note on the $role: $note"
        take_note "$role" "$agent" "$note" || return $?
        return "$NOTE_TAKEN"
      fi
      printf '%s %s\n' "$role" "$$" >"$TASK_STATE/waiting" # no note after all: the gate listens again
      ;;
    b | B)
      record_answer "$dir" "$role aborted"
      return 3
      ;;
  esac
  printf '%s %s? ' "$TAG" "$(approval_keys "$role")" >&2 # only the keys shown mean anything; ask again in place
  return "$NO_ANSWER"
}

# approval_keys plan|build -> the keys the gate takes, as a terminal shows them
approval_keys() {
  if [[ $1 == plan ]]; then
    printf '%s, %s, %s or %s' "$(key a)" "$(key p)" "$(key r)" "$(key b)"
  else
    printf '%s, %s or %s' "$(key a)" "$(key r)" "$(key b)"
  fi
}

# drop_dead_dialog role agent dir: an agent that runs without the run's dialog hooks, as Herdr
# restores agents while a run goes on, gets no approval dialog, whose answer would not reach the
# gate. Its hooks file goes, which tells the rest of the gate so.
drop_dead_dialog() {
  local rc=0
  [[ -e $3/hooks-$1.json ]] || return 0
  launched_with "$2" --settings "$3/hooks-$1.json" || rc=$?
  ((rc == 1)) || return 0
  rm -f "$3/hooks-$1.json"
  warn "$2 runs without its dialog hooks: no approval dialog in its pane; answer here or with fy"
}

# open_gate role: the gate listens to approve, reject and abort, in Factory's state for the
# task. Answers left from before were about something else, and no plan approval stands, so
# neither does its waiver. ASKED_AT is when it opened, for the answer's event.
open_gate() {
  mkdir -p "${TASK_STATE:?}"
  rm -f "$TASK_STATE/approved" "$TASK_STATE/reject.md" "$TASK_STATE/aborted"
  [[ $1 == build ]] || rm -f "$TASK_STATE/allow-protected"
  printf '%s %s\n' "$1" "$$" >"$TASK_STATE/waiting"
  ASKED_AT=$SECONDS
}

# close_gate role agent dir: a note was taken. A build note ends the gate; while a plan note's
# round runs, the commands say so instead of taking answers about a plan still changing.
close_gate() {
  if [[ $1 == plan ]]; then
    printf 'note %s\n' "$$" >"$TASK_STATE/waiting"
  else
    rm -f "$TASK_STATE/waiting"
  fi
  dismiss_dialog "$1" "$2" "$3"
}

# show_dialog role agent dir: the approval also as a question dialog in the agent's pane, whose
# hook answers the gate (cmd_dialog_hook). Agents started without the hook show none.
show_dialog() {
  local out
  [[ -e $3/hooks-$1.json ]] || return 0
  if gate_dialog_shown "$2" "$1"; then # still open from before, as after a resume: it answers this gate
    log "$2 shows the $1's approval dialog already"
    return 0
  fi
  if asking "$2"; then # typed into it, the prompt's Enter would answer it
    warn "$2 asks you something already; answer it, then the approval in Factory's terminal or with fy"
    return 0
  fi
  out=$(herdr agent prompt "$2" "$(gate_dialog_prompt "$1" "$(protected_named "$3/plan.md" | listed)")" 2>&1) \
    || warn "$2: no approval dialog: $(herr_msg "$out")"
}

# dismiss_dialog role agent dir: once the gate has its answer, an approval dialog the agent
# still shows goes with Esc, and Claude Code tells the agent the human declined it. A turn
# still on its way to showing it gets a minute.
dismiss_dialog() {
  [[ -e $3/hooks-$1.json ]] || return 0
  herdr agent wait "$2" --until blocked --until idle --until "done" --timeout 60000 >/dev/null 2>&1 || return 0
  gate_dialog_shown "$2" "$1" || return 0
  esc_question "$2"
  log "$2: dismissed its approval dialog, answered elsewhere"
}

# esc_question agent: Esc on the agent's question dialog. Its session records the dismissal a
# moment later, and until then asking takes the question for open still: the next ask would
# tell the human that the agent waits for them. So this waits for it, ten seconds at most.
esc_question() {
  keys "$1" esc
  poll 10 1 not_asking "$1" || warn "$1: its question dialog is still open after Esc"
}
not_asking() { ! asking "$1"; }

# record_answer run-dir text: one of the human's answers on the task, into its decisions log in
# Factory's state for the task, which the pull request shows and the planner reads in the run
# dir (show_decisions), and as a comment on its bead
record_answer() {
  mkdir -p "$TASK_STATE"
  printf -- '- %s %s\n' "$(date '+%F %R')" "${2//$'\n'/$'\n'  }" >>"$TASK_STATE/decisions.md"
  answer_event "$2"
  show_decisions "$1"
  bd_note "$(repo_of "$1")" "$TASK_ID" "$2"
}

# answer_event text: an answer as record_answer words it, recorded (answer): at which gate,
# approve, waive (approved, protected paths allowed), note or abort, the note, and how long
# the gate had waited since it opened
answer_event() {
  local gate=${1%% *} kind note=""
  case $1 in
    "the "*) return 0 ;; # an agent's own question (cmd_dialog_hook): no gate waited for it
    "note on the "*)
      gate=${1#note on the }
      gate=${gate%%:*}
      kind=note
      note=${1#*: }
      ;;
    *"protected paths allowed") kind=waive ;;
    *approved) kind=approve ;;
    *aborted) kind=abort ;;
    *) kind=other ;;
  esac
  metric answer gate "$gate" answer "$kind" note "$note" secs $((SECONDS - ${ASKED_AT:-$SECONDS}))
}

# show_decisions run-dir: the human's answers on the task, as Factory keeps them, into the run
# dir for the planner to read, over whatever an agent left there
show_decisions() {
  if [[ -s $TASK_STATE/decisions.md ]]; then
    cp "$TASK_STATE/decisions.md" "$1/decisions.md"
  else
    rm -f "$1/decisions.md"
  fi
}

# no_terminal_hint role dir: where a gate takes its answer when this run has no terminal
no_terminal_hint() {
  local where="in one of the task's panes"
  [[ ! -e $2/hooks-$1.json ]] || where="in the $(role_of "$1")'s dialog, or with these in another of the task's panes"
  printf '\n' >&2
  log "no terminal to answer from; waiting for your answer $where: !fy approve, !fy reject '<note>' or !fy abort (or factory approve ${TASK_REPO:-<repo>} $TASK_ID)"
}

# pause_for_pane_reply: Claude Code replies to a command typed after a ! in its pane once the
# command ends; a moment for that reply to get under way, so that the next ask waits for it
pause_for_pane_reply() { sleep 5; }

# role_of plan|build -> planner or builder
role_of() { case $1 in plan) printf planner ;; *) printf builder ;; esac }

# key letter: an approval key, coloured by what it does for a human at a terminal: approving
# green, revising yellow, aborting red
key() {
  local c=32
  case $1 in r) c=33 ;; b) c=31 ;; esac
  if [[ -t 2 ]]; then
    printf '\033[1;%sm%s\033[0m' "$c" "$1"
  else
    printf '%s' "$1"
  fi
}

# take_note role agent note: a plan note goes to the planner and then through a plan round of
# its own, past FACTORY_PLAN_ROUNDS if need be; a build note ends the gate with 4 so the
# caller runs another round
take_note() {
  case $1 in
    plan)
      planner_turn "$2" "$(plan_note_prompt "$3")"
      plan_round "$(($(plan_rounds "$WT/$RUN_DIR") + 1))" "$3"
      ;;
    build)
      HUMAN_NOTE=$3
      return 4
      ;;
  esac
}

# show_md file: Markdown for the human, rendered by glow when it is installed. glow reads
# stdin instead of the file whenever stdin is not a terminal, and the human's answer may be
# waiting there, so it gets none.
show_md() {
  if command -v glow >/dev/null 2>&1; then glow "$1" </dev/null >&2; else sed 's/^/    /' "$1" >&2; fi
}

# plan_rounds dir -> how many plan review rounds left both reviewers' notes in dir; a round
# cut off before the second, by a Ctrl-C or an error, does not count
plan_rounds() {
  local n=0
  while [[ -e $1/plan-review-$((n + 1)).md && -e $1/plan-review-$((n + 1))-build.md ]]; do n=$((n + 1)); done
  printf '%s' "$n"
}

# protected_line plan-file -> what the plan's last line says after Protected paths:, markdown
# or not; 1 when the plan does not end with that line, as the planner is asked to end it
protected_line() {
  local line re='^[[:space:]#>*_-]*protected paths[*_]*:'
  line=$(awk 'NF {line = $0} END {print line}' "$1" 2>/dev/null) || line=""
  [[ ${line,,} =~ $re ]] || return 1
  printf '%s\n' "${line:${#BASH_REMATCH[0]}}"
}

# says_protected plan-file: 0 when the plan ends as the planner is asked to, with its line on
# the protected paths the build must change (Protected paths: none, or which)
says_protected() { protected_line "$1" >/dev/null; }

# protected_named plan-file -> the paths the plan's Protected paths line names, one a line: its
# words, split at spaces, commas, semicolons, quotes and backticks, a remark in parentheses
# left out, without the emphasis and punctuation around a path, a leading ./ or a trailing /;
# and, or and none name nothing
protected_named() {
  local text
  text=$(protected_line "$1") || return 0
  sed -E 's/\([^)]*\)//g' <<<"$text" | tr ",;\`'\"[:space:]" '\n' \
    | sed -E 's/^[*(<]+//; s/[*).,:;>]+$//; s|^\./||; s|/+$||' \
    | awk 'tolower($0) !~ /^(and|or|none)?$/ && !seen[$0]++'
}

# show_for_approval plan|build dir: the plan, or the branch's commits and diff stat, with the keys to answer
show_for_approval() {
  local n v color=never width=80 a p r b esc="" base
  a=$(key a) p=$(key p) r=$(key r) b=$(key b)
  [[ ! -e $2/hooks-$1.json ]] || esc=", after Esc on its dialog," # keys typed into the dialog answer it
  printf '\n%s ' "$TAG" >&2
  if [[ $1 == plan ]]; then
    printf 'plan for %s (%s):\n\n' "$TASK_ID" "$2/plan.md" >&2
    show_md "$2/plan.md"
    if [[ -s $2/plan-changes.md ]]; then # written by the planner after a note; shown once
      printf '\n%s what the planner changed after your note (%s):\n\n' "$TAG" "$2/plan-changes.md" >&2
      show_md "$2/plan-changes.md"
      rm -f "$2/plan-changes.md"
    fi
    n=$(plan_rounds "$2")
    if ((n)); then
      v=$(verdicts "$2/plan-review-$n.md" "$2/plan-review-$n-build.md")
      [[ $2/plan.md -nt $2/plan-review-$n-build.md ]] && v+=" (plan changed since)" # the last revision, a note or a hand edit
      printf '\n%s plan review round %s: %s, notes in %s and %s\n' "$TAG" "$n" "$v" "$2/plan-review-$n.md" "$2/plan-review-$n-build.md" >&2
    fi
    says_protected "$2/plan.md" || warn "the plan does not end with its Protected paths line: ask the planner whether the build must change protected paths"
    printf '\n%s [%s]pprove (edit the file or talk to the planner%s first if you like), a[%s]prove and allow the protected paths it names (%s), [%s]evise with a note, a[%s]ort? (%s/%s/%s/%s) ' "$TAG" "$a" "$esc" "$p" "$(protected_named "$2/plan.md" | listed)" "$r" "$b" "$a" "$p" "$r" "$b" >&2
  else
    base=$(measured_base) || exit 1
    printf 'build for %s on %s, reviews in %s:\n\n' "$TASK_ID" "$BRANCH" "$2" >&2
    if [[ -t 2 ]]; then # git sees only the indenting sed, so it gets the colours and width here
      color=always
      width=$(tput cols 2>/dev/null) || width=80
      [[ $width =~ ^[0-9]+$ ]] || width=80
    fi
    {
      git -C "$WT" log --oneline --color="$color" "$base..HEAD"
      git -C "$WT" diff --stat="$((width - 4))" --color="$color" "$base...HEAD"
    } 2>/dev/null | sed 's/^/    /' >&2 || warn "could not show the branch"
    printf '\n%s [%s]pprove (look at the worktree or talk to the builder%s first if you like), [%s]evise with a note, a[%s]ort? (%s/%s/%s) ' "$TAG" "$a" "$esc" "$r" "$b" "$a" "$r" "$b" >&2
  fi
}

# ------------------------------------------------------------- workspace ----
# worktrees_dir -> Herdr's worktree directory ([worktrees] directory in its config, else its default)
worktrees_dir() {
  local d
  d=$(awk -F'"' '/^\[worktrees\]/ {in_section = 1; next} /^\[/ {in_section = 0} in_section && /^directory *=/ {print $2}' "${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}" 2>/dev/null)
  d=${d:-~/.herdr/worktrees}
  printf '%s' "${d/#\~/$HOME}"
}

# worktree_of repo bead-id -> checkout path of the task's branch, empty if none
worktree_of() {
  # the path whole, a space in it too; the id's dots match only dots
  git -C "$1" worktree list --porcelain | awk -v b="^refs/heads/factory/${2//./[.]}(-|$)" '$1 == "worktree" {p = substr($0, 10)} $1 == "branch" && $2 ~ b {print p}'
}

# worktree_path repo bead-id -> where the task's checkout goes: <worktrees dir>/<repo>/factory-<id>,
# short on purpose; the branch carries the title slug, the directory does not.
worktree_path() { printf '%s/%s/factory-%s' "$(worktrees_dir)" "$(basename "$1")" "$2"; }

# open_workspace repo branch label -> WS WT BUILD_PANE. A workspace the run makes is recorded
# for the workspace script (workspace_script). For one it finds open, Herdr answers with the
# root pane of the tab in front, which may be a tab of yours: the builder's pane is the one
# Factory labelled build there, where there is one.
open_workspace() {
  local out before
  before=$(h workspace list | jq -r '.result.workspaces[]?.workspace_id')
  # Herdr checks out an existing branch too; open is the fallback for a checkout that already exists.
  if ! out=$(herdr worktree create --cwd "$1" --branch "$2" --path "$(worktree_path "$1" "$TASK_ID")" --label "$3" --no-focus 2>&1); then
    log "worktree create failed ($(herr_msg "$out" | tail -n1)); trying to open it"
    out=$(h worktree open --cwd "$1" --branch "$2" --label "$3" --no-focus)
  fi
  WS=$(jq -r '.result.workspace.workspace_id // empty' <<<"$out")
  WT=$(jq -r '.result.worktree.path // empty' <<<"$out")
  BUILD_PANE=$(jq -r '.result.root_pane.pane_id // empty' <<<"$out")
  [[ -n $WS && -n $WT && -n $BUILD_PANE ]] || die "unexpected worktree response: $out"
  if grep -qxF "$WS" <<<"$before"; then
    BUILD_PANE=$(h pane list --workspace "$WS" | jq -r --arg p "$BUILD_PANE" 'first(.result.panes[]? | select(.label == "build") | .pane_id) // $p')
  else
    mkdir -p "$TASK_STATE"
    printf '%s\n' "$WS" >"$TASK_STATE/workspace-script"
  fi
  name_tab "$BUILD_PANE" "$TASK_ID"
}

# name_tab pane label: the tab of the pane, where the agents' panes go, takes the label while it
# bears the number Herdr gave it, as a new one does; a name you gave it stays. A failure is
# told, not fatal: the tab only shows which task is there.
name_tab() {
  local tab
  tab=$(herdr pane get "$1" 2>/dev/null | jq -r '.result.pane.tab_id // empty') && [[ -n $tab ]] || return 0
  herdr tab get "$tab" 2>/dev/null | jq -e '.result.tab | (.label // "") as $l | $l == "" or $l == (.number | tostring)' >/dev/null || return 0
  herdr tab rename "$tab" "$2" >/dev/null 2>&1 || warn "could not name the task's tab $2"
}

# workspace_script: your FACTORY_WORKSPACE_SCRIPT, a command line as the gate's, once in each
# workspace Factory makes for the task (open_workspace records it), when the agents are up
# there; a run that stops before then leaves it to the next. It runs in the worktree, with the
# workspace's id, the worktree and the task's id as its arguments, to open tabs of your own
# (extras/workspace-tabs). It gets no input; a failure is told, not fatal.
workspace_script() {
  [[ $(recorded workspace-script) == "$WS" ]] || return 0
  if [[ -n $FACTORY_WORKSPACE_SCRIPT ]]; then
    local cmd="$FACTORY_WORKSPACE_SCRIPT \"\$@\""
    log "workspace script: $FACTORY_WORKSPACE_SCRIPT"
    (cd "$WT" && bash -c "$cmd" workspace-script "$WS" "$WT" "$TASK_ID") </dev/null \
      || warn "the workspace script failed; the run goes on"
  fi
  rm -f "$TASK_STATE/workspace-script"
}

# ---------------------------------------------------------------- events ----
# events_file [repo-state-dir] -> where the runs of a repo's tasks record what they did, a JSON
# line an event, for fy stats: beside the tasks' state, the task's run's own by default. fy
# clean leaves it.
events_file() { printf '%s/events.jsonl' "${1:-${TASK_STATE%/*}}"; }

# metric event [key value]...: record an event of the task's run, with the time and the task;
# a value of digits goes in as a number. Outside a task there is nothing to record, and a
# record that fails warns, never stops the run.
metric() {
  [[ -n ${TASK_ID:-} && -n ${TASK_STATE:-} ]] || return 0
  local event=$1 args=()
  shift
  while (($# > 1)); do
    args+=(--arg "$1" "$2")
    shift 2
  done
  if ! mkdir -p "${TASK_STATE%/*}" || ! jq -nc --arg t "$(date -u +%FT%TZ)" --arg task "$TASK_ID" --arg event "$event" \
    "${args[@]}" '$ARGS.named | map_values(if test("^(0|[1-9][0-9]*)$") then tonumber else . end)' >>"$(events_file)"; then
    warn "could not record the $event event in $(events_file)"
  fi
}

# run_begins from: a run of the task starts, from its resume point, recorded (run) with
# Factory's version, its commit when it runs from a checkout of its own, the agents' models
# and efforts, and the approval mode. Its end is recorded once (run_end), a die's too.
run_begins() {
  local commit=""
  if [[ $(git -C "$FACTORY_HOME" rev-parse --show-toplevel 2>/dev/null) == "$FACTORY_HOME" ]]; then
    commit=$(git -C "$FACTORY_HOME" rev-parse --short HEAD) || commit=""
  fi
  RUN_ENDED=0
  metric run from "$1" version "$FACTORY_VERSION" commit "$commit" \
    plan "$FACTORY_PLAN_MODEL $FACTORY_PLAN_EFFORT" build "$FACTORY_BUILD_MODEL $FACTORY_BUILD_EFFORT" \
    review "$FACTORY_REVIEW_MODEL $FACTORY_REVIEW_EFFORT" approval "$FACTORY_APPROVAL"
  trap 'run_end failed' EXIT
}

# run_end outcome [key value]...: the run's end, recorded once (end), with the step it ended
# in. An orderly end, done, handed over or stopped at a gate, also records what each agent's
# session has used so far (agent_tokens), a total a later run of the task goes on from.
run_end() {
  [[ ${RUN_ENDED:-1} == 0 ]] || return 0
  RUN_ENDED=1
  metric end outcome "$@" step "${STEP:-}"
  [[ $1 != interrupted && $1 != failed ]] || return 0
  local name
  for name in "$PLAN_AGENT" "$BUILD_AGENT" "$REVIEW_AGENT"; do
    agent_tokens "$name"
  done
}

# agent_tokens agent: the tokens the agent's session has used, recorded (tokens): its input,
# the cached input among it, and its output. Herdr names the session, and its transcript in
# Claude Code's or Codex's own dir has the counts. What cannot be read is warned about, as
# the run goes on.
agent_tokens() {
  local kind="" session="" counts="" input cached output
  read -r kind session < <(herdr agent get "$1" 2>/dev/null \
    | jq -r '.result.agent.agent_session | "\(.agent // "-") \(.value // "")"' 2>/dev/null) || kind=""
  case $kind in
    claude) counts=$(claude_tokens "$session") || counts="" ;;
    codex) counts=$(codex_tokens "$session") || counts="" ;;
  esac
  if [[ -z $counts ]]; then
    warn "no token counts for $1: none read from its session's transcript${session:+ ($session)}"
    return 0
  fi
  read -r input cached output <<<"$counts"
  metric tokens agent "${1##*-}" session "$session" in "$input" cached "$cached" out "$output"
}

# claude_tokens session -> "input cached output" of a Claude Code session and its subagents',
# nothing without a transcript. The transcript repeats a message's usage for each of its
# blocks, so each message counts once.
claude_tokens() {
  local dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects files
  [[ -n $1 ]] || return 0
  mapfile -t files < <(compgen -G "$dir/*/$1.jsonl" && compgen -G "$dir/*/$1/subagents/*.jsonl")
  ((${#files[@]})) || return 0
  jq -rn '[inputs | select(.type == "assistant") | .message | select(.usage)] | group_by(.id)
    | map(max_by(.usage.output_tokens) | .usage)
    | [map(.input_tokens + (.cache_creation_input_tokens // 0) + (.cache_read_input_tokens // 0)),
      map(.cache_read_input_tokens // 0), map(.output_tokens)] | map(add // 0)
    | "\(.[0]) \(.[1]) \(.[2])"' "${files[@]}"
}

# codex_tokens session -> "input cached output" of a Codex session, the total its last count
# gives, nothing without a transcript. Its input includes the cached.
codex_tokens() {
  local files
  [[ -n $1 ]] || return 0
  mapfile -t files < <(compgen -G "${CODEX_HOME:-$HOME/.codex}/sessions/*/*/*/rollout-*-$1.jsonl")
  ((${#files[@]})) || return 0
  jq -rn '[inputs | select(.type == "event_msg" and .payload.type == "token_count")
    | .payload.info.total_token_usage // empty] | last // empty
    | "\(.input_tokens) \(.cached_input_tokens) \(.output_tokens)"' "${files[@]}"
}

# -------------------------------------------------------------- pipeline ----
# Shared task state: setup_task sets TASK_ID TASK_TITLE TASK_DESC TASK_REPO TASK_STATE GATE BASE
#   BRANCH MEMORY and PLAN_AGENT BUILD_AGENT REVIEW_AGENT; open_task_workspace sets WS WT
#   BUILD_PANE; launch_args sets AGENT_ARGS; plan_round sets PLAN_VERDICT; build_phase (run_task
#   on resume) sets ROUND VERDICT STALLED; guard_check sets GUARD_FAILED; task_head sets
#   HEAD_SHA; raise_pr sets PR_URL; HUMAN_NOTE, COPILOT_NOTE and STEP pass between the human
#   gates, the Copilot loop and on_interrupt.

# task_context repo: from TASK_ID and TASK_TITLE, derive TASK_REPO TASK_STATE GATE BASE BRANCH
# and the agent names. The base is the branch the checkout is on as the task starts; a rerun
# keeps the one the task's recorded base was read from (record_base), whatever branch the
# checkout is on by then, and --fresh, starting the task over, takes the checkout's anew.
task_context() {
  local slug recorded
  TASK_REPO=$1
  TASK_STATE=$(task_state "$1" "$TASK_ID")
  GATE=$(resolve_gate "$1")
  BASE=$(git -C "$1" rev-parse --abbrev-ref HEAD)
  if ((! FACTORY_FRESH)) && recorded=$(recorded_base_branch); then
    [[ $recorded == "$BASE" ]] || log "$TASK_ID keeps the base it started from, $recorded; the checkout is on $BASE"
    BASE=$recorded
  fi
  BRANCH=$(branch_of "$1" "$TASK_ID")
  if [[ -z $BRANCH ]]; then
    slug=$(slugify "$TASK_TITLE")
    BRANCH="factory/$TASK_ID${slug:+-$slug}"
  fi
  # Herdr's agent names hold no dot, which a child bead's id has (ab-x7k.1): a _ stands for it
  PLAN_AGENT="${TASK_ID//./_}-plan"
  BUILD_AGENT="${TASK_ID//./_}-build"
  REVIEW_AGENT="${TASK_ID//./_}-review"
}

# setup_task repo arg
setup_task() {
  local repo=$1 arg=$2 st
  resolve_task "$repo" "$arg"
  task_context "$repo"
  ((! FACTORY_PR)) || check_base "$repo"
  check_deps "$repo"
  MEMORY=$(memory_block "$repo")
  log "task $TASK_ID: $TASK_TITLE"
  log "models: plan=$FACTORY_PLAN_MODEL ($FACTORY_PLAN_EFFORT) build=$FACTORY_BUILD_MODEL ($FACTORY_BUILD_EFFORT) review=$FACTORY_REVIEW_MODEL ($FACTORY_REVIEW_EFFORT)"
  log "gate: $GATE$([[ -n ${FACTORY_GATE:-} || -f $repo/.factory/gate ]] || printf ' (detected from the repo; add .factory/gate to make it explicit)') | base: $BASE | rounds: plan $FACTORY_PLAN_ROUNDS, build $FACTORY_ROUNDS | approval: $FACTORY_APPROVAL | claude: $FACTORY_CLAUDE_PERMISSIONS"
  if ! bd -C "$repo" update "$TASK_ID" --claim >/dev/null 2>&1; then
    st=$(bd_field "$repo" "$TASK_ID" '.status') || st=""
    die "cannot claim $TASK_ID (status: ${st:-unknown}); reopen it with: bd -C $repo reopen $TASK_ID"
  fi
}

# open_task_workspace repo
open_task_workspace() {
  local exclude
  open_workspace "$1" "$BRANCH" "$TASK_ID $TASK_TITLE"
  mkdir -p "$WT/$RUN_DIR" "$TASK_STATE"
  # starting over: from here on, a run that stops before its first step leaves none of the old
  # steps standing for a rerun to resume after (resume_point)
  ((! FACTORY_FRESH)) || rm -f "$TASK_STATE/state"
  # the repo's info/exclude, one for all its worktrees, keeps the run dir out of git status
  exclude=$(git -C "$1" rev-parse --path-format=absolute --git-path info/exclude)
  grep -qsxF "$RUN_DIR/" "$exclude" || printf '%s/\n' "$RUN_DIR" >>"$exclude"
  ((! FACTORY_FRESH)) || rm -f "$TASK_STATE/base" # starting over, from the checkout's branch (task_context)
  start_from_origin
  record_base
  # a task that starts on a checkout git reads as changed would fail every check after hours of work
  local dirty
  if [[ -z $(recorded state) ]]; then
    dirty=$(tree_state "$WT")
    if [[ -n $dirty ]]; then
      printf '%s\n' "$dirty" >&2
      die "$WT reads as changed before any work on $TASK_ID (above): commit, stash or remove what is there; then rerun"
    fi
  fi
  log "workspace $WS at $WT"
}

# start_or_adopt_agents repo: three agents in three panes, or on a rerun the task's agents in its
# workspace, adopted while one of them lives on (adopt_agent)
start_or_adopt_agents() {
  local repo=$1 live plan_pane review_pane pane repo_root role
  live=$(live_agents "$WS" "$PLAN_AGENT" "$BUILD_AGENT" "$REVIEW_AGENT")
  repo_root=$(git -C "$repo" rev-parse --show-toplevel)
  if [[ $live != 0 ]]; then
    log "reusing the live agents of $TASK_ID in workspace $WS"
    for role in plan build review; do
      adopt_agent "$role" "$repo_root"
    done
    return 0
  fi
  # the fresh start takes the builder's pane as it is, and types into its shell: never into what
  # runs there instead. In front, not shell_waits: a new workspace's shell may not have its line
  # editor up yet.
  [[ $BUILD_PANE != "${HERDR_PANE_ID:-}" ]] \
    || die "this run is in the builder's pane $BUILD_PANE, which a fresh start of the agents takes: rerun Factory from another pane or terminal"
  poll 10 1 shell_in_front "$BUILD_PANE" \
    || die "something runs in the builder's pane $BUILD_PANE, which a fresh start of the agents takes: end it, then rerun"
  # a question the old agents left open went with their sessions, whose transcripts will
  # never close it: its marks would have the fresh agents wait for an answer forever
  rm -f "$WT/$RUN_DIR/asking-plan" "$WT/$RUN_DIR/asking-build"
  close_extra_panes "$WS" "$BUILD_PANE"
  # builder left, planner over reviewer right; equal columns, the planner a little taller
  plan_pane=$(h pane split --pane "$BUILD_PANE" --direction right --ratio 0.5 --cwd "$WT" --no-focus | jq -r '.result.pane.pane_id // empty')
  review_pane=$(h pane split --pane "${plan_pane:?herdr split no pane}" --direction down --ratio 0.6 --cwd "$WT" --no-focus | jq -r '.result.pane.pane_id // empty')
  : "${review_pane:?herdr split no pane}"
  h pane rename "$BUILD_PANE" build >/dev/null
  h pane rename "$plan_pane" plan >/dev/null
  h pane rename "$review_pane" review >/dev/null
  sleep 1 # the new panes' shells start up
  write_env
  for pane in "$BUILD_PANE" "$plan_pane" "$review_pane"; do
    prime_shell "$pane"
  done
  dialog_hooks plan >"$WT/$RUN_DIR/hooks-plan.json"
  dialog_hooks build >"$WT/$RUN_DIR/hooks-build.json"
  launch_args plan "$repo_root"
  start_agent "$PLAN_AGENT" claude "$plan_pane" "${AGENT_ARGS[@]}"
  launch_args build "$repo_root"
  start_agent "$BUILD_AGENT" claude "$BUILD_PANE" "${AGENT_ARGS[@]}"
  set_color "$PLAN_AGENT" purple
  set_color "$BUILD_AGENT" cyan
  launch_args review "$repo_root"
  start_agent "$REVIEW_AGENT" codex "$review_pane" "${AGENT_ARGS[@]}"
  log "agents up: $PLAN_AGENT $BUILD_AGENT $REVIEW_AGENT"
}

# write_env: the agents get Factory's PATH (bd, gate tools) via a short command, which
# prime_shell runs in their panes; a long inline export trips line editors such as ble.sh into
# multiline mode
write_env() { printf "export PATH='%s'\n" "$PATH" >"$WT/$RUN_DIR/env.sh"; }

# launch_args plan|build|review repo-root: AGENT_ARGS, the arguments Factory starts the task's
# planner, builder or reviewer with
launch_args() {
  case $1 in
    plan) AGENT_ARGS=(--model "$FACTORY_PLAN_MODEL" --effort "$FACTORY_PLAN_EFFORT" --permission-mode "$FACTORY_CLAUDE_PERMISSIONS" --settings "$WT/$RUN_DIR/hooks-plan.json" --name plan) ;;
    build) AGENT_ARGS=(--model "$FACTORY_BUILD_MODEL" --effort "$FACTORY_BUILD_EFFORT" --permission-mode "$FACTORY_CLAUDE_PERMISSIONS" --settings "$WT/$RUN_DIR/hooks-build.json" --name build) ;;
    review)
      AGENT_ARGS=(-m "$FACTORY_REVIEW_MODEL" -a never -s workspace-write --search
        -c "model_reasoning_effort=\"$FACTORY_REVIEW_EFFORT\""
        -c "projects={\"$2\"={trust_level=\"trusted\"}}"
        -c "sandbox_workspace_write.writable_roots=[\"$2/.beads\"]")
      ;;
  esac
}

# adopt_agent plan|build|review repo-root: the task's agent in the role, on a rerun that found
# some of them alive. A live one is kept (relaunch_restored). One that is gone, its CLI quit or
# crashed, as for a switch of accounts, starts again in its own pane with a new session; a
# question it had open went with the old one.
adopt_agent() {
  local role=$1 name=$PLAN_AGENT kind=claude colour=purple pane rc=0
  case $role in
    build) name=$BUILD_AGENT colour=cyan ;;
    review) name=$REVIEW_AGENT kind=codex ;;
  esac
  if [[ $(live_agents "$WS" "$name") == 1 ]]; then
    settle_dialogs "$name" quiet
    relaunch_restored "$role" "$2"
    return 0
  fi
  pane=$(own_pane "$role") || rc=$?
  ((rc != 2)) || die "$name is gone from workspace $WS, and this run is in its pane ($HERDR_PANE_ID), where it starts again: rerun Factory from another pane or terminal"
  ((rc == 0)) || die "$name is gone from workspace $WS, and its pane runs something, or is gone too: end what runs there, then rerun; with the pane gone, quit the task's other agents (/exit in their panes), then rerun"
  log "$name is gone; starting it again in its pane, with a new session"
  if [[ $kind == claude ]]; then
    rm -f "$WT/$RUN_DIR/asking-$role"
    dialog_hooks "$role" >"$WT/$RUN_DIR/hooks-$role.json"
  fi
  write_env
  prime_shell "$pane"
  launch_args "$role" "$2"
  start_agent "$name" "$kind" "$pane" "${AGENT_ARGS[@]}"
  [[ $kind == codex ]] || set_color "$name" "$colour"
}

# relaunch_restored plan|build|review repo-root: an adopted agent that runs without the arguments
# Factory starts it with is started again with them, resuming its session in its pane. After a
# restart of Herdr's server (a reboot, an update), Herdr brings agents back with their resume
# alone: without their effort, model and permissions, and without the dialog hooks, so that an
# answer in Factory's approval dialog would never reach the gate.
relaunch_restored() {
  local role=$1 name=$PLAN_AGENT kind=claude rc=0 info session pane
  case $role in
    build) name=$BUILD_AGENT ;;
    review) name=$REVIEW_AGENT kind=codex ;;
  esac
  launch_args "$role" "$2"
  launched_with "$name" "${AGENT_ARGS[@]}" || rc=$?
  ((rc == 1)) || return 0
  turn_ends "$name" # never cut a turn short; and a tool its turn ran held the pane's foreground
  rc=0
  launched_with "$name" "${AGENT_ARGS[@]}" || rc=$?
  ((rc == 1)) || return 0
  info=$(h agent get "$name")
  pane=$(jq -r '.result.agent.pane_id // empty' <<<"$info")
  session=$(jq -r '.result.agent.agent_session.value // empty' <<<"$info")
  [[ -n $session || -z $pane ]] || session=$(resumed_session "$pane")
  if [[ -z $session || -z $pane ]]; then
    warn "$name runs without Factory's arguments, and Herdr names no session of it to resume; it goes on as it is"
    [[ $kind == codex ]] || rm -f "$WT/$RUN_DIR/hooks-$role.json" # so it shows no dialog that could not answer the gate
    return 0
  fi
  log "$name runs without Factory's arguments, as Herdr restores agents; restarting it with them, its session resumed"
  [[ $kind == codex ]] || dialog_hooks "$role" >"$WT/$RUN_DIR/hooks-$role.json"
  agent_quit "$name" "$pane" "$kind"
  write_env
  prime_shell "$pane"
  if [[ $kind == codex ]]; then
    start_agent "$name" codex "$pane" resume "${AGENT_ARGS[@]}" "$session"
    return 0
  fi
  start_agent "$name" claude "$pane" --resume "$session" "${AGENT_ARGS[@]}"
  prompt_box_up "$name" # its colour came back with its session
}

# Resume: Factory's state for the task records the last completed milestone ("written <round>"
# once the plan was written or revised, naming the review round it waits for, "reviewed" once
# the plan was reviewed, "planned" once the human approved the plan, "built <round>" once the
# reviews and the human approved the build), out of the run dir: the approvals are the human's,
# and the agents write there. A rerun skips what is done; --fresh starts over.
mark() { mkdir -p "$TASK_STATE" && printf '%s\n' "$*" >"$TASK_STATE/state"; }
# resume_point -> written <round> | reviewed | planned | built <round> | (empty), nothing with
# --fresh, which also dropped it as the workspace opened (open_task_workspace)
resume_point() { ((FACTORY_FRESH)) || recorded state; }

# stop_task repo what: a human gate ended the run; leave the workspace for them.
stop_task() {
  run_end stopped at "$2"
  bd_note "$1" "$TASK_ID" "stopped at $2. workspace $WS, worktree $WT"
  die "stopped at $2 for $TASK_ID; the workspace stays open, and factory run [flags] $1 $TASK_ID takes the task up again"
}

# planner_kept_hands_off planner-agent [tree_state before its turn]: the planner must not
# change code; what its turn changed gets one chance to be reverted. Changes there before it,
# the human's while a gate waited or a reviewer's, are not the planner's.
planner_kept_hands_off() {
  local new
  new=$(changed_since "${2:-}")
  [[ -n $new ]] || return 0
  warn "the planner changed files; asking it to revert"
  ask "$1" "You changed files in the worktree, but planning must leave the code untouched (only $RUN_DIR/ is yours). Revert these changes (git checkout -- <file>, or remove a new one), leave $RUN_DIR/ as it is:
$new
Reply with just DONE."
  new=$(changed_since "${2:-}")
  [[ -n $new ]] || return 0
  die "the planner left changes in $WT, though planning must not touch code; revert these, then rerun:"$'\n'"$new"
}

# changed_since tree-state -> the lines of tree_state "$WT" that the earlier state lacks
changed_since() { LC_ALL=C comm -13 <(LC_ALL=C sort <<<"$1") <(tree_state "$WT" | LC_ALL=C sort); }

# head_of worktree -> the commit checked out there and the branch it is on, which a planner's
# turn must leave as they were: a commit carries its change out of the tree that
# planner_kept_hands_off reads, and onto the branch
head_of() { printf '%s %s' "$(git -C "$1" rev-parse -q --verify HEAD || printf none)" "$(git -C "$1" symbolic-ref -q HEAD || printf detached)"; }

# planner_turn planner-agent prompt: one turn of the planner, then the checks that it left the
# code and HEAD alone. What changed before the turn is not the planner's; what changed during
# it is, also while one of its question dialogs waited for the human.
planner_turn() {
  local before head
  show_decisions "$WT/$RUN_DIR"
  before=$(tree_state "$WT")
  head=$(head_of "$WT")
  ask "$1" "$2"
  planner_kept_hands_off "$1" "$before"
  [[ $(head_of "$WT") == "$head" ]] \
    || die "the planner's turn committed or checked out in $WT, from $head to $(head_of "$WT"): planning must not. Look at what it did, put HEAD back, and rerun"
}

# write_plan planner-agent: ask for a plan; the planner asks the human its questions in its own
# dialog meanwhile. A turn that ends without a plan, as a dismissed question ends it, gets one
# nudge to plan with stated assumptions.
write_plan() {
  local file="$WT/$RUN_DIR/plan.md"
  planner_turn "$1" "$(plan_prompt)"
  [[ ! -s $file ]] || return 0
  warn "$1 replied but wrote no $RUN_DIR/plan.md; asking again"
  planner_turn "$1" "You replied, but $RUN_DIR/plan.md does not exist. Do not ask the human again: decide what is still open with stated assumptions, which the human sees when approving the plan, then write the plan and reply with its content."
  [[ -s $file ]] || die "$1 never wrote $RUN_DIR/plan.md; look at its pane, then rerun to take the task up again"
}

# plan_round round [human's note]: Codex and the builder review the plan, and the planner
# revises it once when either objects. Sets PLAN_VERDICT.
plan_round() {
  local round=$1
  rm -f "$WT/$RUN_DIR/plan-review-$round.md" "$WT/$RUN_DIR/plan-review-$round-build.md" # a cut-off round's would pass for this one's
  log "plan review round $round: $REVIEW_AGENT and $BUILD_AGENT"
  ask_for_file "$REVIEW_AGENT" "$(plan_review_prompt "$round" "${2:-}")" "$WT/$RUN_DIR/plan-review-$round.md"
  ask_for_file "$BUILD_AGENT" "$(builder_plan_review_prompt "$round" "${2:-}")" "$WT/$RUN_DIR/plan-review-$round-build.md"
  PLAN_VERDICT=$(verdicts "$WT/$RUN_DIR/plan-review-$round.md" "$WT/$RUN_DIR/plan-review-$round-build.md")
  log "plan verdicts: $PLAN_VERDICT"
  metric plan_review round "$round" verdicts "$PLAN_VERDICT"
  [[ $PLAN_VERDICT == "APPROVE APPROVE" ]] && return 0
  log "plan revision"
  planner_turn "$PLAN_AGENT" "$(plan_fix_prompt "$round" "${2:-}")"
}

# plan_phase repo [round]: plan (with questions), then plan rounds until both reviewers approve
# or FACTORY_PLAN_ROUNDS are used up, then human approval. An objection in the last round still
# gets its revision, which goes on unreviewed. Given the round a written plan waits for (the
# written marker), a rerun reviews that plan from there instead of planning again. The marker
# is set here, not in plan_round: a note's round at the approval leaves the plan reviewed.
plan_phase() {
  local round=${2:-}
  PLAN_VERDICT=""
  if [[ $round =~ ^[1-9][0-9]*$ && -s $WT/$RUN_DIR/plan.md ]]; then
    log "the plan is already written; not planning again"
    turn_ends "$PLAN_AGENT" # a revision the stopped run asked for may still be under way
  else
    round=1
    log "planning"
    # what an earlier plan and its build left would pass as this one's, its marker included
    rm -f "${TASK_STATE:?}/state" "$TASK_STATE/allow-protected" "$WT/$RUN_DIR/plan.md" "$WT/$RUN_DIR/plan-changes.md"
    rm -f "$WT/$RUN_DIR"/{plan-review,review,response,copilot}-* "$WT/$RUN_DIR"/gate-*.log
    write_plan "$PLAN_AGENT"
    mark written 1
  fi
  while ((round <= FACTORY_PLAN_ROUNDS)); do
    plan_round "$round"
    [[ $PLAN_VERDICT == "APPROVE APPROVE" ]] && break
    round=$((round + 1))
    mark written "$round" # revised
  done
  [[ $PLAN_VERDICT == "APPROVE APPROVE" ]] || warn "plan rounds used up; the revision after round $((round - 1)) goes on unreviewed"
  mark reviewed
  approve_plan "$1"
}

# approve_plan repo: your gate on the reviewed plan. With protected paths allowed, the build
# may change the ones the plan names as you approve it. An abort here leaves the reviewed
# marker, so a rerun comes straight back to this prompt instead of planning again.
approve_plan() {
  human_gate plan "$PLAN_AGENT" "$WT/$RUN_DIR" || stop_task "$1" "plan approval"
  if waived; then allow_named "$WT/$RUN_DIR/plan.md"; fi
  mark planned
}

# build_phase repo [resume]: build, then gate, guardrails, dual review and the human's
# approval per round, up to FACTORY_ROUNDS; a note from the human always gets a round of its
# own, past the last if need be. A turn of the builder's after the guardrails failed that
# changes nothing they check (work_state) ends the rounds, to hand over: what they found is
# then the human's to fix, as a commit that cannot be signed while the signer is locked. So
# does a first turn on the plan that changes nothing, before any round: the builder did not
# build, as when it lacks code the plan builds on. Sets ROUND VERDICT STALLED.
build_phase() {
  local repo=$1 violations rc limit=$FACTORY_ROUNDS gate_log note="" out work
  log "building"
  VERDICT=""
  STALLED=""
  if [[ ${2:-} == resume ]]; then
    ask "$BUILD_AGENT" "$(build_prompt resume)"
  else
    work=$(work_state)
    ask "$BUILD_AGENT" "$(build_prompt)"
    if [[ $(work_state) == "$work" ]]; then
      ROUND=0
      STALLED="the builder's turn on the plan changed nothing; see its pane"
      warn "$STALLED"
      return 0
    fi
  fi
  ROUND=1
  while ((ROUND <= limit)); do
    # a cut-off round's reviews, or an earlier run's answer to them, would pass for this one's
    rm -f "$WT/$RUN_DIR/review-$ROUND.md" "$WT/$RUN_DIR/review-$ROUND-plan.md" "$WT/$RUN_DIR/response-$ROUND.md"
    gate_log="$WT/$RUN_DIR/gate-$ROUND.log"
    if ! gate_branch "$gate_log"; then
      ask "$BUILD_AGENT" "$(gate_fix_prompt "$gate_log")"
      ROUND=$((ROUND + 1))
      continue
    fi
    out=$(mktemp)
    rc=0
    guard_branch >"$out" || rc=$? # in this shell: a subshell would keep GUARD_FAILED to itself
    violations=$(<"$out")
    rm -f "$out"
    if ((rc)); then
      warn "guardrails: $violations"
      work=$(work_state)
      ask "$BUILD_AGENT" "$(guard_fix_prompt "$violations")"
      if [[ $(work_state) == "$work" ]]; then
        STALLED="the guardrails failed ($GUARD_FAILED) and the builder's turn after that changed nothing they check"
        warn "$STALLED"
        break
      fi
      ROUND=$((ROUND + 1))
      continue
    fi
    log "review round $ROUND: $REVIEW_AGENT and $PLAN_AGENT"
    ask_for_file "$REVIEW_AGENT" "$(review_prompt "$ROUND" "$note")" "$WT/$RUN_DIR/review-$ROUND.md"
    ask_for_file "$PLAN_AGENT" "$(planner_build_review_prompt "$ROUND" "$note")" "$WT/$RUN_DIR/review-$ROUND-plan.md"
    VERDICT=$(verdicts "$WT/$RUN_DIR/review-$ROUND.md" "$WT/$RUN_DIR/review-$ROUND-plan.md")
    log "verdicts: $VERDICT"
    metric review round "$ROUND" verdicts "$VERDICT"
    if [[ $VERDICT == "APPROVE APPROVE" ]]; then
      rc=0
      human_gate build "$BUILD_AGENT" "$WT/$RUN_DIR" || rc=$?
      case $rc in
        0)
          VERDICT=APPROVE
          mark built "$ROUND"
          return 0
          ;;
        4)
          VERDICT=REVISE
          log "note for the builder; another round"
          note=$HUMAN_NOTE
          ask "$BUILD_AGENT" "$(build_note_prompt "$note")"
          ((ROUND < limit)) || limit=$((ROUND + 1))
          ROUND=$((ROUND + 1))
          continue
          ;;
        *) stop_task "$repo" "build approval" ;;
      esac
    fi
    VERDICT=REVISE
    ask "$BUILD_AGENT" "$(revise_prompt "$ROUND")"
    ROUND=$((ROUND + 1))
  done
  ((ROUND <= limit)) || ROUND=$limit # the loop ends one past the last round, but where it stalled
}

# finish_task repo: memories, then close the bead (with PR and Copilot review) or hand over.
finish_task() {
  local repo=$1 next="merge $BRANCH" copilot="" violations left
  local summary="branch $BRANCH, worktree $WT, herdr workspace $WS, rounds used: $ROUND, verdict: ${VERDICT:-none}${STALLED:+; $STALLED}"
  PR_URL=""
  ask "$BUILD_AGENT" "$(memory_prompt)"
  if [[ $VERDICT != APPROVE ]]; then
    hand_over "$repo" "$summary"
    return 2
  fi
  if ! violations=$(guard_branch); then
    hand_over "$repo" "$summary; guardrails: $violations"
    return 2
  fi
  if ((FACTORY_PR)); then
    pull_request "$BUILD_AGENT"
    next="review $PR_URL"
    copilot=${COPILOT_NOTE:+, $COPILOT_NOTE}
    if ! pushed_holds; then
      hand_over "$repo" "$summary, pr $PR_URL$copilot; origin's $BRANCH is not $(recorded pushed), the commit Factory checked and pushed"
      return 2
    fi
    # fixes for Copilot's comments that did not get through to the pull request
    left=$(unpushed)
    if [[ -n $left ]]; then
      hand_over "$repo" "$summary, pr $PR_URL$copilot; the worktree holds $left, which the pull request lacks: factory pr $repo $TASK_ID checks what is committed and pushes it"
      return 2
    fi
  fi
  bd_note "$repo" "$TASK_ID" "approved. $summary${PR_URL:+, pr $PR_URL}$copilot"
  bd -C "$repo" close "$TASK_ID" -r "Factory: gate green, review approved; $next" >/dev/null
  run_end "done"
  toast "$TASK_ID done" "$TASK_TITLE. ${next^}." "done"
  log "done: $summary${PR_URL:+, pr $PR_URL}"
  rm -f "$TASK_STATE/state"
  bd_push "$repo"
}

# hand_over repo why: the task needs a human; say why on the bead and here
hand_over() {
  run_end handed_over why "$2"
  bd_note "$1" "$TASK_ID" "needs a human. $2"
  toast "$TASK_ID needs you" "$TASK_TITLE. See workspace $WS." request
  warn "needs a human: $2"
  bd_push "$1"
}

# on_interrupt repo: the run was killed or Ctrl-C'd; leave a note on the bead. Factory's state
# for the task, the worktree and the agents stay, and factory run with the bead id resumes.
# Ends with 130 even when the note fails, which tells factory queue to end too.
on_interrupt() {
  trap - INT TERM
  run_end interrupted
  printf '\n' >&2
  warn "interrupted during $STEP; workspace ${WS:-?} stays open, continue with: factory run [flags] $1 ${TASK_ID:-<bead-id>}"
  if [[ -n ${TASK_ID:-} ]]; then
    bd_note "$1" "$TASK_ID" "interrupted during $STEP. workspace ${WS:-?}, worktree ${WT:-?}; continue with: factory run [flags] $1 $TASK_ID" 2>/dev/null \
      || warn "could not leave the note on $TASK_ID"
  fi
  exit 130
}

# run_task repo arg
run_task() {
  local repo
  repo=$(repo_top "$1") || exit 1
  STEP=setup
  TASK_ID="" WS="" WT="" STALLED="" # none from the environment: on_interrupt, finish_task read them
  trap 'on_interrupt "$repo"' INT TERM
  setup_task "$repo" "$2"
  open_task_workspace "$repo"
  STEP=agents
  start_or_adopt_agents "$repo"
  workspace_script
  local point
  point=$(resume_point)
  [[ -z $point ]] || log "resuming after: $point (use --fresh to start over)"
  run_begins "${point:-start}"
  case $point in
    written*)
      STEP=planning
      plan_phase "$repo" "${point#written }"
      STEP=building
      build_phase "$repo"
      ;;
    built*)
      VERDICT=APPROVE
      ROUND=${point#built }
      if ! guarded; then # a commit since, or a task from before Factory recorded the check
        log "the approved build is not $HEAD_SHA, the tip of $BRANCH: another round of gate, review and approval"
        STEP=building
        build_phase "$repo" resume
      fi
      ;;
    reviewed)
      STEP=planning
      approve_plan "$repo"
      STEP=building
      build_phase "$repo"
      ;;
    planned)
      STEP=building
      build_phase "$repo" resume
      ;;
    *)
      STEP=planning
      plan_phase "$repo"
      STEP=building
      build_phase "$repo"
      ;;
  esac
  STEP=finishing
  finish_task "$repo"
  trap - INT TERM EXIT
}

# -------------------------------------------------------------- commands ----
# cmd_doctor: check the prerequisites; 1 when one is missing
cmd_doctor() {
  local ok=0 t
  for t in "${RUN_TOOLS[@]}"; do
    if command -v "$t" >/dev/null 2>&1; then printf '  ok       %s\n' "$t"; else
      printf '  MISSING  %s\n' "$t"
      ok=1
    fi
  done
  if herdr agent list >/dev/null 2>&1; then printf '  ok       herdr server\n'; else
    printf '  MISSING  herdr server (start herdr first)\n'
    ok=1
  fi
  # Claude Code runs its shell commands, yours after ! too, from a fresh login shell, not the
  # pane's environment, so bd and fy must resolve there (mise use -g, or a symlink in ~/.local/bin)
  if bash -lc 'bd version' >/dev/null 2>&1; then printf '  ok       bd from a fresh login shell\n'; else
    printf '  MISSING  bd from a fresh login shell (agents will not be able to use beads)\n'
    ok=1
  fi
  if bash -lc 'command -v fy' >/dev/null 2>&1; then printf '  ok       fy from a fresh login shell\n'; else
    printf '  MISSING  fy from a fresh login shell (!fy approve in a pane will not work; see the README'"'"'s Install)\n'
    ok=1
  fi
  if git_at_least 2.31; then printf '  ok       git %s\n' "$(git_version)"; else
    printf '  MISSING  git 2.31 or later (this is %s)\n' "$(git_version)"
    ok=1
  fi
  for t in flock gh; do
    if command -v "$t" >/dev/null 2>&1; then printf '  ok       %s\n' "$t"; elif [[ $t == gh ]]; then
      printf '  absent   gh (only pull requests need it: --pr, factory pr)\n'
    else
      printf '  MISSING  %s (factory next and queue need it; util-linux has it)\n' "$t"
      ok=1
    fi
  done
  if [[ -f $GUARDRAILS ]]; then printf '  ok       guardrails %s\n' "$GUARDRAILS"; else
    printf '  MISSING  guardrails %s (not beside the script: link the script from its checkout, as the README'"'"'s Install does, rather than copy it)\n' "$GUARDRAILS"
    ok=1
  fi
  return $ok
}

# cmd_status: the live agents of Factory's tasks, by workspace
cmd_status() {
  local color=0 name status ws task role c reset='' labels last=""
  [[ -t 1 ]] && color=1
  ((color)) && reset=$'\033[0m'
  labels=$(h workspace list | jq -r '.result.workspaces[] | "\(.workspace_id)\t\(.label)"')
  local rows
  rows=$(h agent list | jq -r '.result.agents[] | select(.name // "" | test("-(plan|build|review)$")) |
    "\(.name)\t\(.agent_status)\t\(.workspace_id)"' | sort)
  if [[ -z $rows ]]; then
    log "no Factory agents running"
    return 0
  fi
  printf '%-14s %-8s %-9s %-5s %s\n' TASK ROLE STATE WS LABEL
  while IFS=$'\t' read -r name status ws; do
    task=${name%-*}
    task=${task//_/.} # a child bead's id, which task_context names its agents with a _
    role=${name##*-}
    c=""
    if ((color)); then
      case $status in
        working) c=$'\033[36m' ;;
        idle | done) c=$'\033[32m' ;;
        blocked) c=$'\033[31m' ;;
        *) c=$'\033[2m' ;;
      esac
    fi
    printf '%-14s %-8s %s%-9s%s %-5s %s\n' "$task" "$role" "$c" "$status" "$reset" "$ws" \
      "$([[ $task != "$last" ]] && awk -F'\t' -v w="$ws" '$1 == w {print $2}' <<<"$labels" | sed "s/^$task //")"
    last=$task
  done <<<"$rows"
}

# cmd_stats repo: how the repo's tasks went, from the events their runs recorded (events_file)
cmd_stats() {
  local repo state file color=0 width=0
  repo=$(repo_top "$1") || exit 1
  state=$(repo_state "$repo") || die "$repo: git names no git dir for it"
  file=$(events_file "$state")
  if [[ ! -s $file ]]; then
    log "no runs of the tasks of $repo recorded yet"
    return 0
  fi
  if [[ -t 1 ]]; then
    color=1
    width=$(tput cols 2>/dev/null) || width=80
    [[ $width =~ ^[0-9]+$ ]] || width=80
  fi
  # a line a run left torn, as it died writing it, counts for nothing
  jq -cR 'fromjson?' "$file" | jq -rs --argjson color "$color" --argjson width "$width" "$(stats_jq)"
  log "from ${file/#"$HOME"/"~"}"
}

# stats_jq: the jq that sums the events up: a row a task, for the latest 20; the means per
# finished task for each Factory version, which tell whether a change to Factory, its prompts
# or its models helped; the guardrails that failed, and your latest notes, where what goes
# wrong again and again shows. The two tables share their columns' widths, so that a version's
# means line up under its tasks' rows; $color 1 paints them for a terminal, in bd's colours,
# and a $width above 0 cuts each note to it.
stats_jq() {
  cat <<'JQ'
def pad($n): tostring | if length < $n then . + " " * ($n - length) else . end;
def lpad($n): tostring | if length < $n then " " * ($n - length) + . else . end;
# oneline: a note's lines on one, · between them, without the blank ones and a list's markers
def oneline: [splits("\n") | sub("^\\s+"; "") | sub("^([-*+]|[0-9]+[.)])\\s+"; "") | sub("\\s+$"; "")
  | select(length > 0)] | join(" · ");
# fit($n): at most $n characters, with … for the end it cuts off; at least 20 on a narrow terminal
def fit($n): ([$n, 20] | max) as $n | if $width > 0 and length > $n then .[:$n - 1] + "…" else . end;
def paint($c): if $color == 1 and $c != "" then "\u001b[\($c)m\(.)\u001b[m" else . end;
def bold: paint("1");
def grey: paint("38;2;108;118;128");
def dur: floor | if . >= 3600 then "\(. / 3600 | floor)h\(. % 3600 / 60 | floor)m"
  elif . >= 60 then "\(. / 60 | floor)m" else "\(.)s" end;
def tok: if . >= 1e6 then "\(. / 1e5 | floor / 10)M" elif . >= 1e3 then "\(. / 1e3 | floor)k"
  else "\(floor)" end;
def count(f): [.[] | select(f)] | length;
def sum(f): [.[] | f] | add // 0;
def tokens: if .in + .out > 0 then "\(.in | tok)/\(.out | tok)" else "-" end;
def session_max(f): [.[] | select(.event == "tokens")] | group_by(.session) | map(map(f) | max) | add // 0;
def fold: {
  task: .[0].task, first: .[0].t,
  version: ([.[] | select(.event == "run") | .version | tostring] | last // "?"),
  outcome: ([.[] | select(.event == "run" or .event == "end")] | last
    | if . == null then "-" elif .event == "end" then .outcome else "running" end),
  plan: count(.event == "plan_review"),
  build: count(.event == "gate" and (.label | tostring | test("^[0-9]+$"))),
  gate: count(.event == "gate" and .ok == 0),
  guard: count(.event == "guard" and .ok == 0),
  revise: sum(select(.event == "plan_review" or .event == "review") | [.verdicts | tostring | scan("REVISE")] | length),
  notes: count(.event == "answer" and .answer == "note"),
  agents: (sum(select(.event == "turn") | .secs) - sum(select(.event == "question") | .secs)),
  gating: sum(select(.event == "gate") | .secs),
  you: sum(select(.event == "answer" or .event == "question") | .secs),
  in: session_max(.in), out: session_max(.out)
};
def cells: [.plan, .build, .gate, .guard, .revise, .notes, (.agents | dur), (.gating | dur), (.you | dur), tokens];
def mean(f): map(f) | add / length | . * 10 | round / 10;
def means: {plan: mean(.plan), build: mean(.build), gate: mean(.gate), guard: mean(.guard),
  revise: mean(.revise), notes: mean(.notes), agents: mean(.agents), gating: mean(.gating),
  you: mean(.you), in: mean(.in), out: mean(.out)};
# widths: the widest cell of each column, across the rows given
def widths: reduce .[] as $r ([]; . as $w
  | [range([($w | length), ($r | length)] | max) | [$w[.] // 0, ($r[.] // "" | tostring | length)] | max]);
# line(widths; left; colours): cells two spaces apart, the first left of them flush left and the
# rest, numbers, flush right; a colour paints the cell of its column
def line($w; $left; $colours): . as $r
  | [range($r | length) as $i | $r[$i] | if $i < $left then pad($w[$i]) else lpad($w[$i]) end
      | paint($colours[$i] // "")]
  | join("  ");
[to_entries[] | .value + {n: .key}] as $events
| ($events | group_by(.task) | map(sort_by(.n) | fold) | sort_by(.first)) as $tasks
| ["TASK", "OUTCOME", "VERSION", "PLAN", "BUILD", "GATE", "GUARD", "REVISE", "NOTES", "AGENTS", "GATING",
    "YOU", "TOKENS"] as $head
| [$tasks[-20:][] | [.task, (.outcome | gsub("_"; " ")), .version] + cells] as $rows
| [$tasks | map(select(.outcome | IN("done", "handed_over", "stopped")))
    | group_by(.version) | sort_by(map(.first) | min)[]
    | ["\(.[0].version) (\(length) task\(if length > 1 then "s" else "" end), \(count(.outcome == "done")) done)"]
      + (means | cells)] as $means
# the means' rows line up under the tasks' numbers, their label as wide as task, outcome and version
| ([$head[3:]] + ($rows | map(.[3:])) + ($means | map(.[1:])) | widths) as $nw
| ([$head[:3]] + ($rows | map(.[:3])) | widths) as $tw
| ([$means[][0] | length] | max // 0) as $label
| ($tw | .[2] += ([$label - add - 4, 0] | max)) as $tw
| ($tw | add + 4) as $lead
| ($head | (.[:3] | line($tw; 3; [])) + "  " + (.[3:] | line($nw; 0; [])) | bold),
  ($rows[] | (.[:3] | line($tw; 3; [null, {done: "38;2;170;217;76", "handed over": "38;2;255;180;84",
      stopped: "38;2;242;109;120", failed: "38;2;242;109;120", interrupted: "38;2;108;118;128",
      running: "38;2;89;194;255"}[.[1]]])) + "  " + (.[3:] | line($nw; 0; []))),
  (($tasks | length) - 20 | select(. > 0) | "(\(.) earlier task(s) left out here; the means count them)" | grey),
  ($means | select(length > 0)
    | "", ("means per finished task (done, handed over or stopped), by Factory version" | bold),
      (("VERSION" | pad($lead)) + "  " + ($head[3:] | line($nw; 0; [])) | bold),
      (.[] | (.[0] | pad($lead)) + "  " + (.[1:] | line($nw; 0; [])))),
  "",
  ("PLAN, BUILD: rounds · GATE, GUARD: failures · REVISE: the reviewers' objections · NOTES: yours" | grey),
  ("AGENTS, GATING, YOU: the time they took · TOKENS: what the agents read/wrote" | grey),
  ([$events[] | select(.event == "guard" and .ok == 0) | .failed | tostring | splits(" ")]
    | group_by(.) | sort_by(length) | reverse | select(length > 0)
    | "", "\("guardrails that failed:" | bold) \(map("\(.[0]) \(length)") | join(", "))"),
  ([$events[] | select(.event == "answer" and .answer == "note")] | reverse | .[:10] | select(length > 0)
    | "", ("your notes, latest first:" | bold),
      (.[] | "  \(.task | pad(11))\(.gate | pad(7))\(.t[:10])  " as $lead
        | $lead + (.note | tostring | oneline | fit($width - ($lead | length)))))
JQ
}

# cmd_init repo [bd init args...]: beads with a short prefix, the gate detected, an AGENTS.md stub
cmd_init() {
  local repo prefix
  repo=$(repo_top "$1") || exit 1
  shift
  git -C "$repo" config beads.role >/dev/null 2>&1 || git -C "$repo" config beads.role maintainer
  if [[ -d $repo/.beads ]]; then log "beads already set up in $repo"; else
    # No bd-generated AGENTS.md/CLAUDE.md, hooks, or editor files: the prompts carry what agents need.
    # bd names the prefix after the directory, or inherits it from a .beads above (a Gas Town's
    # hq); a short one from the repo's name instead, and a --prefix among the args still wins.
    prefix=$(repo_prefix "$(basename "$repo")")
    (cd "$repo" && BD_NON_INTERACTIVE=1 bd init --non-interactive --skip-agents --skip-hooks ${prefix:+--prefix "$prefix"} "$@")
  fi
  local gate
  if [[ -f $repo/.factory/gate ]]; then
    log "gate: .factory/gate already exists"
  elif gate=$(detect_gate "$repo"); then
    write_gate "$repo" "$gate"
    log "wrote .factory/gate running: $gate  (review it, then commit it; runs need it committed)"
  else
    warn "no gate detected: write $repo/.factory/gate (a script that runs your checks) and commit it"
  fi
  if [[ ! -e $repo/AGENTS.md && ! -e $repo/CLAUDE.md ]]; then
    write_agents_stub "$repo"
    log "wrote a short AGENTS.md stub (CLAUDE.md links to it); fill in what the code cannot tell a new engineer, then commit both: the agents read them from the task's branch"
  fi
}

# write_agents_stub repo
write_agents_stub() {
  local gate
  gate=$(find_gate "$1") || gate="<your gate command>"
  cat >"$1/AGENTS.md" <<STUB
# $(basename "$1")

One or two lines on what this project is.

## Run and verify

- Gate: \`$gate\` must pass. It is the definition of done.

## Layout

- Short notes on where things live, only where the tree is not self-explanatory.

## Rules that the code cannot tell you

- What not to touch, and why.
- External systems, credentials, environments.
- Deliberate odd choices and their reasons.
STUB
  ln -s AGENTS.md "$1/CLAUDE.md"
}

# compose_task: title on the first line, blank line, description. Uses $VISUAL/$EDITOR
# when set and there is a terminal, otherwise reads the same format from stdin (until Ctrl-D).
# Sets TASK_TITLE and TASK_DESC; fails on an empty title.
compose_task() {
  local editor=${VISUAL:-${EDITOR:-}} f body
  f=$(mktemp)
  if [[ -n $editor && -t 0 ]]; then
    printf '\n\n# First line: title. Then a blank line and the description (markdown is fine).\n# Lines starting with # are dropped. An empty title aborts.\n' >"$f"
    ${editor} "$f" || {
      rm -f "$f"
      die "$editor exited with an error; nothing filed"
    }
  else
    log "title on the first line, blank line, then the description; finish with Ctrl-D"
    cat >"$f"
  fi
  body=$(grep -vE '^#' "$f") || body=""
  rm -f "$f"
  TASK_TITLE=$(sed -n '/[^[:space:]]/{p;q}' <<<"$body" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [[ -n $TASK_TITLE ]] || die "empty title, nothing filed"
  # not 1,/re/d: with the title on line one, its range also takes the next non-blank line
  TASK_DESC=$(sed -n '/[^[:space:]]/,$p' <<<"$body" | sed '1d' | sed '/./,$!d')
}

# cmd_add repo ["title" [description]]: file a task; with no title, from your editor or stdin
cmd_add() {
  local repo
  repo=$(repo_top "$1") || exit 1
  shift
  need_beads "$repo"
  if (($# == 0)); then
    compose_task
  else
    TASK_TITLE=$1
    TASK_DESC=${2:-}
  fi
  bd -C "$repo" create "$TASK_TITLE" -d "$TASK_DESC" -q # -q drops bd's tip about its own agent integration
  bd_push "$repo"
}

# task_order [color]: bd list --json on stdin -> one line per task: those in progress first,
# which next leaves to their runs, then the open ones in the order next takes them: a task after
# the open ones that block it (blocks or conditional-blocks, its own or a parent's), else by
# priority, newest first as bd ready does. Blocked, deferred and hooked tasks, which next skips,
# come after the rest, and so does a dependency cycle. bd's waits-for gates are not followed,
# nor whether a blocker's branch is merged (waits_for). Colours are bd's own.
task_order() {
  jq -r --argjson color "${1:-0}" '
    def paint($c): if $color == 1 and $c != "" then "\u001b[\($c)m\(.)\u001b[m" else . end;
    (. // []) as $all
    | (reduce $all[] as $t ({}; .[$t.id] = ($t.dependencies // []))) as $deps
    | def blockers($id; $seen):
        $deps[$id][] | .depends_on_id as $d | select($deps[$d])
        | if .type == "blocks" or .type == "conditional-blocks" then $d
          elif .type == "parent-child" and ($seen[$d] | not) then blockers($d; $seen + {($d): true})
          else empty end;
    [$all[] | .blockers = [blockers(.id; {(.id): true})]]
    | sort_by([({in_progress: 0, open: 1}[.status] // 2), .priority, (.created_at // "" | explode | map(-.)), .id])
    | {left: ., done: [], seen: {}}
    | until(.left == [];
        .seen as $seen
        | (first(.left[] | select(all(.blockers[]; $seen[.]))) // null) as $next
        | if $next then .done += [$next] | .seen[$next.id] = true | .left |= map(select(.id != $next.id))
          else .done += .left | .left = [] end)
    | .done[]
    | ({in_progress: "38;2;255;180;84", blocked: "38;2;242;109;120", deferred: "38;2;108;118;128"}[.status] // "") as $sc
    | ({"0": "1;38;2;240;113;120", "1": "38;2;255;143;64", "2": "38;2;230;180;80"}[.priority | tostring] // "") as $pc
    | "\({open: "○", in_progress: "◐", blocked: "●", deferred: "❄", hooked: "◇", closed: "✓"}[.status] // "?" | paint($sc)) \(.id) \("● P\(.priority)" | paint($pc)) \(.title)"'
}

# cmd_tasks repo [bd list args...]: without args, the open tasks as task_order lists them
cmd_tasks() {
  local repo color=0 out
  repo=$(repo_top "$1") || exit 1
  shift
  need_beads "$repo"
  if (($#)); then
    bd -C "$repo" list "$@"
    return
  fi
  [[ -t 1 ]] && color=1
  out=$(bd_json "$repo" list -n 0 | task_order "$color")
  if [[ -n $out ]]; then printf '%s\n' "$out"; else log "no open tasks in $repo"; fi
}

# claim_next repo -> the first task bd has ready that waits for no other task's branch
# (waits_for), claimed; empty when there is none. bd's atomic ready --claim would take the
# first ready task, whatever it waits for, so Factory chooses and claims under a lock in its
# state for the repo, one factory next at a time: two in parallel never take the same bead.
claim_next() {
  local repo=$1 dir base ids id why status
  need flock
  dir=$(repo_state "$repo") || die "$repo is no git checkout"
  mkdir -p "$dir"
  base=$(git -C "$repo" rev-parse --abbrev-ref HEAD)
  {
    if ! flock -n 9; then
      log "waiting for another factory next in $repo to claim its task"
      flock 9 || die "could not lock $dir/next.lock"
    fi
    # bd's commands get no fd 9, which the shell keeps: what bd leaves running a while after it
    # exits would hold the lock on
    {
      ids=$(bd_json "$repo" ready -n 0 | jq -r '.[].id') || die "bd could not list the ready tasks in $repo"
      for id in $ids; do
        why=$(waits_for "$repo" "$id" "$base") || die "bd could not show $id in $repo, to read the tasks it builds on"
        if [[ -n $why ]]; then
          log "skipping $id: it builds on $why, not merged into $base yet"
          continue
        fi
        if ! bd -C "$repo" update "$id" --claim >/dev/null; then
          # bd refuses a task another bd user holds: one claimed since bd listed it, no longer
          # open, or one assigned to them, which bd ready lists all the same
          status=$(bd_field "$repo" "$id" 'if .status == "open" and (.assignee // "") != ""
            then "assigned to \(.assignee)" else .status // "" end') \
            && [[ -n $status && $status != open ]] || die "bd could not claim $id in $repo"
          log "skipping $id: not open to a claim ($status)"
          continue
        fi
        printf '%s' "$id"
        break
      done
    } 9>&-
  } 9>"$dir/next.lock"
}

# cmd_next repo: claim the next ready task and run it; 3 when nothing is ready, 4 when it stops
# before a task is claimed, as when bd fails or the gate is gone: main sets DIE_STATUS to 4 for
# a factory next, its own checks included. factory queue ends on either, as its next would too.
cmd_next() {
  local repo id
  repo=$(repo_top "$1") || exit 4
  need_beads "$repo"
  resolve_gate "$repo" >/dev/null # without one, the task claimed would be left in progress
  id=$(claim_next "$repo") || exit 4
  DIE_STATUS=1 # from here on a die is a task that stopped
  [[ -n $id ]] || {
    log "nothing ready in $repo"
    return 3
  }
  run_task "$repo" "$id"
}

# cmd_queue repo [max]: factory next until nothing is ready, or max tasks have run. Each task
# runs in a process of its own, as factory next does: one that stops, or needs a human, ends
# there, and the queue goes on; an interrupt ends the queue, and so does a next that stops
# before it claims a task, as every next after it would.
cmd_queue() {
  local repo max=${2:-0} n=0 rc
  repo=$(repo_top "$1") || exit 1
  # what stops a factory next before it claims a task would stop the first one: say so first
  need_beads "$repo"
  resolve_gate "$repo" >/dev/null
  while ((max == 0 || n < max)); do
    rc=0
    (
      export FACTORY_PR FACTORY_COPILOT FACTORY_APPROVAL FACTORY_FRESH # the flags given
      "$FACTORY_HOME/factory" next "$repo"
    ) || rc=$?
    ((rc == 3)) && break
    ((rc != 4)) || die "factory next stopped before it claimed a task in $repo (above); queue ended after $n task(s)"
    if ((rc == 130)); then
      warn "queue interrupted after $n task(s)"
      exit 130
    fi
    ((rc == 0)) || warn "task stopped with status $rc; continuing with the next one"
    n=$((n + 1))
  done
  log "queue finished after $n task(s)"
}

# gate_state repo bead-id -> Factory's state for the task, where the human-gate commands below
# talk to a waiting run by writing files, out of the run dir the agents write; dies when the task
# has no worktree
gate_state() {
  [[ -n $(worktree_of "$1" "$2") ]] || die "no worktree for task $2 in $1"
  task_state "$1" "$2"
}

# gate_waiting task-state-dir -> plan, build, typing (a note at Factory's terminal) or note (a
# plan note's review round): what a live run waits for there, else 1
gate_waiting() {
  local role pid
  read -r role pid 2>/dev/null <"$1/waiting" || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s' "$role"
}

# gate_open task-state-dir bead-id -> plan or build, the approval a live run waits for there;
# dies saying why when there is none
gate_open() {
  local role
  role=$(gate_waiting "$1") || role=""
  [[ $role != note ]] || die "the plan of $2 is in the review round after your note; answer once it is back"
  [[ $role != typing ]] || die "Factory's terminal is taking a note on $2; finish it there (an empty one reopens the gate)"
  [[ $role == plan || $role == build ]] || die "nothing of $2 waits for approval"
  printf '%s' "$role"
}

# answer_gate task-state-dir bead-id approve|waive|reject|abort [note]: the human's answer to the
# approval a live run waits for there (gate_open); waive approves the plan and allows the
# protected paths it names
answer_gate() {
  local state=$1 id=$2 role
  role=$(gate_open "$state" "$id") || return 1
  case $3 in
    waive)
      [[ $role == plan ]] || die "--allow-protected is for the plan; $id waits with its build"
      waive_protected "$state"
      log "allowed the protected paths the plan of $id names"
      ;&
    approve)
      : >"$state/approved"
      log "approved the $role of $id"
      ;;
    reject)
      [[ $4 =~ [^[:space:]] ]] || die "empty note"
      printf '%s\n' "$4" >"$state/reject.md"
      log "sent your note on the $role to $id"
      ;;
    abort)
      : >"$state/aborted"
      log "aborted $id at its $role"
      ;;
  esac
}

# cmd_approve repo bead-id [--allow-protected]
cmd_approve() {
  local state
  state=$(gate_state "$1" "$2") || return 1
  if [[ ${3:-} == --allow-protected ]]; then
    answer_gate "$state" "$2" waive
  else
    answer_gate "$state" "$2" approve
  fi
}

# cmd_reject repo bead-id note
cmd_reject() {
  local state
  state=$(gate_state "$1" "$2") || return 1
  answer_gate "$state" "$2" reject "$3"
}

# cmd_abort repo bead-id
cmd_abort() {
  local state
  state=$(gate_state "$1" "$2") || return 1
  answer_gate "$state" "$2" abort
}

# task_args args... -> TARGS: repo, bead-id, then the rest. The first two arguments when they
# name a repo and a bead, else the task whose worktree the current directory is in, as in an
# agent's pane.
task_args() {
  local top branch id
  if (($# >= 2)) && [[ -d $1 ]] && is_bead_id "$2"; then
    TARGS=("$@")
    return 0
  fi
  # a repo's root first means the explicit form; its bead is never read as the start of a note
  if (($# >= 2)) && [[ -e $1/.git ]]; then
    die "$2 is not a bead id Factory takes (letters and digits on either side of one hyphen, as ab-x7k or ab-x7k.1)"
  fi
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  branch=$(git -C "$top" branch --show-current)
  id=$(bead_of_branch "$branch")
  if [[ $branch != factory/* ]] || ! is_bead_id "$id"; then return 1; fi
  TARGS=("$(repo_of "$top")" "$id" "$@")
}

# cmd_dialog_hook plan|build bead-id run-dir task-state-dir: Claude Code runs this with a
# hook's JSON on stdin (see dialog_hooks). A question dialog opening leaves a mark naming its
# tool call (asking), which goes as the dialog closes. The answer to Factory's approval dialog
# goes to the gate as approve, reject or abort would send it; any other answer goes into the
# task's decisions.
cmd_dialog_hook() {
  local role=$1 TASK_ID=$2 dir=$3 TASK_STATE=$4 in event n i header q a notes topic # the hook's task alone
  in=$(cat)
  event=$(jq -r '.hook_event_name // ""' <<<"$in")
  if [[ ! -d $dir ]]; then # nothing to mark without the run dir; an answer says so
    [[ $event == PostToolUse ]] || return 0
    die "no run dir of a task for this dialog; the answer went to the agent only"
  fi
  case $event in
    PreToolUse)
      jq -r '[.tool_use_id // "", .transcript_path // ""] | @tsv' <<<"$in" >"$dir/asking-$role"
      return 0
      ;;
    Stop) # a dialog closed with no answer, as Chat about this closes one, ends with the turn
      rm -f "$dir/asking-$role"
      return 0
      ;;
  esac
  rm -f "$dir/asking-$role"
  n=$(jq '.tool_input.questions | length' <<<"$in")
  for ((i = 0; i < n; i++)); do
    header=$(jq -r --argjson i "$i" '.tool_input.questions[$i].header // ""' <<<"$in")
    q=$(jq -r --argjson i "$i" '.tool_input.questions[$i].question' <<<"$in")
    a=$(jq -r --arg q "$q" '.tool_response.answers[$q] // ""' <<<"$in")
    notes=$(jq -r --arg q "$q" '.tool_response.annotations[$q].notes // ""' <<<"$in")
    topic=${header,,}
    case $topic in
      "fy plan" | "fy build")
        [[ -n $a ]] || continue
        gate_dialog_answer "${topic#fy }" "$a" "$(jq -r --argjson i "$i" '.tool_input.questions[$i].options[].label' <<<"$in")" || return 1
        ;;
      *)
        [[ $a != "(notes only)" ]] || a="" # Claude Code's answer when the human wrote only notes
        [[ -n $a$notes ]] || continue
        record_answer "$dir" "the $(role_of "$role") asked: $q Answer: ${a:-(no option)}${notes:+ Notes: $notes}"
        ;;
    esac
  done
}

# gate_dialog_answer role answer option-labels: Factory's approval dialog answered. A choice
# goes to the gate as its command would send it; what the human typed is the note.
gate_dialog_answer() {
  local role=$1 a=$2 waiting label
  waiting=$(gate_open "$TASK_STATE" "$TASK_ID") || return 1
  [[ $waiting == "$role" ]] || die "that dialog was about the $role of $TASK_ID, whose $waiting waits now"
  case $a in
    Approve) answer_gate "$TASK_STATE" "$TASK_ID" approve ;;
    "Approve, allow protected paths") answer_gate "$TASK_STATE" "$TASK_ID" waive ;;
    Abort) answer_gate "$TASK_STATE" "$TASK_ID" abort ;;
    *)
      while IFS= read -r label; do
        [[ $a != "$label" ]] || die "the $role dialog's choice \"$a\" is none Factory knows; answer in Factory's terminal or with fy"
      done <<<"$3"
      answer_gate "$TASK_STATE" "$TASK_ID" reject "$a"
      ;;
  esac
}

# cmd_pr repo bead-id: check and push an existing task branch, and open its pull request, or
# take the one open, with Copilot's rounds; then check what origin got, as finish_task does
cmd_pr() {
  local repo left
  repo=$(repo_top "$1") || exit 1
  need_beads "$repo"
  bd_json "$repo" show "$2" >/dev/null || die "bd cannot show $2 in $repo"
  WT=$(worktree_of "$repo" "$2")
  [[ -n $WT ]] || die "no worktree for task $2 in $repo"
  bead_task "$repo" "$2"
  task_context "$repo"
  check_base "$repo"
  record_base # a task from before Factory recorded one
  tree_dirty "$WT" && die "$WT has uncommitted changes; commit or stash them first"
  herdr agent get "$BUILD_AGENT" >/dev/null 2>&1 || die "no live builder agent for $2 to handle a rebase; rebase by hand, or rerun the task"
  pull_request "$BUILD_AGENT"
  pushed_holds || die "origin's $BRANCH is not $(recorded pushed), the commit Factory checked and pushed: look at $PR_URL before you merge it"
  left=$(unpushed)
  [[ -z $left ]] || warn "the worktree holds $left, which the pull request lacks: factory pr $repo $2 checks what is committed and pushes it"
  bd_note "$repo" "$2" "pull request through factory pr: $PR_URL${COPILOT_NOTE:+, $COPILOT_NOTE}"
  bd_push "$repo"
  printf '%s\n' "$PR_URL"
}

# merged_into repo branch base bead-status: 0 when the branch is merged: its PR merged, or it is
# an ancestor of base and its task is closed or has no bead. A branch with no commits of its own
# is an ancestor from the start, so ancestry alone takes a task still in planning for a merged one.
merged_into() {
  local repo=$1 branch=$2 base=$3 status=$4
  if [[ -z $status || $status == closed ]] \
    && git -C "$repo" merge-base --is-ancestor "refs/heads/$branch" "refs/heads/$base" 2>/dev/null; then
    return 0
  fi
  if git -C "$repo" remote get-url origin >/dev/null 2>&1 && command -v gh >/dev/null 2>&1; then
    [[ $(cd "$repo" && gh pr view "$branch" --json state -q .state 2>/dev/null) == MERGED ]] && return 0
  fi
  return 1
}

# waits_for repo bead-id base -> the tasks the bead builds on, its blockers in bd, whose factory
# branch is not merged into base (merged_into), each with its pull request, else its branch;
# empty when there are none. Factory closes a task's bead on approval, before you merge its
# branch, so bd has the tasks it blocks ready while their base lacks its code. A task Factory
# never ran, or whose branch factory clean removed, leaves no branch to wait for. 1 when bd
# cannot show the bead, which is no bead without blockers.
waits_for() {
  local repo=$1 base=$3 deps dep status branch url out=""
  deps=$(bd_one "$repo" show "$2" | jq -r '.dependencies[]? | select((.dependency_type // .type) == "blocks") | "\(.id // .depends_on_id) \(.status // "")"') || return 1
  while read -r dep status; do
    [[ -n $dep ]] || continue
    branch=$(branch_of "$repo" "$dep")
    [[ -n $branch ]] || continue
    merged_into "$repo" "$branch" "$base" "$status" && continue
    url=$(cd "$repo" && gh pr view "$branch" --json url -q .url 2>/dev/null) || url=""
    out+="${out:+, }$dep (${url:-$branch})"
  done <<<"$deps"
  printf '%s' "$out"
}

# cmd_clean repo [bead-id] [--force]: remove finished task workspaces, worktrees and branches.
cmd_clean() {
  local repo only="" force=0 a base into ws branch path id status why n=0
  repo=$(repo_top "$1") || exit 1
  shift
  for a in "$@"; do
    case $a in
      --force) force=1 ;;
      -*) die "unknown flag: $a (try: factory help)" ;;
      *)
        [[ -z $only ]] || die "usage: factory clean <repo> [bead-id] [--force]"
        only=$a
        ;;
    esac
  done
  ((! force)) || [[ -n $only ]] || die "--force drops a task's work, a live run's too: name its bead (factory clean $repo <bead-id> --force)"
  base=$(git -C "$repo" rev-parse --abbrev-ref HEAD)
  # every factory branch, with its Herdr workspace and checkout when there is one
  while IFS='|' read -r branch ws path; do
    [[ -n $branch ]] || continue
    id=$(bead_of_branch "$branch")
    [[ -z $only || $only == "$id" ]] || continue
    status=$(bd_field "$repo" "$id" '.status' 2>/dev/null) || status=""
    TASK_STATE=$(task_state "$repo" "$id")
    into=$(recorded_base_branch) || into=$base # the base the task's runs kept
    if ((force)) || merged_into "$repo" "$branch" "$into" "$status"; then
      if [[ -n $ws ]]; then
        h worktree remove --workspace "$ws" --force >/dev/null
      elif [[ -n $path ]]; then
        git -C "$repo" worktree remove --force "$path"
      fi
      git -C "$repo" worktree prune
      git -C "$repo" branch -D "$branch" >/dev/null
      # Factory's state for the task: its base and checks would hold for the task run again.
      # An earlier Factory kept its fetch of origin's base for a task in refs/factory/<id>/,
      # which goes with the task: that line can go once the tasks it ran are cleaned.
      if is_bead_id "$id"; then
        rm -rf "$TASK_STATE"
        git -C "$repo" for-each-ref --format='delete %(refname)' "refs/factory/$id/" | git -C "$repo" update-ref --no-deref --stdin
      fi
      if [[ -n $status && $status != closed ]]; then
        why=merged
        ((force)) && why=dropped
        bd -C "$repo" close "$id" -r "Factory clean: branch $branch $why" >/dev/null
      fi
      log "cleaned $branch${ws:+ (workspace $ws)}"
      n=$((n + 1))
    elif [[ -n $status && $status != closed ]]; then
      log "keeping $branch: task $id is $status (factory clean $repo $id --force to drop it)"
    else
      log "keeping $branch: not merged into $into (factory clean $repo $id --force to drop it)"
    fi
  done < <(clean_targets "$repo")
  git -C "$repo" worktree prune # stale entries from anywhere, not only ours
  log "cleaned $n task branch(es)"
  ((n == 0)) || bd_push "$repo"
}

# clean_targets repo -> "branch|workspace|path" for every factory/* branch (fields may be empty)
clean_targets() {
  local repo=$1 known
  known=$(herdr worktree list --cwd "$repo" 2>/dev/null | jq -r '.result.worktrees[]? | select((.branch // "") | startswith("factory/")) | "\(.branch)|\(.open_workspace_id // "")|\(.path)"') || known=""
  git -C "$repo" branch --list 'factory/*' --format='%(refname:short)' | while IFS= read -r branch; do
    grep -m1 -F "$branch|" <<<"$known" || printf '%s||%s\n' "$branch" "$(worktree_of "$repo" "$(bead_of_branch "$branch")")"
  done
}

# cmd_check worktree base: the gate and the guardrails on the branch checked out there, no
# agents; a failed gate's log stays for you to read
cmd_check() {
  local gate id gate_log
  gate=$(resolve_gate "$1")
  # in a task's worktree, the human's waiver for the task holds as in its run
  if id=$(cd "$1" && task_args && printf '%s' "${TARGS[1]}"); then
    TASK_STATE=$(task_state "$1" "$id")
  fi
  gate_log=$(mktemp)
  if ! run_gate "$1" "$gate" "$gate_log"; then
    tail -n "$GATE_LOG_TAIL" "$gate_log"
    return 1
  fi
  rm -f "$gate_log"
  if ! guard_check "$1" "$2"; then
    warn "guardrails failed"
    return 1
  fi
  log "guardrails passed"
}

# load_repo_env dir: FACTORY_NAME=value lines from the .factory/env of the checkout the dir is
# in set the knobs the environment left unset. Parsed, never sourced: values are taken
# verbatim, no quotes, no expansion; blank lines and # comments are skipped; anything else is
# an error.
load_repo_env() {
  local top file line name applied=()
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 0
  file=$top/.factory/env
  [[ -f $file ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    [[ $line =~ ^(FACTORY_[A-Z0-9_]+)=(.*)$ ]] || die "$file: expected FACTORY_NAME=value, got: $line"
    name=${BASH_REMATCH[1]}
    # the knobs are set by now, but for FACTORY_GATE; anything else is a typo, which the knob it
    # meant would never see
    if [[ $name == FACTORY_HOME || $name == FACTORY_VERSION || $name == FACTORY_PID ]] \
      || ! [[ -v $name || $name == FACTORY_GATE ]]; then
      die "$file: $name is not a knob (see factory help)"
    fi
    grep -qxF "$name" <<<"$ENV_KNOBS" && continue
    printf -v "$name" '%s' "${BASH_REMATCH[2]}"
    applied+=("$name")
  done <"$file"
  ((${#applied[@]})) && log "knobs from $file: ${applied[*]}"
  return 0
}

# take_flags args...: consume --pr, --auto, --no-copilot and --fresh anywhere in the args; the
# rest land in ARGS.
take_flags() {
  ARGS=()
  local a
  for a in "$@"; do
    case $a in
      --pr) FACTORY_PR=1 ;;
      --no-copilot) FACTORY_COPILOT=0 ;;
      --auto) FACTORY_APPROVAL=auto ;;
      --fresh) FACTORY_FRESH=1 ;;
      --*) die "unknown flag: $a (try: factory help)" ;;
      *) ARGS+=("$a") ;;
    esac
  done
}

# main command args...: the knobs of the repo the args name, then the command
main() {
  local cmd=${1:-help} a u
  if (($# > 0)); then shift; fi
  [[ $cmd != next ]] || DIE_STATUS=4 # its checks below come before its claim (cmd_next)
  case $cmd in
    tasks | approve | reject | abort | stats | dialog-hook) ;; # these read no knob
    *)
      for a in "$@"; do # the first non-flag argument usually names the repo (task_args finds it in a worktree)
        if [[ $a != --* ]]; then
          load_repo_env "$a"
          break
        fi
      done
      ;;
  esac
  case $cmd in
    run)
      take_flags "$@"
      ((${#ARGS[@]} == 2)) || die "usage: factory run [--pr] [--auto] [--no-copilot] [--fresh] <repo> <bead-id | \"task title\">"
      need_all "${RUN_TOOLS[@]}"
      check_knobs
      check_push "${ARGS[0]}"
      run_task "${ARGS[0]}" "${ARGS[1]}"
      ;;
    next)
      take_flags "$@"
      ((${#ARGS[@]} == 1)) || die "usage: factory next [--pr] [--auto] [--no-copilot] [--fresh] <repo>"
      need_all "${RUN_TOOLS[@]}"
      check_knobs
      check_push "${ARGS[0]}"
      cmd_next "${ARGS[0]}"
      ;;
    queue)
      take_flags "$@"
      ((${#ARGS[@]} == 1 || ${#ARGS[@]} == 2)) && [[ ${ARGS[1]:-1} =~ ^[1-9][0-9]*$ ]] \
        || die "usage: factory queue [--pr] [--auto] [--no-copilot] [--fresh] <repo> [max]"
      need_all "${RUN_TOOLS[@]}"
      check_knobs
      check_push "${ARGS[0]}"
      cmd_queue "${ARGS[@]}"
      ;;
    tasks)
      (($# >= 1)) || die "usage: factory tasks <repo> [--all | bd list args...]"
      need_all bd jq
      cmd_tasks "$@"
      ;;
    add)
      (($# >= 1 && $# <= 3)) || die "usage: factory add <repo> [\"title\" [description]]"
      need bd
      check_knobs
      cmd_add "$@"
      ;;
    init)
      (($# >= 1)) || die "usage: factory init <repo> [bd init args...]"
      need bd
      cmd_init "$@"
      ;;
    approve)
      u="usage: factory approve [<repo> <bead-id>] [--allow-protected]  (without them in a task's worktree)"
      task_args "$@" || die "$u"
      set -- "${TARGS[@]}"
      [[ $# == 2 || ($# == 3 && $3 == --allow-protected) ]] || die "$u"
      cmd_approve "$@"
      ;;
    reject)
      u="usage: factory reject [<repo> <bead-id>] '<note>'  (without them in a task's worktree)"
      task_args "$@" || die "$u"
      set -- "${TARGS[@]}"
      (($# >= 3)) || die "$u"
      cmd_reject "$1" "$2" "${*:3}"
      ;;
    abort)
      u="usage: factory abort [<repo> <bead-id>]  (without them in a task's worktree)"
      task_args "$@" || die "$u"
      set -- "${TARGS[@]}"
      (($# == 2)) || die "$u"
      cmd_abort "$1" "$2"
      ;;
    dialog-hook) cmd_dialog_hook "$@" ;; # Claude Code's hooks, see dialog_hooks
    pr)
      take_flags "$@"
      [[ ${#ARGS[@]} == 2 && " $* " != *" --auto "* && " $* " != *" --fresh "* ]] \
        || die "usage: factory pr <repo> <bead-id> [--no-copilot]"
      need_all herdr gh bd jq git
      check_knobs
      cmd_pr "${ARGS[0]}" "${ARGS[1]}"
      ;;
    clean)
      (($# >= 1)) || die "usage: factory clean <repo> [bead-id] [--force]"
      need_all herdr bd jq git
      check_knobs
      cmd_clean "$@"
      ;;
    check)
      (($# == 2)) || die "usage: factory check <worktree> <base>"
      need git
      check_knobs
      cmd_check "$1" "$2"
      ;;
    stats)
      (($# == 1)) || die "usage: factory stats <repo>"
      need_all git jq
      cmd_stats "$1"
      ;;
    status)
      need_all herdr jq
      cmd_status
      ;;
    doctor) cmd_doctor ;;
    -h | --help | help) usage ;;
    -V | --version) printf 'factory %s\n' "$FACTORY_VERSION" ;;
    *) die "unknown command: $cmd (try: factory help)" ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  FACTORY_PID=$$
  trap 'exit "$DIE_STATUS"' USR1 # a die in a subshell, see die
  main "$@"
  exit # never read on past this: a run takes hours, and the file on disk may have changed
fi
