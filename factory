#!/usr/bin/env bash
# Factory: a simple software factory on Herdr. CLI name: factory.
# Claude Code plans (Fable) and builds (Opus), Codex reviews (GPT), Beads remembers.
set -euo pipefail
unset CDPATH # a cd to a relative dir would print it into the $(...) around it
# The least Bash Factory runs on, checked before Bash reads on: an older one takes an empty
# array for an unset variable (set -u), and one before 4.2 cannot read the script at all.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  printf '\033[31m[factory] error:\033[0m Factory needs Bash 4.4 or newer; this is Bash %s\n' "$BASH_VERSION" >&2
  exit 1
fi

FACTORY_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
FACTORY_VERSION=0.1.11

# Knobs; factory help prints the current values. A repo's .factory/env fills in the
# ones the environment left unset (load_repo_env); flags override both.
ENV_KNOBS=$(compgen -A variable FACTORY_)
: "${FACTORY_PLAN_MODEL:=claude-fable-5-1}"
: "${FACTORY_BUILD_MODEL:=claude-opus-5-5}"
: "${FACTORY_REVIEW_MODEL:=gpt-6-astra}"
: "${FACTORY_PLAN_EFFORT:=max}"
: "${FACTORY_BUILD_EFFORT:=xhigh}"
: "${FACTORY_REVIEW_EFFORT:=xhigh}"
: "${FACTORY_PLAN_ROUNDS:=3}"
: "${FACTORY_ROUNDS:=3}"
: "${FACTORY_CLAUDE_PERMISSIONS:=auto}"
: "${FACTORY_REQUIRE_TESTS:=1}"
: "${FACTORY_APPROVAL:=ask}"
: "${FACTORY_PR:=0}"
: "${FACTORY_COPILOT:=1}"
: "${FACTORY_COPILOT_ROUNDS:=3}"
: "${FACTORY_BD_PUSH:=1}"
: "${FACTORY_FRESH:=0}"
: "${FACTORY_WORKSPACE_SCRIPT:=}"
COPILOT_BOT='copilot-pull-request-reviewer[bot]'
COPILOT_WAIT_S=900 # for each Copilot review
# an hour: a turn stalled by then fails, one still working or waiting for your input toasts you
# and goes on
TURN_TIMEOUT_MS=3600000
POLL_SECONDS=5 # between looks for your answer at a gate, and at an open question
# the forbidden patterns; a repo's own .factory/guardrails.txt replaces them
GUARDRAILS=$FACTORY_HOME/guardrails.txt
RUN_DIR=.factory/run
# lines of a failed gate's log to show: a failure's own lines, past the build's noise
GATE_LOG_TAIL=40
# files that look like tests, for the tests-required guardrail
TEST_PATH_RE='(^|/)(tests?|spec|specs|__tests__|bats)/|(^|/)test_[^/]*\.py$|_test\.[a-z]+$|\.(test|spec)\.[a-z]+$|Tests?\.(java|kt|scala|cs|swift)$|_spec\.rb$|\.bats$'

# ---------------------------------------------------------------- output ----
TAG=$'\033[34m[factory]\033[0m' # log's prefix, shared with the prompts that must not end the line
log() { printf '%s %s\n' "$TAG" "$*" >&2; }
warn() { printf '\033[33m[factory]\033[0m %s\n' "$*" >&2; }
die() {
  printf '\033[31m[factory] error:\033[0m %s\n' "$*" >&2
  # inside $(...) exit ends only the subshell, and a caller in a || list would carry on
  [[ -z ${FACTORY_PID:-} || $BASHPID == "$FACTORY_PID" ]] || kill -s USR1 "$FACTORY_PID"
  exit "$DIE_STATUS"
}
DIE_STATUS=1 # die's exit status, a die's in a subshell too; a factory next's is 4 until its claim
need() { command -v "$1" >/dev/null 2>&1 || die "missing prerequisite: $1"; }
need_all() {
  local t
  for t in "$@"; do need "$t"; done
}
RUN_TOOLS=(herdr claude codex bd jq git)

row() { printf '  %-54s %s\n' "$1" "$2"; }

# usage: the commands, the flags and the knobs with their current values
usage() {
  printf 'Factory %s: a simple software factory on Herdr\n\nusage:\n' "$FACTORY_VERSION"
  row 'factory run     <repo> <bead-id | "task title">' 'plan, build, gate, review one task'
  row 'factory next    <repo>' 'claim the next ready bead and run it'
  row 'factory queue   <repo> [max]' 'run ready beads one after another'
  row '  flags: --pr, --auto, --no-copilot, --fresh' 'open a PR; skip both approvals; no Copilot review; do not resume'
  row 'factory add     <repo> ["title" [description]]' 'file a task; no title opens your editor (or reads stdin)'
  row 'factory tasks   <repo> [--all | bd list args...]' 'open tasks: in progress, then in the order next takes them'
  row 'factory init    <repo> [bd init args...]' 'lean bd init with a short prefix, detect the gate, AGENTS.md stub'
  row 'factory approve <repo> <bead-id> [--allow-protected]' 'approve the plan or build; --allow-protected (plan only) allows the protected paths it names'
  row "factory reject  <repo> <bead-id> '<note>'" 'send a note back; the plan or build comes back revised'
  row 'factory abort   <repo> <bead-id>' 'abort the task at its waiting plan or build'
  row '  in a task'"'"'s worktree: no <repo> <bead-id>' 'the task is the one there: !fy approve in a pane that shows no dialog'
  row 'factory pr      <repo> <bead-id> [--no-copilot]' 'check, push an existing task branch and open a pull request'
  row 'factory clean   <repo> [bead-id] [--force]' 'remove workspaces, worktrees and branches of merged tasks; --force: of one you abandoned'
  row 'factory check   <worktree> <base>' 'run gate + guardrails on a branch, no agents'
  row 'factory stats   <repo>' 'how its tasks went: rounds, failures, your notes, time, tokens'
  row 'factory status' 'live Factory agents in Herdr'
  row 'factory doctor' 'check prerequisites'
  row 'factory help | --version' 'this help; the version'
  printf '\nknobs (env, or the repo'"'"'s .factory/env; current values):\n'
  row "FACTORY_PLAN_MODEL=$FACTORY_PLAN_MODEL" 'planner (Claude Code)'
  row "FACTORY_BUILD_MODEL=$FACTORY_BUILD_MODEL" 'builder (Claude Code)'
  row "FACTORY_REVIEW_MODEL=$FACTORY_REVIEW_MODEL" 'reviewer (Codex)'
  row "FACTORY_PLAN_EFFORT=$FACTORY_PLAN_EFFORT" 'planner effort: low, medium, high, xhigh, max'
  row "FACTORY_BUILD_EFFORT=$FACTORY_BUILD_EFFORT" 'builder effort: low, medium, high, xhigh, max'
  row "FACTORY_REVIEW_EFFORT=$FACTORY_REVIEW_EFFORT" 'reviewer effort: the same, and ultra'
  row "FACTORY_PLAN_ROUNDS=$FACTORY_PLAN_ROUNDS" 'plan review rounds before the build; a note of yours gets one more'
  row "FACTORY_ROUNDS=$FACTORY_ROUNDS" 'build / review rounds before giving up; a note of yours at the last gets one more'
  row "FACTORY_CLAUDE_PERMISSIONS=$FACTORY_CLAUDE_PERMISSIONS" 'Claude Code permission mode'
  row 'FACTORY_GATE=<command>' 'else .factory/gate, else the repo'"'"'s own convention'
  row "FACTORY_REQUIRE_TESTS=$FACTORY_REQUIRE_TESTS" '1: code changes must touch a test file (in Rust, a test in the file will do)'
  row "FACTORY_APPROVAL=$FACTORY_APPROVAL" 'ask: you approve each plan and build; auto (--auto): skip'
  row "FACTORY_PR=$FACTORY_PR" '1: push the approved branch and open a pull request (--pr)'
  row "FACTORY_COPILOT=$FACTORY_COPILOT" '1: request a Copilot review on the PR and act on its comments (0: --no-copilot)'
  row "FACTORY_COPILOT_ROUNDS=$FACTORY_COPILOT_ROUNDS" 'Copilot review rounds before giving up'
  row "FACTORY_BD_PUSH=$FACTORY_BD_PUSH" '1: push the Beads database to its sync remote after tasks, adds, PRs and cleans'
  row "FACTORY_FRESH=$FACTORY_FRESH" '1: start the task over instead of resuming (--fresh)'
  row "FACTORY_WORKSPACE_SCRIPT=$FACTORY_WORKSPACE_SCRIPT" 'run once in each workspace Factory makes for a task: tabs of your own, say'
}

# ------------------------------------------------------------- preflight ----
# git_version -> git's version, as 2.43.0; git_at_least version: 0 when git is that or later
git_version() { git version | grep -oE '[0-9]+(\.[0-9]+)+' | head -n 1; }
git_at_least() { [[ $(printf '%s\n' "$1" "$(git_version)" | sort -V | head -n 1) == "$1" ]]; }

# check_knobs: a knob Factory cannot read stops here, before a bead is claimed. Claude Code
# ignores an unknown effort with a warning in its pane and Codex fails the reviewer's first turn
# on one; an approval mode other than ask would pass both human gates unasked; a flag or a count
# that is no number breaks bash's arithmetic halfway through a run.
check_knobs() {
  local k levels='low|medium|high|xhigh|max'
  for k in FACTORY_PLAN_EFFORT FACTORY_BUILD_EFFORT FACTORY_REVIEW_EFFORT; do
    [[ $k == FACTORY_REVIEW_EFFORT ]] && levels+='|ultra' # Codex's own level
    [[ ${!k} =~ ^($levels)$ ]] || die "$k=${!k}: not an effort level (${levels//|/, })"
  done
  [[ $FACTORY_APPROVAL =~ ^(ask|auto)$ ]] || die "FACTORY_APPROVAL=$FACTORY_APPROVAL: ask or auto"
  for k in FACTORY_REQUIRE_TESTS FACTORY_PR FACTORY_COPILOT FACTORY_BD_PUSH FACTORY_FRESH; do
    [[ ${!k} =~ ^[01]$ ]] || die "$k=${!k}: 0 or 1"
  done
  for k in FACTORY_PLAN_ROUNDS FACTORY_ROUNDS FACTORY_COPILOT_ROUNDS; do
    [[ ${!k} =~ ^[1-9][0-9]*$ ]] || die "$k=${!k}: a whole number above 0"
  done
}

# check_push repo: a run with FACTORY_PR=1 ends by pushing its branch, maybe hours later with
# nobody at the terminal, so origin must take a push without a prompt; that is checked here,
# before a bead is claimed. A dry run has the remote check the credentials and the write
# access, and sends nothing.
check_push() {
  local out
  ((FACTORY_PR)) || return 0
  need gh
  git -C "$1" remote get-url origin >/dev/null 2>&1 || die "$1 has no origin remote to push the pull request's branch to; add one, or run without --pr (FACTORY_PR=0)"
  if ! out=$(GIT_TERMINAL_PROMPT=0 git -C "$1" push --dry-run --quiet origin HEAD:refs/heads/factory/push-check 2>&1); then
    printf '%s\n' "$out" >&2
    die "origin takes no push from $1 without a prompt, so the run could not open its pull request; fix git's credentials (for GitHub over https: gh auth setup-git, or, with gh from mise, a helper that runs mise's gh shim, as extras/factory-user/README.md shows), or run without --pr (FACTORY_PR=0)"
  fi
}

# check_base repo: a run that opens a pull request opens it against the task's base, which must
# be a branch on origin; one merged and deleted there, say, would fail the pull request after
# all the work. Checked as the task starts, before its bead is claimed.
check_base() {
  local out rc=0 wt
  out=$(GIT_TERMINAL_PROMPT=0 git -C "$1" ls-remote --exit-code --heads origin "refs/heads/$BASE" 2>&1) || rc=$?
  ((rc != 0)) || return 0
  if ((rc == 2)); then
    wt=$(worktree_of "$1" "$TASK_ID")
    die "the task's base, $BASE, is no branch on origin, so its pull request could not be opened; push it$([[ -z $wt ]] || printf ', or check out the base the task should have and rerun with --fresh, which starts it over')"
  fi
  printf '%s\n' "$out" >&2
  die "could not read origin's branches for the task's base, $BASE (above); fix git's access to origin, then rerun"
}

# check_deps repo: a task taken up anew, or started over, stops before its bead is claimed while
# it builds on a task whose branch is not merged into its base (waits_for), as one whose pull
# request is still open: it would start without that code. A task under way keeps its base.
check_deps() {
  local why
  ((FACTORY_FRESH)) || [[ ! -s $TASK_STATE/base ]] || return 0
  why=$(waits_for "$1" "$TASK_ID" "$BASE") || die "bd could not show $TASK_ID in $1, to read the tasks it builds on"
  [[ -z $why ]] || die "$TASK_ID builds on $why, not merged into $BASE yet, and would start without that code: merge it first, or drop the dependency (bd dep remove) if $TASK_ID does not need it"
}

# ----------------------------------------------------------------- herdr ----
# h: run a herdr command and print its JSON; one that fails dies with herdr's message (herr_msg)
h() {
  local out
  if ! out=$(herdr "$@" 2>&1); then
    die "herdr $1 $2: $(herr_msg "$out")"
  fi
  printf '%s' "$out"
}

herr_code() { jq -r '.error.code // empty' <<<"$1" 2>/dev/null; }
herr_msg() { jq -r '.error.message // .' <<<"$1" 2>/dev/null || printf '%s' "$1"; }

# screen_of agent: what the agent's pane shows now
screen_of() { herdr agent read "$1" --source visible 2>/dev/null; }

# poll tries seconds cmd...: run cmd until it succeeds, at most tries times, seconds apart
poll() {
  local tries=$1 seconds=$2 i
  shift 2
  for ((i = 1; i <= tries; i++)); do
    "$@" && return 0
    ((i == tries)) || sleep "$seconds"
  done
  return 1
}

# toast title body sound; the title is prefixed with the product name
toast() {
  herdr notification show "Factory: $1" --body "$2" --sound "$3" >/dev/null 2>&1 || warn "toast failed: $1"
}

# attention agent message
attention() {
  warn "$1 $2"
  toast "$TASK_ID" "$1 $2" request
}

# agent_status name -> the agent's state as Herdr reads it: working, blocked, idle, done
agent_status() { h agent get "$1" | jq -r '.result.agent.agent_status'; }
agent_seq() { h agent get "$1" | jq -r '.result.agent.state_change_seq // 0'; } # Herdr's count of its state changes

# wait_for name timeout_ms state... -> the state the agent reached, one of those given. Waits
# in one-minute chunks: each re-checks a blocked agent's screen for a known dialog, and every
# five minutes prints a heartbeat, so a long gate run is visibly a wait and not a hang.
wait_for() {
  local name=$1 timeout=$2 out status waited=0 chunk=60000 nagged=0
  shift 2
  local args=()
  local s
  for s in "$@"; do args+=(--until "$s"); done
  while :; do
    if out=$(herdr agent wait "$name" "${args[@]}" --timeout "$chunk" 2>&1); then
      jq -r '.result.agent.agent_status' <<<"$out"
      return 0
    fi
    [[ $(herr_code "$out") == timeout ]] || die "$name: waiting for ${*}: $(herr_msg "$out")"
    waited=$((waited + chunk))
    status=$(agent_status "$name")
    if ((waited >= timeout)); then
      # a turn that is visibly working is a long build, and a blocked one waits for the human,
      # not a stall: tell the human once and keep waiting
      [[ $status == working || $status == blocked ]] || die "$name: no ${*} within $((timeout / 60000)) min and it is $status; look at its pane"
      if ((! nagged)); then
        nagged=1
        if [[ $status == blocked ]]; then
          attention "$name" "is still waiting for your input after $((timeout / 60000)) min"
        else
          attention "$name" "is still working after $((timeout / 60000)) min; fine for a long build, Ctrl-C the run if it is stuck"
        fi
      fi
    fi
    # a blocked agent may be on a dialog Factory knows; a working one's screen may only show
    # such a dialog's words, and a key typed there would land in its turn
    [[ $status != blocked ]] || settle_dialogs "$name" quiet
    ((waited % 300000 == 0)) && log "still waiting on $name ($status, $((waited / 60000)) min)"
  done
}

# keys agent key, pane_keys pane key: type a key into an agent's pane. A failure is told, not
# fatal: the wait after it notices what the key did not do.
keys() { herdr agent send-keys "$1" "$2" >/dev/null 2>&1 || warn "could not type $2 into $1's pane"; }
pane_keys() { herdr pane send-keys "$1" "$2" >/dev/null 2>&1 || warn "could not type $2 into pane $1"; }

# settle_dialogs name [quiet]: clear the startup dialogs agents show in a fresh worktree
# (trust prompts, mode notices, Codex hook review). Herdr does not flag all of them
# as blocked, so this looks at the screen rather than the reported state. With quiet it
# returns as soon as none is on screen, and never dies; without, a dialog it cannot
# clear goes to the human once, and the run waits for the answer. Six looks, three seconds
# apart: one dialog can follow another (Codex's trust, then its hooks), each a moment later.
settle_dialogs() {
  local name=$1 quiet=${2:-} i txt status
  for i in 1 2 3 4 5 6; do
    txt=$(screen_of "$name") || txt=""
    # a question the agent asks the human, which no key of ours may answer, whatever it says
    question_on_screen <<<"$txt" && break
    if grep -qE 'Yes, I (trust|accept)' <<<"$txt"; then
      log "$name: accepting startup dialog (attempt $i)"
      keys "$name" down
      sleep 0.5
      keys "$name" enter
    elif grep -qF 'This conversation is open in another app' <<<"$txt"; then
      # Codex resuming a session another Codex still holds. A process just quit lets go of it
      # in a moment, but Codex's background server, which a Codex Herdr restored runs in,
      # holds it for 30 minutes after that one quit. So a retry or two, then the dialog's
      # fork: a new session with the same history, run with this Codex's arguments.
      if ((i < 3)); then
        log "$name: its session is still held by another Codex; retrying (attempt $i)"
        keys "$name" r
      else
        log "$name: its session is still held by another Codex; going on in a fork of it, its history kept (attempt $i)"
        keys "$name" f
      fi
    elif grep -qE 'Do you trust the contents of this directory|Trust this folder\?' <<<"$txt"; then
      log "$name: accepting Codex trust dialog (attempt $i)"
      keys "$name" enter
    elif grep -qE 'hooks need review|Press enter to view hooks' <<<"$txt"; then
      log "$name: closing Codex hooks dialog without enabling hooks (attempt $i)"
      keys "$name" esc
    elif grep -qE 'q close +esc to edit prev|T R A N S C R I P T' <<<"$txt"; then
      # Codex opens its transcript overlay to show startup warnings (e.g. a failed MCP);
      # Herdr sees an idle agent, but typed prompts go nowhere until it is closed.
      log "$name: closing Codex transcript overlay (attempt $i)"
      keys "$name" q
    else
      [[ -n $quiet ]] && return 0 # nothing on screen we know; the caller keeps waiting
      status=$(agent_status "$name")
      case $status in idle | done) return 0 ;; esac
    fi
    sleep 3
  done
  [[ -n $quiet ]] && return 0
  status=$(agent_status "$name")
  case $status in
    idle | done) return 0 ;;
    blocked)
      attention "$name" "is blocked on a dialog Factory could not clear; answer it in its pane"
      wait_for "$name" "$TURN_TIMEOUT_MS" idle "done" >/dev/null
      settle_dialogs "$name" quiet # a known dialog may follow the answered one
      return 0
      ;;
  esac
  die "$name: still $status, and nothing on its screen Factory knows to clear; look at its pane"
}

# dialog_hooks plan|build -> Claude Code settings for the task's planner or builder: its
# question dialogs report to factory dialog-hook as they open (PreToolUse), when answered
# (PostToolUse), and at the end of each turn (Stop). The hook is told the task, its run dir and
# Factory's state for it, not left to find them from wherever the agent's shell is. The agent
# may not run what is Factory's or the human's to run (permissions.deny, a check on its
# commands, not a sandbox): a push, which would put unchecked commits in the pull request, gh,
# and Factory itself, whose approve would answer the human's gate. A hook runs outside these
# rules.
dialog_hooks() {
  jq -n --arg cmd "$(printf '%q dialog-hook %s %q %q %q' "$FACTORY_HOME/factory" "$1" "$TASK_ID" "$WT/$RUN_DIR" "$TASK_STATE")" \
    --arg self "$FACTORY_HOME/factory" \
    '[{hooks: [{type: "command", command: $cmd}]}] as $h | ($h | map(. + {matcher: "AskUserQuestion"})) as $q
     | {hooks: {PreToolUse: $q, PostToolUse: $q, Stop: $h},
        permissions: {deny: ["git push", "gh", "fy", "factory", $self] | map("Bash(\(.):*)")}}'
}

# set_color agent colour: Claude Code's /color tints the session's prompt line, which is how
# the two Claude panes are told apart: the planner is purple, the builder cyan. A session just
# started can take its input in bursts, in which a command and its Enter come in as one paste:
# the Enter turns into a newline, and the command waits in the prompt for the next one to join
# it. So the command is typed first, and its Enter goes in once the prompt shows it.
set_color() {
  local pane
  if pane=$(herdr agent get "$1" 2>/dev/null | jq -er '.result.agent.pane_id') && poll 60 1 box_drawn "$1" \
    && herdr pane send-text "$pane" "/color $2" >/dev/null 2>&1 && poll 30 1 colour_draft "$1"; then
    keys "$1" enter
    poll 10 1 colour_set "$1" "$2" && return 0
  fi
  warn "$1: could not set the session colour"
}

# colour_set agent colour: the agent's screen says its session's colour is set to that one, in
# words a narrow pane may wrap
colour_set() {
  local txt
  txt=$(screen_of "$1") || return 1
  txt=$(tr '\n' ' ' <<<"$txt" | tr -s ' ')
  [[ $txt == *"Session color set to: $2"* ]]
}

# colour_draft agent: a /color waits in the agent's prompt box, between the last two rules
colour_draft() {
  screen_of "$1" | awk '/^─/ { r[++n] = NR } { l[NR] = $0 }
    END { if (n < 2) exit 1; for (i = r[n - 1] + 1; i < r[n]; i++) if (l[i] ~ /\/color/) exit 0; exit 1 }'
}

# close_extra_panes workspace keep-pane: drop the panes a planner and a reviewer that quit left,
# the ones Factory labelled so, where the shell waits at its prompt again. Any other pane in the
# workspace is the human's, as in a tab of their own, and so is one that runs something.
close_extra_panes() {
  local ws=$1 keep=$2 pane
  while IFS= read -r pane; do
    [[ -n $pane && $pane != "$keep" ]] || continue
    shell_waits "$pane" || continue
    herdr pane close "$pane" >/dev/null 2>&1 || warn "could not close leftover pane $pane"
  done < <(herdr pane list --workspace "$ws" 2>/dev/null | jq -r '.result.panes[] | select(.label == "plan" or .label == "review") | .pane_id')
}

# own_pane role -> the pane Factory made for the role in the task's workspace, labelled with it,
# where the shell waits at its prompt; 1 with none, 2 with none but the one this run of Factory
# is in (Herdr gives each pane's shell its id, HERDR_PANE_ID)
own_pane() {
  local pane rc=1
  while IFS= read -r pane; do
    [[ -n $pane ]] || continue
    if shell_waits "$pane"; then
      printf '%s' "$pane"
      return 0
    fi
    [[ $pane != "${HERDR_PANE_ID:-}" ]] || rc=2
  done < <(h pane list --workspace "$WS" | jq -r --arg role "$1" '.result.panes[] | select(.label == $role) | .pane_id')
  return "$rc"
}

# live_agents workspace name... -> how many of the named agents are alive in that workspace
live_agents() {
  local ws=$1
  shift
  h agent list | jq -r --arg ws "$ws" --argjson names "$(printf '%s\n' "$@" | jq -cRn '[inputs]')" \
    '[.result.agents[] | select(.workspace_id == $ws and ((.name // "") as $n | $names | index($n)))] | length'
}

# prime_shell pane: run the env setup in the pane, in the task's worktree, where a human may have
# left the shell of an agent's pane elsewhere, and make sure it actually ran: its mark is new
# each time, as an agent that quit leaves the screen of its start, the last mark on it. A fresh
# shell's line editor (ble.sh) sometimes swallows the Enter and sits in multiline mode;
# Ctrl-C gives a clean prompt again, then the command is retried.
prime_shell() {
  local pane=$1 i mark
  for i in 1 2 3; do
    mark=$RANDOM$RANDOM
    h pane run "$pane" "cd $(printf '%q' "$WT") && . $RUN_DIR/env.sh && clear && printf 'factory-ready-%s\\n' $mark" >/dev/null
    herdr pane wait-output --match "factory-ready-$mark" --source visible --timeout 8000 "$pane" >/dev/null 2>&1 && return 0
    warn "pane $pane did not run its setup command; clearing the input line and retrying"
    pane_keys "$pane" c-c
    sleep 1
  done
  die "pane $pane: the shell does not run commands; look at it"
}

# start_agent name kind pane [agent args...]
start_agent() {
  local name=$1 kind=$2 pane=$3 out i
  shift 3
  for i in 1 2 3 4 5; do
    if out=$(herdr agent start "$name" --kind "$kind" --pane "$pane" --timeout 90000 -- "$@" 2>&1); then
      sleep 2 # a startup dialog draws a moment after the agent reads as started
      settle_dialogs "$name"
      return 0
    fi
    case $(herr_code "$out") in
      agent_not_ready)
        settle_dialogs "$name"
        return 0
        ;;
      pane_not_available | pane_busy | shell_not_ready)
        sleep 1
        ;;
      agent_start_failed | timeout)
        # "timed out waiting for agent startup" (Herdr 0.8 calls it timeout): usually the
        # pane's shell never ran the command, its line editor stuck in multiline mode, as a
        # long command line can leave ble.sh; clear its input and try again
        grep -q 'timed out' <<<"$out" || die "start $name: $(herr_msg "$out")"
        warn "$name: startup timed out; clearing the pane's input line and retrying"
        pane_keys "$pane" c-c
        sleep 2
        ;;
      *) die "start $name: $(herr_msg "$out")" ;;
    esac
  done
  die "start $name: pane $pane never became an available shell; look at it"
}

# ask name text: one turn of the agent (take_turn), recorded with the time it took
ask() {
  local t0=$SECONDS
  take_turn "$@"
  metric turn agent "${1##*-}" secs $((SECONDS - t0))
}

# take_turn name text: send a prompt and wait for the turn to settle, handing blocks to the human.
take_turn() {
  local name=$1 text=$2 out status stalls=0 seq
  # a turn under way ends first, the agent's reply to the human or to a command typed in its
  # pane: herdr's wait does not track turns and could match that turn's end instead. When the
  # state cannot be read, h has said why; exit also ends a $(...) caller, where errexit is off.
  status=$(agent_status "$name") || exit 1
  [[ $status != working ]] || wait_for "$name" "$TURN_TIMEOUT_MS" idle "done" blocked >/dev/null
  while :; do
    await_answer "$name" # typed into a question dialog, the prompt's Enter would answer it
    seq=$(agent_seq "$name") || exit 1
    if out=$(herdr agent prompt "$name" "$text" --wait --timeout 60000 2>&1); then
      break
    fi
    case $(herr_code "$out") in
      agent_prompt_stalled)
        if prompt_landed "$name" "$seq"; then # it went in late: its turn is the answer
          turn_ends "$name"
          return 0
        fi
        stalls=$((stalls + 1))
        ((stalls < 3)) || die "$name: prompt stalled 3 times; look at its pane"
        settle_dialogs "$name"
        ;;
      agent_blocked)
        unblock "$name"
        ;;
      timeout)
        turn_ends "$name"
        return 0
        ;;
      *) die "$name: $(herr_msg "$out")" ;;
    esac
  done
  status=$(jq -r '.result.agent.agent_status' <<<"$out")
  [[ $status == blocked ]] && unblock "$name"
  await_answer "$name" # a question Herdr took for the end of the turn
  return 0
}

# prompt_landed name seq: Herdr calls a submitted prompt stalled when the agent shows no new
# state within 5 s, but a long prompt can take Codex longer to start its turn (seen live). A
# state change since seq within 20 s says it went in after all; sent again, it would ask twice.
prompt_landed() { poll 20 1 seq_moved "$1" "$2"; }
seq_moved() { [[ $(agent_seq "$1") != "$2" ]]; } # name seq: Herdr counts a state change since seq

# turn_ends name: a prompt went in that herdr's wait did not see through: its turn ends, a
# block goes to the human, and a question waits for its answer
turn_ends() {
  local status
  status=$(wait_for "$1" "$TURN_TIMEOUT_MS" idle "done" blocked)
  [[ $status != blocked ]] || unblock "$1"
  await_answer "$1"
}

# QUESTION_SCREEN: a Claude Code question dialog: a question's footer, whose first hint survives
# a wrap in a narrow pane, the review step of several questions, which has none, or the note of
# the transcript view (ctrl+o) that a dialog waits under it
QUESTION_SCREEN='Enter to select · |Ready to submit your answers[?]|dialog waiting · '

# question_on_screen: an agent's screen (on stdin) ends in a question dialog, a question's
# footer or the review step, not in Claude Code's prompt box, empty or with a draft. The dialog
# takes the box's place: the agent's own text quoting one sits above the box, and the dialog's
# ❯ marks a numbered option. An editor opened from the dialog shows neither.
question_on_screen() {
  Q=$QUESTION_SCREEN awk '$0 ~ ENVIRON["Q"] {last = "question"; next}
    /^[[:space:]]*❯/ && !/^[[:space:]]*❯[[:space:]]*[0-9]+\./ {last = "prompt"} END {exit last != "question"}'
}

# asking name: the agent waits for the human's answer in a question dialog. Herdr can read such
# an agent as idle (in Factory's panes Claude Code draws a rule below the dialog's footer, and
# Herdr looks for the footer below the last rule), so Factory looks itself. The mark the
# dialog's hook left names the tool call: the question is open until the session's transcript
# has the call's result, which an answer, Esc and Chat about this all write, whatever the screen
# shows meanwhile (an editor, the transcript view). An agent without the hook, or a session
# without a transcript, goes by its screen alone. Codex, the reviewer, asks in no such dialog.
asking() {
  local mark id="" tp="" txt
  mark=$(asking_mark "$1") || return 1
  if [[ -s $mark ]]; then
    IFS=$'\t' read -r id tp <"$mark"
  fi
  if [[ -n $id && -f $tp ]]; then
    grep -qF "\"tool_use_id\":\"$id\"" "$tp" || return 0
    rm -f "$mark" # closed with no hook, as by Esc
    return 1
  fi
  txt=$(screen_of "$1") || return 1
  question_on_screen <<<"$txt"
}

# asking_mark agent -> the file the planner's or the builder's dialog hook keeps while it asks
asking_mark() {
  case $1 in
    "${PLAN_AGENT:-}") printf '%s' "${WT:-}/$RUN_DIR/asking-plan" ;;
    "${BUILD_AGENT:-}") printf '%s' "${WT:-}/$RUN_DIR/asking-build" ;;
    *) return 1 ;;
  esac
}

# gate_dialog_shown agent [plan|build]: the agent shows Factory's approval dialog. The screen
# is read whole first: grep -q on a pipe stops at its match, and the broken pipe it leaves the
# reader, which pipefail takes for a failure, would have a dialog on the screen read as none.
gate_dialog_shown() {
  local txt
  txt=$(screen_of "$1") || return 1
  grep -qE "☐ fy ${2:-(plan|build)}\b" <<<"$txt"
}

# await_answer name: while the agent asks the human in a question dialog, say so, wait until it
# is answered, then for the agent's turn to end; a new question is said again. Factory prompts
# no agent while one of its gates listens, so its own approval dialog found here is left from a
# gate that has ended, and no answer to it would count: it goes with Esc.
await_answer() {
  local name=$1 status t0
  while asking "$name"; do
    if gate_dialog_shown "$name"; then
      esc_question "$name"
      log "$name: dismissed an approval dialog no gate waits for"
      pause_for_pane_reply # its reply to the dismissal gets under way, for wait_for to see it end
    else
      attention "$name" "is waiting for your input"
      t0=$SECONDS
      while asking "$name"; do sleep "$POLL_SECONDS"; done
      metric question agent "${name##*-}" secs $((SECONDS - t0))
    fi
    status=$(wait_for "$name" "$TURN_TIMEOUT_MS" idle "done" blocked)
    [[ $status != blocked ]] || unblock "$name"
  done
}

# unblock name: a blocked agent gets the dialog settler first; an unknown dialog, or a question
# the agent asks the human, goes to the human, each time it asks. Returns once the agent is
# idle or done.
unblock() {
  local name=$1 status
  settle_dialogs "$name" quiet
  status=$(agent_status "$name")
  while [[ $status == blocked ]]; do
    attention "$name" "is waiting for your input"
    # once answered, its turn goes on to its end, or it asks again
    wait_for "$name" "$TURN_TIMEOUT_MS" working idle "done" >/dev/null
    status=$(wait_for "$name" "$TURN_TIMEOUT_MS" idle "done" blocked)
  done
}

# ask_for_file name text file: like ask, but the turn only counts once the file is written, not
# missing or empty
ask_for_file() {
  local name=$1 text=$2 file=$3
  ask "$name" "$text"
  [[ -s $file ]] && return 0
  warn "$name replied but $file is missing or empty; asking again"
  ask "$name" "You replied, but $file is missing or empty. Write it now and reply as asked."
  [[ -s $file ]] || die "$name never wrote $file; look at its pane, then rerun to take the task up again"
}

# launched_with agent args...: 0 when the process in the agent's pane runs with all these
# arguments, 1 when it runs without them, 2 when Herdr shows no process to tell by
launched_with() {
  local name=$1 pane argvs rc
  shift
  pane=$(herdr agent get "$name" 2>/dev/null | jq -r '.result.agent.pane_id // empty') || return 2
  [[ -n $pane ]] || return 2
  argvs=$(pane_argvs "$pane") || return 2
  rc=$(jq -r --argjson want "$(printf '%s\n' "$@" | jq -cRn '[inputs]')" \
    'if length == 0 then 2 elif any(.[]; ($want - .) == []) then 0 else 1 end' <<<"$argvs") || return 2
  return "$rc"
}

# pane_argvs pane -> the arguments of each process in the pane's foreground, as a JSON array of
# arrays, from Herdr's process info
pane_argvs() {
  herdr pane process-info --pane "$1" 2>/dev/null | jq -c '[.result.process_info.foreground_processes[]?.argv // empty]'
}

# prompt_box_up name: wait, a minute at most, until a Claude agent's screen shows its prompt
# box. A resumed session reads as ready to Herdr while it still loads, its screen the shell's
# for seconds yet, and a prompt sent meanwhile loses its Enter.
prompt_box_up() { poll 60 1 box_drawn "$1" || warn "$1: no prompt box after a minute; the next prompt may not go in"; }

# box_drawn name: the agent's screen shows the prompt box, a ❯ line between two rules, empty or
# with a draft, as no shell's prompt does; a dialog's numbered ❯ option is no box
box_drawn() {
  screen_of "$1" | awk 'NF { l[++n] = $0 } END {
    for (i = 2; i < n; i++) if (l[i] ~ /^❯/ && l[i] !~ /^❯[[:space:]]*[0-9]+\./ && l[i - 1] ~ /^─/ && l[i + 1] ~ /^─/) exit 0
    exit 1 }'
}

# resumed_session pane -> the session the process in the pane resumed, the one session id among
# its arguments (claude --resume <id>, codex resume <id>), for when Herdr names none
resumed_session() {
  pane_argvs "$1" | jq -r '[.[][] | select(test("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"))] | first // empty'
}

# agent_quit name pane claude|codex: the agent quits, its pane's shell is back in front, and Herdr
# lists it no more, so that its name can be started again. An agent that has just started can
# lose the Enter of its quit command and keep it in its input: Ctrl-C clears that for a retry.
agent_quit() {
  local quit=/exit try
  [[ $3 != codex ]] || quit=/quit
  for try in 1 2 3; do
    herdr agent prompt "$1" "$quit" >/dev/null 2>&1 || warn "$1: could not send $quit (try $try)"
    poll 10 1 quit_done "$1" "$2" && return 0
    herdr agent send-keys "$1" c-c >/dev/null 2>&1 || pane_keys "$2" c-c
  done
  die "$1 did not quit to be started again; look at its pane"
}

# quit_done name pane: the pane's shell is in front again, and Herdr lists the agent no more
quit_done() { shell_in_front "$2" && ! herdr agent get "$1" >/dev/null 2>&1; }

# shell_in_front pane: the pane's shell is in front, running nothing it started
shell_in_front() {
  herdr pane process-info --pane "$1" 2>/dev/null \
    | jq -e '.result.process_info | .shell_pid != null and .foreground_process_group_id == .shell_pid' >/dev/null
}

# shell_waits pane: the pane's shell is in front and waits at its prompt, where its line editor
# holds the terminal raw. One that runs a builtin or a loop of its own is in front too, but the
# terminal is cooked meanwhile; with ble.sh, sleep is such a builtin.
shell_waits() {
  local pid
  pid=$(herdr pane process-info --pane "$1" 2>/dev/null \
    | jq -er '.result.process_info | select(.shell_pid != null and .foreground_process_group_id == .shell_pid) | .shell_pid') || return 1
  raw_tty "/proc/$pid/fd/0"
}

# raw_tty tty: the terminal passes keys on one by one, as a line editor sets it (stty -icanon)
raw_tty() { [[ $(stty -F "$1" -a 2>/dev/null) =~ (^|[[:space:]])-icanon([[:space:]]|$) ]]; }

# ----------------------------------------------------------------- beads ----
# bd_json repo args...: bd's --json output for the args, read through the envelope bd 2.0 makes
# its default ({"data": ..., "schema_version": 1}), to which Factory opts in; that also keeps bd
# 1.x from printing its notice about the change. Output without one passes as it is.
bd_json() {
  local repo=$1
  shift
  BD_JSON_ENVELOPE=1 bd -C "$repo" "$@" --json | jq 'if type == "object" and has("schema_version") and has("data") then .data else . end'
}

# bd_one repo args...: bd_json for a command about one issue, which bd may give as an array of one
bd_one() { bd_json "$@" | jq 'if type == "array" then .[0] // empty else . end'; }

# bd_field repo id jq-expr
bd_field() {
  bd_one "$1" show "$2" 2>/dev/null | jq -r "$3"
}

# need_beads repo: the commands that touch tasks want a bd init first, and in a fresh clone of a
# repo that has one, its tasks: git brings .beads with bd's metadata.json but not the database,
# which bd where then names no path for, and bd bootstrap takes from origin
need_beads() {
  [[ -d $1/.beads ]] || die "no beads in $1; run: factory init $1"
  [[ ! -e $1/.beads/metadata.json ]] || bd_json "$1" where 2>/dev/null | jq -e '.database_path' >/dev/null \
    || die "no task database in $1 yet, as in a fresh clone; to take its tasks from origin, run: bd -C $1 bootstrap --yes"
}

# repo_top dir -> the top of the checkout the dir is in, the repo a command names
repo_top() { git -C "$1" rev-parse --show-toplevel 2>/dev/null || die "$1 is no git checkout"; }

# repo_of dir -> the repo's own checkout, its main worktree, for a dir in any of its worktrees,
# wherever its git dir is (a submodule's, --separate-git-dir)
repo_of() {
  local top
  top=$(git -C "$1" worktree list --porcelain) || return 1
  top=$(sed -n '1s/^worktree //p' <<<"$top")
  [[ -n $top ]] || return 1
  printf '%s' "$top"
}

# bd_note repo id text: a comment on the bead, tagged so it reads as Factory's in bd show
bd_note() { bd -C "$1" comment "$2" "Factory: $3" >/dev/null; }

# is_bead_id word: 0 when the word reads as a bead id: letters and digits on either side of one
# hyphen, and a child's numbers after dots (ab-x7k.1, as bd create --parent names it)
is_bead_id() { [[ $1 =~ ^[a-z][a-z0-9]*-[a-z0-9]+(\.[0-9]+)*$ ]]; }

# slugify text -> lowercase, dashes for anything else, at most 40 characters
slugify() {
  # C locale: only ASCII letters and digits survive, so branch names stay plain
  printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-40 | sed -E 's/-+$//'
}

# repo_prefix name -> a short bead prefix: the initials of a name of several words
# (AllesBuien ab, phoenix_live_demo pld), else a word's first and last character (Blik bk);
# leading digits are dropped (2048-game ge), and a name without a letter gives nothing
repo_prefix() {
  local w word p=""
  # words split at camel case (HTTPServer: http server) and at anything not a letter or digit
  read -ra w <<<"$(printf '%s' "$1" | LC_ALL=C sed -E 's/([A-Z]+)([A-Z][a-z])/\1 \2/g; s/([a-z0-9])([A-Z])/\1 \2/g; s/[^A-Za-z0-9]+/ /g; s/^[^A-Za-z]+//' | LC_ALL=C tr '[:upper:]' '[:lower:]')"
  if ((${#w[@]} > 1)); then
    for word in "${w[@]}"; do p+=${word:0:1}; done
  elif ((${#w[@]} == 1)); then
    p=${w[0]}
    ((${#p} <= 2)) || p=${p:0:1}${p: -1}
  fi
  [[ $p == [a-z]* ]] && printf '%s' "$p"
  return 0
}

# branch_of repo bead-id -> the task's existing branch (factory/<id> or factory/<id>-<slug>), or empty
branch_of() {
  git -C "$1" branch --list "factory/$2" "factory/$2-*" --format='%(refname:short)' | sed -n 1p # reads to the end, unlike head
}

# bead_of_branch branch -> the bead id in a factory branch name
bead_of_branch() { sed -E 's#^factory/([a-z][a-z0-9]*-[a-z0-9]+(\.[0-9]+)*).*#\1#' <<<"$1"; }

# bead_task repo bead-id: TASK_ID TASK_TITLE TASK_DESC from the bead
bead_task() {
  TASK_ID=$2
  TASK_TITLE=$(bd_field "$1" "$2" '.title')
  TASK_DESC=$(bd_field "$1" "$2" '.description // ""')
}

# resolve_task repo bead-id|title: the task from its bead, or a bead filed for a new title
resolve_task() {
  local repo=$1 arg=$2
  need_beads "$repo"
  if is_bead_id "$arg" && bd_json "$repo" show "$arg" >/dev/null 2>&1; then
    bead_task "$repo" "$arg"
  else
    TASK_ID=$(bd -C "$repo" create "$arg" --silent)
    TASK_TITLE=$arg
    TASK_DESC=""
    log "filed $TASK_ID: $arg"
  fi
}

# bd_push repo: push the beads database to its Dolt sync remote (refs/dolt/data on the
# git remote), so tasks, comments and memories survive this machine. Skips when no
# remote is configured; warns, never fails, when the push does not work.
bd_push() {
  ((FACTORY_BD_PUSH)) || return 0
  local remote out
  remote=$(bd -C "$1" config get sync.remote 2>/dev/null) || remote=""
  if [[ -z $remote || $remote == *"not set"* ]]; then
    log "beads: no sync remote configured, nothing pushed (bd dolt remote add origin git+<url>)"
    return 0
  fi
  if out=$(bd -C "$1" dolt push 2>&1); then
    log "beads pushed to $remote"
  else
    warn "beads push failed: $(tail -n1 <<<"$out")"
  fi
}

# memory_block repo -> text to append to prompts, empty if no memories
memory_block() {
  local mem
  mem=$(bd -C "$1" memories 2>/dev/null) || mem=""
  if [[ -z $mem ]] || grep -q 'No memories stored' <<<"$mem"; then return 0; fi
  printf '\nNotes from earlier work on this repo (bd memories; bd recall <key> for details):\n%s\n' "$mem"
}

# ------------------------------------------------------- gate and guards ----
# find_gate repo: the gate command, or 1 when the repo has none.
find_gate() {
  if [[ -n ${FACTORY_GATE:-} ]]; then
    printf '%s' "$FACTORY_GATE"
  elif [[ -f $1/.factory/gate ]]; then
    printf 'bash .factory/gate'
  else
    detect_gate "$1"
  fi
}

# resolve_gate repo
resolve_gate() {
  find_gate "$1" || die "no gate for $1: set FACTORY_GATE, or add .factory/gate (factory init writes one when it can)"
}

# detect_gate repo -> the command a repo's own convention suggests; 1 when there is none.
detect_gate() {
  local r=$1 t
  if [[ -x $r/bin/test ]]; then
    printf './bin/test'
    return 0
  fi
  if [[ -f $r/justfile ]] && grep -qE '^ci:' "$r/justfile"; then
    printf 'just ci'
    return 0
  fi
  if [[ -f $r/Makefile ]]; then
    for t in ci check test; do
      if grep -qE "^$t:" "$r/Makefile"; then
        printf 'make %s' "$t"
        return 0
      fi
    done
  fi
  if [[ -f $r/Cargo.toml ]]; then
    printf 'cargo fmt --all --check && cargo clippy --all-targets -- -D warnings && cargo test'
    return 0
  fi
  if [[ -f $r/package.json ]] && jq -e '.scripts.test' "$r/package.json" >/dev/null 2>&1; then
    printf 'npm test'
    return 0
  fi
  if [[ -f $r/pyproject.toml ]]; then
    printf 'python3 -m pytest -q'
    return 0
  fi
  if [[ -f $r/go.mod ]]; then
    printf 'go vet ./... && go test ./...'
    return 0
  fi
  if [[ -f $r/mix.exs ]]; then
    printf 'mix test'
    return 0
  fi
  if [[ -x $r/gradlew ]]; then
    printf './gradlew check'
    return 0
  fi
  if [[ -f $r/pom.xml ]]; then
    printf 'mvn -q verify'
    return 0
  fi
  return 1
}

# write_gate repo command: a committed script Factory runs as the definition of done.
write_gate() {
  mkdir -p "$1/.factory"
  cat >"$1/.factory/gate" <<G
#!/usr/bin/env bash
# Factory's definition of done. Detected by factory init; make it as strict as you like.
set -euo pipefail
$2
G
  chmod +x "$1/.factory/gate"
}

# guardrails_file worktree -> the repo's own .factory/guardrails.txt if present, else Factory's
guardrails_file() {
  if [[ -f $1/.factory/guardrails.txt ]]; then printf '%s' "$1/.factory/guardrails.txt"; else printf '%s' "$GUARDRAILS"; fi
}

# factory_globs -> Factory's own protected pathspecs, one a line: all of .factory/ but its run dir
factory_globs() { printf '%s\n' .factory ":(exclude)$RUN_DIR"; }

# protected_globs worktree -> one pathspec per line: Factory's own (factory_globs), then the lines
# of the .factory/protected there. The checks read Factory's own in a git call of their own as
# well: an exclude line there would take .factory/, the change to that file included, out of
# the call they share.
protected_globs() {
  factory_globs
  [[ -f $1/.factory/protected ]] && grep -vE '^\s*(#|$)' "$1/.factory/protected"
  return 0
}

# run_gate worktree gate logfile: 0 when the gate passes. It runs in the foreground, so that
# Ctrl-C stops it with the run (bash would have a background job ignore it), and a heartbeat
# beside it logs every five minutes, as a cold build can be silent for a long time. The run is
# recorded (gate), labelled as its log is named: gate-1.log is round 1's.
run_gate() {
  local beat rc=0 t0=$SECONDS label=${3##*/gate-}
  log "gate: $2"
  (
    m=0
    while sleep 300 && kill -0 "$$" 2>/dev/null; do
      m=$((m + 5))
      log "gate still running ($m min, log: $3)"
    done
  ) &
  beat=$!
  (cd "$1" && bash -c "$2") >"$3" 2>&1 || rc=$?
  kill "$beat" 2>/dev/null || warn "the gate's heartbeat had stopped"
  metric gate label "${label%.log}" ok $((rc == 0)) secs $((SECONDS - t0))
  if ((rc == 0)); then
    log "gate passed"
    return 0
  fi
  warn "gate failed, log: $3"
  return 1
}

# kept_out worktree: pathspecs for what may lie in the worktree outside git: the run directory,
# which is Factory's, and in a repo's main working tree, where no agent works, the human's own
# .factory/env
kept_out() {
  printf '%s\n' ":(exclude)$RUN_DIR"
  if [[ $(git -C "$1" rev-parse --absolute-git-dir) == "$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)" ]]; then
    printf '%s\n' ':(exclude).factory/env'
  fi
}

# tree_state worktree -> git's status line for each file changed or added, the gate, the rules
# and the rest of .factory/ included, but for what kept_out leaves out. Git compares the files
# with HEAD through an index of its own, with the settings that could hide a change at their
# defaults: the worktree's index and git config, which an agent can write, can mark a file
# unchanged (assume-unchanged, skip-worktree, sparse patterns), have an fsmonitor hook or a lax
# core.checkStat report no change, or leave out a submodule, a name that differs in case, an
# executable bit (core.fileMode) or a symlink made a file (core.symlinks). Git's conversions
# (core.autocrlf, a filter) stay as the repo sets them: a checkout they convert reads unchanged.
tree_state() {
  local kept dir out
  # an index of its own
  local -x GIT_INDEX_FILE
  mapfile -t kept < <(kept_out "$1")
  dir=$(mktemp -d)
  GIT_INDEX_FILE=$dir/index
  if git -C "$1" read-tree HEAD; then
    out=$(git -C "$1" -c core.fsmonitor=false -c core.ignoreCase=false -c core.fileMode=true -c core.symlinks=true \
      status --porcelain --untracked-files=all --ignore-submodules=none \
      -- . "${kept[@]}") || out="git status failed"
  else
    out="no HEAD to compare with"
  fi
  rm -rf "$dir"
  printf '%s' "$out"
}

# tree_dirty worktree: 0 when tree_state lists a file
tree_dirty() { [[ -n $(tree_state "$1") ]]; }

# task_state dir bead-id -> Factory's own directory for the task, in the user's state dir:
# what only Factory and the human decide is kept there, out of the worktree and its run dir,
# which the agents write.
task_state() {
  local repo
  repo=$(repo_state "$1") || return 1
  printf '%s/%s' "$repo" "$2"
}

# repo_state dir -> Factory's directory for the tasks of the repo that dir belongs to. The
# repo is named by its git dir, which any dir in any of its worktrees names alike, wherever
# that is: a bare repo's beside its worktrees, a submodule's.
repo_state() {
  local common name
  common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  common=$(cd "$common" && pwd -P) || return 1
  name=${common%/.git}
  name=${name##*/}
  if [[ $name == .* ]]; then # app/.bare, say
    name=${common%/*}
    name=${name##*/}
  fi
  printf '%s/factory/tasks/%s-%s' "${XDG_STATE_HOME:-$HOME/.local/state}" "${name%.git}" \
    "$(printf '%s' "$common" | sha256sum | cut -c1-12)"
}

# waive_protected task-state-dir: the human allows the protected paths the plan names, which
# the run reads from the plan as it takes the approval (allow_named)
waive_protected() { mkdir -p "$1" && : >"$1/allow-protected"; }

# waived: 0 when the human allowed protected paths for the task at the plan's approval (p, the
# dialog's choice, fy approve --allow-protected), which Factory keeps in its own state
waived() { [[ -n ${TASK_STATE:-} && -e $TASK_STATE/allow-protected ]]; }

# allow_named plan-file: the protected paths the human allowed, the ones the plan names as the
# run takes its approval, into Factory's state for the task, a path a line
allow_named() {
  protected_named "$1" >"$TASK_STATE/allow-protected"
  log "protected paths allowed for this task: $(allowed_paths)"
}

# allowed path: 0 when the human allowed path at the plan's approval: the plan named it, or a
# directory it is under
allowed() {
  local p paths
  waived || return 1
  mapfile -t paths <"$TASK_STATE/allow-protected"
  for p in "${paths[@]}"; do
    [[ -n $p && ($1 == "$p" || $1 == "$p"/*) ]] && return 0
  done
  return 1
}

# allowed_paths -> the protected paths the human allowed, comma-separated, or none
allowed_paths() {
  if waived; then listed <"$TASK_STATE/allow-protected"; else printf none; fi
}

# listed -> the lines on stdin, comma-separated, or none for none
listed() {
  local p list=""
  while IFS= read -r p || [[ -n $p ]]; do
    [[ -z $p ]] || list+=${list:+, }$p
  done
  printf '%s' "${list:-none}"
}

# guard_check worktree base [check...]: mechanical guardrails on the branch, one check after the
# other. Prints violations, and sets GUARD_FAILED to the checks that found them. Git lists the
# paths NUL-terminated (-z), as it stores them: a name it would quote, such as one with a
# non-ASCII character, would match no check, and :(literal) keeps a name from being read as
# a pathspec.
guard_check() {
  local wt=$1 base=$2 bad=0 check dir
  # every check reads base...HEAD or HEAD, in the helpers too; and what is tracked from an
  # index read from HEAD, the branch's: the worktree's own, which an agent can write, would
  # take a file staged there (git add -f) for a tracked one
  local -x GIT_INDEX_FILE
  dir=$(mktemp -d)
  GIT_INDEX_FILE=$dir/index
  # without a commit, guard_commits says so
  git -C "$wt" read-tree HEAD 2>/dev/null || rm -f "$GIT_INDEX_FILE"
  GUARD_FAILED=""
  local checks=("${@:3}") # the guard_* checks named, else all of them
  ((${#checks[@]})) || checks=(top clean commits readable artifacts tests protected run_dir ignored symlinks lines)
  for check in "${checks[@]}"; do
    if ! "guard_$check" "$wt" "$base"; then
      bad=1
      GUARD_FAILED+="${GUARD_FAILED:+ }$check"
    fi
  done
  rm -rf "$dir"
  return $bad
}

# guard_top worktree: git -C reads the worktree's own config, which an agent can write:
# core.worktree there points every git call of the checks at another checkout than the gate's
guard_top() {
  local top
  top=$(git -C "$1" rev-parse --show-toplevel)
  [[ $top != "$(cd "$1" && pwd -P)" ]] || return 0
  printf 'git reads the work tree at %s, not %s: name the top of a checkout, with no core.worktree in its git config\n' "$top" "$1"
  return 1
}

# guard_clean worktree: nothing uncommitted, by tree_state
guard_clean() {
  local dirty
  dirty=$(tree_state "$1")
  [[ -n $dirty ]] || return 0
  printf 'uncommitted changes in the worktree; commit your work (ignore build artifacts, do not commit them)\n'
  # the tracked files, by name: git's own status, through the worktree's index and git config,
  # may show none of them
  sed '/^?? /d' <<<"$dirty"
  return 1
}

# guard_commits worktree base: the branch has commits of its own
guard_commits() {
  [[ $(git -C "$1" rev-list --count "$2..HEAD") -eq 0 ]] || return 0
  printf 'no commits on the branch since %s\n' "$2"
  return 1
}

# guard_readable worktree base: git can read the branch's diff, which every other check
# reads: where git cannot, they would read nothing and pass. A line in .git/shallow, which an
# agent can write, cuts the branch off from the base, so that base...HEAD has no merge base,
# and an object gone from the repository fails the diff of a file while the worktree matches.
guard_readable() {
  local err
  err=$(guard_diff "$1" --no-renames -U0 "$2...HEAD" 2>&1 >/dev/null) && return 0
  printf "git cannot read the branch's diff against %s, so no check here could read it: %s\n" "$2" "$(head -n 3 <<<"$err" | paste -sd ' ')"
  return 1
}

# guard_artifacts worktree base: no build artifact added. --no-renames, as in the symlink
# check: git pairs an added artifact with a deleted file of like content as a
# rename (R), which --diff-filter=A leaves out, so a committed build/out.o git read as renamed
# from a data file would pass unflagged.
guard_artifacts() {
  local f bad=0
  while IFS= read -r -d '' f; do
    printf 'build artifact committed: %s\n' "$f"
    bad=1
  done < <(guard_diff "$1" --name-only -z --no-renames --diff-filter=A "$2...HEAD" | LC_ALL=C grep -zE '(^|/)(__pycache__/|node_modules/|\.DS_Store$|.*\.pyc$|.*\.class$|.*\.o$)')
  return $bad
}

# guard_tests worktree base: with FACTORY_REQUIRE_TESTS, a change to code comes with a test
guard_tests() {
  ((FACTORY_REQUIRE_TESTS)) || return 0
  tests_changed_with_source "$1" "$2" && return 0
  printf 'source files changed but no test files did; add or adjust a test\n'
  return 1
}

# guard_protected worktree base: no protected path changed but those the human allowed at the
# plan's approval. Git reads each glob as a pathspec. One it cannot read fails every git call
# that names the globs, and the check would then read no path and pass. A renamed path counts
# under both of its names (--no-renames), the one it leaves too. Factory's own globs are read
# in a diff of their own as well (protected_globs).
guard_protected() {
  local f err globs own bad=0
  mapfile -t globs < <(protected_globs "$1")
  mapfile -t own < <(factory_globs)
  if ! err=$(git -C "$1" ls-files -- "${globs[@]}" 2>&1 >/dev/null); then
    printf 'protected paths unchecked: %s (fix that line of .factory/protected)\n' "${err#fatal: }"
    return 1
  fi
  waived && log "guardrails: protected paths the human allowed: $(allowed_paths)"
  while IFS= read -r -d '' f; do
    allowed "$f" && continue
    if waived; then
      printf 'protected path changed: %s (the human allowed only those the plan named: %s)\n' "$f" "$(allowed_paths)"
    else
      printf 'protected path changed: %s\n' "$f"
    fi
    bad=1
  done < <({
    guard_diff "$1" --name-only -z --no-renames "$2...HEAD" -- "${globs[@]}"
    guard_diff "$1" --name-only -z --no-renames "$2...HEAD" -- "${own[@]}"
  } | LC_ALL=C sort -zu)
  return $bad
}

# guard_run_dir worktree base: the run dir is Factory's, out of the branch. A file committed
# there with git add -f would be in no check's view, as the protected paths and the patterns
# leave the run dir out.
guard_run_dir() {
  local f bad=0
  while IFS= read -r -d '' f; do
    printf "file committed in Factory's run dir: %s (no part of the branch; git rm --cached it)\n" "$f"
    bad=1
  done < <(guard_diff "$1" --name-only -z "$2...HEAD" -- "$RUN_DIR")
  return $bad
}

# guard_ignored worktree: no ignored file at a protected path. A protected path is one that
# steers the gate, and git leaves an ignored file there out of the branch and its diff, so the
# waiver, which is for those, has no say.
guard_ignored() {
  local f globs own kept bad=0
  mapfile -t globs < <(protected_globs "$1")
  mapfile -t own < <(factory_globs)
  mapfile -t kept < <(kept_out "$1")
  while IFS= read -r -d '' f; do
    printf 'ignored file at a protected path: %s (read in this worktree, left out of the branch; remove it, or narrow the line of .factory/protected that names it)\n' "$f"
    bad=1
  done < <({
    git -C "$1" ls-files --others --ignored --exclude-standard -z -- "${globs[@]}" "${kept[@]}"
    git -C "$1" ls-files --others --ignored --exclude-standard -z -- "${own[@]}" "${kept[@]}"
  } | LC_ALL=C sort -zu)
  return $bad
}

# guard_symlinks worktree base: a symlink the branch adds, renames (--no-renames) or points
# elsewhere must lead to a place the branch holds. HEAD:path names what is there: a file
# (blob), a directory (tree; HEAD: with no path names the top), a submodule's commit, or
# nothing, as out of the worktree, in .git or at an untracked path. Anywhere but at a file or
# a directory, the gate would read what no diff shows, waiver or not; to a directory, it gives
# the files there paths that no protected glob names, so it passes only as a path the plan
# names and the human allowed.
guard_symlinks() {
  local f p kind bad=0
  while IFS= read -r -d '' f; do
    [[ -L $1/$f ]] || continue
    kind=none
    if p=$(realpath -m --relative-to="$1" "$1/$f"); then
      [[ $p != . ]] || p="" # the top
      kind=$(git -C "$1" cat-file -t "HEAD:$p" 2>/dev/null) || kind=none
    fi
    if [[ $kind != blob && $kind != tree ]]; then
      printf 'symlink to a place the branch does not hold: %s -> %s (the gate would read what no diff shows; point it at a tracked file, or remove it)\n' "$f" "$(readlink "$1/$f")"
      bad=1
    elif [[ $kind == tree ]] && ! allowed "$f"; then
      printf "symlink to a directory: %s -> %s (the paths under it escape the protected globs; remove it, or have the plan name it and the human allow protected paths at its approval)\n" "$f" "$(readlink "$1/$f")"
      bad=1
    fi
  done < <(guard_diff "$1" --name-only -z --no-renames --diff-filter=AMT "$2...HEAD")
  return $bad
}

# guard_lines worktree base: no line the branch adds matches a forbidden pattern; a file git
# takes for binary data, such as an image, has none
guard_lines() {
  local f st old rules patterns lines err p n hits=0 rc=0 bad=0
  rules=$(guardrails_file "$1")
  patterns=$(mktemp)
  lines=$(mktemp)
  if ! sed -E '/^\s*(#|$)/d' "$rules" >"$patterns"; then # no pattern read, none matches
    printf 'forbidden patterns unread: %s cannot be read\n' "$rules"
    bad=1
  fi
  # A pattern grep cannot read fails every grep below, which reads as no match: the check
  # would pass whatever the branch adds. Each line alone then names the ones at fault, in the
  # same words on every call (work_state compares them), where grep's name a temporary file.
  err=$(grep -E -f "$patterns" /dev/null 2>&1) || rc=$?
  if ((rc > 1)); then
    printf 'forbidden patterns unreadable in %s:\n' "$rules"
    n=0
    while IFS= read -r p || [[ -n $p ]]; do
      n=$((n + 1)) rc=0
      [[ $p =~ ^[[:space:]]*(#|$) ]] || err=$(grep -E -e "$p" /dev/null 2>&1) || rc=$?
      ((rc < 2)) || printf '  line %s: %s (%s)\n' "$n" "$p" "${err#grep: }"
    done <"$rules"
    : >"$patterns" # none to match below, where each grep would print its error once more
    bad=1
  fi
  # A rename (R) lists its old path, then its new one: given both, git pairs them and shows
  # only what changed, where the new path alone would read as all added. A copy's (C) lines
  # count as added.
  while IFS= read -r -d '' st && IFS= read -r -d '' f; do
    old=""
    if [[ $st == [RC]* ]]; then
      [[ $st == C* ]] || old=$f
      IFS= read -r -d '' f
    fi
    added_lines "$1" "$2" "$f" ${old:+"$old"} >"$lines"
    if grep -a -E -f "$patterns" "$lines" | label "$f"; then
      hits=1
    fi
  done < <(guard_diff "$1" --name-status -z "$2...HEAD" -- . ':(exclude).factory')
  rm -f "$patterns" "$lines"
  if ((hits)); then
    printf 'the lines above match a forbidden pattern (see %s)\n' "$rules"
    bad=1
  fi
  return $bad
}

# guard_diff worktree [git diff args]: git diff in the worktree as git itself writes it,
# whatever the git config and attributes say, your own global one too: no colour codes,
# external diff tool or textconv filter; renames found, as by git's default (diff.renames),
# where the args do not say --no-renames; and a submodule as the one line that names its
# commit, never left out (diff.submodule, diff.ignoreSubmodules).
guard_diff() {
  git -C "$1" diff --no-color --no-ext-diff --no-textconv -M --submodule=short --ignore-submodules=none "${@:2}"
}

# added_lines worktree base path [old-path]: the lines the branch adds to path, renamed from
# old-path if given, each with diff's + still on it, as a repo's rules may anchor on it (^\+).
# Above a hunk's @@ line are the file headers, +++ among them; below it, each line that begins
# with a + is an added line, whatever comes after the +.
added_lines() {
  guard_diff "$1" -U0 "$2...HEAD" -- ":(literal)$3" ${4:+":(literal)$4"} | sed -n '/^@@/,/^diff /{/^+/p;}'
}

# label path: each added line on stdin after the path it comes from, without diff's +
label() {
  local line
  while IFS= read -r line; do printf '%s: %s\n' "$1" "${line#+}"; done
}

# tests_changed_with_source worktree base: true unless code changed and no test file did.
# The names are matched as the bytes git keeps (LC_ALL=C), whatever their encoding. Rust keeps
# unit tests in the file they test (#[cfg(test)]): a test or an assertion added to a .rs file
# counts as a test changed, and a renamed one's lines count only where it changed (guard_lines).
# A deleted test file is no test changed, nor a deleted code file a change of code, and a file
# moved unchanged is neither. Unchanged is the same blob, by the ids git's raw diff gives after
# the modes: a rename's R100 says only that the lines are the same, in whatever order.
tests_changed_with_source() {
  local LC_ALL=C meta was is st f old i code=0 lines rust=() olds=()
  local code_re='\.(py|js|jsx|ts|tsx|go|rs|java|kt|kts|scala|sh|bash|rb|ex|exs|c|cc|cpp|h|hpp|cs|swift|php|lua|clj|el)$'
  while IFS= read -r -d '' meta && IFS= read -r -d '' f; do
    read -r _ _ was is st <<<"$meta"
    old=""
    if [[ $st == [RC]* ]]; then
      [[ $st == C* ]] || old=$f
      IFS= read -r -d '' f
    fi
    [[ $st == R* && $was == "$is" ]] && continue
    [[ $f =~ $TEST_PATH_RE ]] && return 0
    if [[ $f == *.rs ]]; then
      rust+=("$f")
      olds+=("$old")
    fi
    [[ $f =~ $code_re ]] && code=1
  done < <(guard_diff "$1" --raw -z --no-abbrev --diff-filter=d "$2...HEAD" -- . ':(exclude).factory')
  for i in "${!rust[@]}"; do
    lines=$(added_lines "$1" "$2" "${rust[i]}" ${olds[i]:+"${olds[i]}"})
    grep -qE '#\[([a-z_]+::)?test\]|#\[cfg\(test\)\]|assert(_eq|_ne)?!' <<<"$lines" && return 0
  done
  return "$code"
}

# verdict_of review-file -> APPROVE | REVISE | (empty)
verdict_of() {
  grep -oE '^VERDICT:\s*(APPROVE|REVISE)' "$1" 2>/dev/null | tail -n1 | grep -oE 'APPROVE|REVISE'
}

# verdicts files... -> one word per file, NONE when missing
verdicts() {
  local f v out=""
  for f in "$@"; do
    v=$(verdict_of "$f") || v=NONE
    out+="${out:+ }$v"
  done
  printf '%s' "$out"
}

# recorded name -> Factory's record of that name for the task, in its state dir; empty if none
recorded() { [[ ! -s $TASK_STATE/$1 ]] || printf '%s' "$(<"$TASK_STATE/$1")"; }

# own_worktree: refuse to go on unless git, run in the worktree, reads the task repo's own git
# dir, through a worktree that repo lists. Git finds the repository through the worktree's .git
# file, which an agent can rewrite to name another clone: every check would then read that
# clone's refs, history and HEAD. The repo lists a worktree in its worktrees/<name>/gitdir,
# which names the worktree's .git file, relative to it with worktree.useRelativePaths; its main
# worktree is the repo itself.
own_worktree() {
  local common dir listed=""
  common=$(git -C "$TASK_REPO" rev-parse --path-format=absolute --git-common-dir) || die "$TASK_REPO is no git checkout"
  [[ $(git -C "$WT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) -ef $common ]] \
    || die "git in $WT reads another repository than $TASK_REPO, as its .git file names another: refusing to gate, guard or push it (git worktree repair $WT, run in $TASK_REPO, points it back)"
  dir=$(git -C "$WT" rev-parse --absolute-git-dir 2>/dev/null) || dir=""
  if [[ -f $dir/gitdir ]]; then
    listed=$(<"$dir/gitdir")
    [[ $listed == /* ]] || listed=$dir/$listed
  fi
  [[ ${dir%/*} -ef $common/worktrees && -n $listed && $listed -ef $WT/.git ]] \
    || [[ $dir -ef $common && $WT -ef $TASK_REPO ]] \
    || die "$WT is no worktree that $TASK_REPO lists: refusing to gate, guard or push it (git worktree repair $WT, run in $TASK_REPO, lists it again)"
}

# task_head: own_worktree, with HEAD at the tip of the task's branch; HEAD_SHA is that commit.
# The gate and the guardrails check the commit checked out, and Factory pushes the branch: on
# another commit, the worktree would have them pass one commit while the push sends others.
task_head() {
  local tip
  own_worktree
  HEAD_SHA=$(git -C "$WT" rev-parse --verify -q HEAD) || HEAD_SHA=""
  tip=$(git -C "$WT" rev-parse --verify -q "refs/heads/$BRANCH") || tip=""
  [[ -n $HEAD_SHA && $HEAD_SHA == "$tip" ]] \
    || die "$WT is at ${HEAD_SHA:-no commit}, not at the tip of $BRANCH (${tip:-none}), which Factory gates, guards and pushes: check out $BRANCH there"
}

# base_ref: the ref the branch forks from: the local base branch or origin's tracking ref,
# whichever the branch forked from latest, origin's on a tie. Origin's after the rebase for a
# pull request, also once origin has moved on again (a stale local base would blame the branch
# for what the upstream added); the local one while it carries commits origin does not, or
# without an origin. Full names: a tag or a branch named origin/<base> would be read as either.
base_ref() {
  local ref best="refs/heads/$BASE" fork last=""
  for ref in "refs/heads/$BASE" "refs/remotes/origin/$BASE"; do
    fork=$(git -C "$WT" merge-base "$ref" HEAD 2>/dev/null) || continue
    if [[ -z $last ]] || git -C "$WT" merge-base --is-ancestor "$last" "$fork"; then
      best=$ref last=$fork
    fi
  done
  printf '%s' "$best"
}

# recorded_base_branch -> the branch the task's recorded base was read from: refs/heads/<branch>
# and a remote's refs/remotes/<remote>/<branch> alike name <branch>. So does
# refs/factory/<id>/upstream/<branch>, where an earlier Factory kept its own fetch of origin's
# base for a task: a task it started may record its base there; that line can go once none does.
recorded_base_branch() {
  local ref
  read -r _ ref 2>/dev/null <"$TASK_STATE/base" || return 1
  [[ -n $ref ]] || return 1
  ref=${ref#refs/heads/}
  [[ $ref != refs/remotes/* ]] || ref=${ref#refs/remotes/*/}
  [[ $ref != refs/factory/* ]] || ref=${ref#refs/factory/*/upstream/}
  printf '%s' "$ref"
}

# record_base: the commit the branch is measured from, with the ref it was read from, kept in
# Factory's state once, as Factory takes up the task's worktree: where the branch forks off the
# base ref (base_ref). Only Factory moves it on: as it rebases the branch onto origin's base
# (rebase_onto_base), or as the branch took in newer commits of it that origin holds
# (guard_branch); a ref rewritten since stops the run (task_base). What the gate and the
# guardrails passed on was measured from the base before, so a base taken anew voids it.
record_base() {
  local ref sha
  if [[ ! -s $TASK_STATE/base ]]; then
    task_head
    ref=$(git -C "$WT" rev-parse --symbolic-full-name "$(base_ref)") || die "no base ref $BASE for $BRANCH"
    sha=$(git -C "$WT" merge-base "$ref" HEAD) || die "$BRANCH has no fork point from $ref to be measured from"
    mkdir -p "$TASK_STATE"
    printf '%s %s\n' "$sha" "$ref" >"$TASK_STATE/base"
    rm -f "$TASK_STATE/gated" "$TASK_STATE/gate-pass" "$TASK_STATE/guarded"
  fi
}

# start_from_origin: a task taken up anew starts from origin's copy of its base where yours is
# only behind it, as when you have not pulled what was merged there since: the planner would
# plan on code the branch lacks, and the builder could not build on it. A base with commits
# origin lacks stays the task's, as does one Factory cannot fetch (fetch_base).
start_from_origin() {
  local tip n
  [[ ! -s $TASK_STATE/base ]] || return 0 # a task under way keeps its base
  git -C "$WT" remote get-url origin >/dev/null 2>&1 || return 0
  if ! tip=$(fetch_base); then
    warn "could not fetch origin's $BASE; $TASK_ID starts from yours"
    return 0
  fi
  git -C "$WT" merge-base --is-ancestor HEAD "$tip" || return 0 # yours has commits origin lacks
  n=$(git -C "$WT" rev-list --count "HEAD..$tip")
  ((n)) || return 0
  if ! git -C "$WT" merge -q --ff-only "$tip"; then
    warn "could not move $BRANCH on to origin's $BASE; $TASK_ID starts from yours"
    return 0
  fi
  log "$TASK_ID starts from origin's $BASE, $n commit(s) past yours"
}

# task_base -> the recorded base commit, while its ref still holds it. A ref that no longer does
# was moved by another hand than Factory's, as when your main is rewritten: that fails loudly.
task_base() {
  local sha ref
  read -r sha ref 2>/dev/null <"$TASK_STATE/base" || die "no base commit recorded for $TASK_ID in $TASK_STATE"
  git -C "$WT" merge-base --is-ancestor "$sha" "$ref" 2>/dev/null \
    || die "$ref no longer holds $sha, the commit $BRANCH is measured from: it was rewritten since, by you, by a force-push to origin's $BASE that a fetch brought, or by an agent; look at it before you go on, and if that is as it should be, remove $TASK_STATE/base for a rerun to measure the branch from where it forks off then"
  printf '%s' "$sha"
}

# fetch_base -> origin's tip of the base branch, fetched from origin by its full name into
# origin's tracking ref, which base_ref reads, as may a gate that diffs against it. It is not
# followed where an agent made it a symbolic ref (--no-deref), which would move the ref it
# names, your main say. The commit is the one the fetch wrote to FETCH_HEAD, whatever the
# remote's fetch config says.
fetch_base() {
  local tip
  GIT_TERMINAL_PROMPT=0 git -C "$WT" fetch -q --no-tags --write-fetch-head origin "refs/heads/$BASE" || return 1
  tip=$(git -C "$WT" rev-parse --verify -q 'FETCH_HEAD^{commit}') || return 1
  git -C "$WT" update-ref --no-deref -m "factory: fetched origin's $BASE" "refs/remotes/origin/$BASE" "$tip" || return 1
  printf '%s' "$tip"
}

# took_in base -> where the branch forks off its base ref (base_ref), when that is newer than
# base: a merge of the base branch, or a fast-forward to it, brought in commits that are not
# the branch's own, origin's or yours on main, as when the builder merges a fix of yours you
# have not pushed. Read from the refs as they stand: origin's may be out of reach meanwhile.
took_in() {
  local fork
  fork=$(git -C "$WT" merge-base "$(base_ref)" HEAD) || return 1
  [[ $fork != "$1" ]] || return 1
  git -C "$WT" merge-base --is-ancestor "$1" "$fork" || return 1
  printf '%s' "$fork"
}

# measured_base -> the commit the branch is measured from now: the newer one it took in
# (took_in), else the recorded one (task_base)
measured_base() {
  local base
  base=$(task_base) || exit 1
  took_in "$base" || printf '%s' "$base"
}

# gate_branch logfile: the gate on the tip of the task's branch, in its own worktree
# (task_head). The commit it passes on is recorded, for the guardrails (guard_branch). A pass
# with nothing changed or added in the worktree (tree_state), nor an ignored file at a
# protected path (guard_ignored), which git status shows not, is recorded with its log and the
# command as well (gate-pass): while the tip is that commit, the worktree stays so and the
# command the same, as on a rerun, the gate is not run again, which can take most of an hour,
# and the round's log names the pass's. A pass beside such a file, a local config that relaxes
# the lint say, proves nothing about the commit alone, also once the file is gone. Each run
# voids the record first, so that it names the latest run's log, which no later run has
# written over.
gate_branch() {
  local sha dirty ignored pass was label=${1##*/gate-}
  task_head
  sha=$HEAD_SHA
  dirty=$(tree_state "$WT")
  if ! ignored=$(guard_check "$WT" "$sha" ignored); then dirty+=$ignored; fi
  pass=$(recorded gate-pass) # "<commit> <log>", then the command
  was=${pass%%$'\n'*}
  if [[ -z $dirty && $was == "$sha "* && ${pass#*$'\n'} == "$GATE" ]]; then
    was=${was#* }
    log "gate: it passed on ${sha:0:7} already, with nothing else changed; not run again"
    [[ $was -ef $1 ]] || printf 'The gate passed on %s already, with nothing else changed, and was not run again; its log is %s\n' "$sha" "${was#"$WT/"}" >"$1"
    metric gate label "${label%.log}" skipped 1
    return 0
  fi
  rm -f "$TASK_STATE/gate-pass"
  run_gate "$WT" "$GATE" "$1" || return 1
  task_head
  [[ $HEAD_SHA == "$sha" ]] || die "$BRANCH moved from $sha to $HEAD_SHA while the gate ran; rerun to check the new tip"
  mkdir -p "$TASK_STATE"
  printf '%s\n' "$sha" >"$TASK_STATE/gated"
  [[ -n $dirty ]] || printf '%s %s\n%s\n' "$sha" "$1" "$GATE" >"$TASK_STATE/gate-pass"
}

# guard_branch: the guardrails on the commit the gate passed on, the tip of the task's branch
# in its own worktree, measured from the recorded base, or from the newer one the branch took
# in (took_in). The newer one is recorded as the base once origin's tracking ref holds it; one
# only your base branch holds, as a fix of yours not pushed yet, is read anew on each check,
# and so is any in a repo without an origin: you may still rewrite it (git pull --rebase),
# where a recorded base its ref no longer holds would stop the run (task_base). The commit they
# pass on is recorded as the one a push may send (push_gated). Prints the violations, and sets
# GUARD_FAILED to the checks that failed (guard_check), or to ungated. The outcome is recorded
# (guard), with them.
guard_branch() {
  local base newer
  task_head
  if [[ $HEAD_SHA != "$(recorded gated)" ]]; then
    printf 'the gate has not passed on %s, the tip of %s (it passed on %s)\n' "$HEAD_SHA" "$BRANCH" "$(recorded gated)"
    GUARD_FAILED=ungated
    metric guard ok 0 failed "$GUARD_FAILED"
    return 1
  fi
  base=$(task_base) || exit 1
  if newer=$(took_in "$base"); then
    log "$BRANCH took in newer commits of $BASE; measuring it from $newer, the newest of them"
    if git -C "$WT" merge-base --is-ancestor "$newer" "refs/remotes/origin/$BASE" 2>/dev/null; then
      printf '%s %s\n' "$newer" "refs/remotes/origin/$BASE" >"$TASK_STATE/base"
    fi
    base=$newer
  fi
  if ! guard_check "$WT" "$base"; then
    metric guard ok 0 failed "$GUARD_FAILED"
    return 1
  fi
  metric guard ok 1
  printf '%s\n' "$HEAD_SHA" >"$TASK_STATE/guarded"
}

# guarded: 0 when the gate and the guardrails passed on the tip of the task's branch
guarded() {
  task_head
  [[ $HEAD_SHA == "$(recorded guarded)" ]]
}

# work_state -> the commit checked out in the task's worktree, git's status line for each file
# changed there (tree_state), and what the guardrails find, which also reads what git status
# shows not, an ignored file: as a turn that changed nothing they check leaves it. A file
# already changed and edited again keeps its line.
work_state() {
  git -C "$WT" rev-parse --verify -q HEAD
  tree_state "$WT"
  [[ -s $TASK_STATE/base ]] || return 0 # no base recorded yet, nothing to read the branch from
  guard_check "$WT" "$(task_base)" 2>/dev/null || printf 'guardrails failed: %s\n' "$GUARD_FAILED"
}

# push_gated git-push-options...: push the commit the gate and the guardrails passed on, by its
# id, as the task's branch on origin, while the branch's tip is that commit: by name, git would
# push whatever the branch has come to by then. The commit pushed is recorded.
push_gated() {
  local checked
  checked=$(recorded guarded)
  guarded || die "$BRANCH is at $HEAD_SHA, but the gate and the guardrails passed on ${checked:-none}: refusing to push what they have not passed; rerun, or factory pr, to check it"
  git -C "$WT" push "$@" origin "$checked:refs/heads/$BRANCH" || return 1
  printf '%s\n' "$checked" >"$TASK_STATE/pushed"
}

# gate_then_guards builder-agent label: gate with one fix round, then guardrails. 1 on failure.
gate_then_guards() {
  local agent=$1 gate_log="$WT/$RUN_DIR/gate-$2.log"
  if ! gate_branch "$gate_log"; then
    ask "$agent" "$(gate_fix_prompt "$gate_log")"
    gate_branch "$gate_log" || return 1
  fi
  local violations
  if ! violations=$(guard_branch); then
    warn "guardrails failed after $2:"
    printf '%s\n' "$violations" >&2
    return 1
  fi
}

# regate builder-agent label: the tip of the branch is not what the gate and the guardrails
# passed on, as after a rebase or a commit by hand; they must pass on it before a push.
regate() { gate_then_guards "$1" "$2" || die "gate or guardrails fail on the tip of $BRANCH (above; the gate's log is in $WT/$RUN_DIR): fix them there, then factory pr $TASK_REPO $TASK_ID"; }

# -------------------------------------------------------------------- pr ----
# rebase_in_progress worktree: 0 while a rebase is under way there
rebase_in_progress() {
  [[ -d $(git -C "$1" rev-parse --path-format=absolute --git-path rebase-merge) ||
  -d $(git -C "$1" rev-parse --path-format=absolute --git-path rebase-apply) ]]
}

# rebase_onto_base builder-agent: rebase the branch onto origin's base before a PR, as Factory
# fetched it (fetch_base), never onto a local ref. The commit it was rebased onto is the one it
# is measured from then (task_base), and the gate and the guardrails must pass on the rebased
# tip (guarded). Origin's base must hold the commit the branch was measured from: one that only
# a local ref held, an agent's say, would go into the pull request unchecked.
rebase_onto_base() {
  local agent=$1 files onto base err
  # a base moved by another hand fails here, before the branch moves onto it; a newer one the
  # branch took in, a fix of yours on main say, origin must hold as well
  base=$(measured_base) || exit 1
  onto=$(fetch_base) || die "could not fetch $BASE from origin to bring $BRANCH up to date with it"
  git -C "$WT" merge-base --is-ancestor "$base" "$onto" \
    || die "origin's $BASE, at $onto, does not hold $base, the commit $BRANCH is measured from: the pull request would carry commits that origin never had and that no check read as the branch's, such as ones on your $BASE you have not pushed, or an agent's. Push or drop them, or look at $base; if it is wrong, remove $TASK_STATE/base for a rerun to measure the branch from where it forks off then"
  if git -C "$WT" merge-base --is-ancestor "$onto" HEAD; then
    return 0
  fi
  log "rebasing $BRANCH onto origin's $BASE"
  # A conflict rerere resolves as it was resolved before stays unmerged, for the builder to
  # check: staged (rerere.autoUpdate), it would leave no file to name, as a failure of another
  # kind does.
  if ! err=$(git -C "$WT" rebase -q --no-rerere-autoupdate "$onto" 2>&1); then
    files=$(git -C "$WT" diff --name-only --diff-filter=U | paste -sd' ')
    [[ -n $files ]] || die "could not rebase $BRANCH onto origin's $BASE in $WT: $err$(rebase_in_progress "$WT" && printf '; git rebase --abort there undoes it')"
    warn "rebase conflicts in: $files; asking the builder"
    ask "$agent" "$(rebase_fix_prompt "origin's $BASE" "$files")"
    if rebase_in_progress "$WT"; then
      die "the rebase onto origin's $BASE is still in progress in $WT; finish or abort it"
    fi
    tree_dirty "$WT" && die "$WT has uncommitted changes after the rebase; commit or stash them, then rerun"
    git -C "$WT" merge-base --is-ancestor "$onto" HEAD || die "$BRANCH is still not on top of origin's $BASE; rebase it in $WT, then rerun"
  fi
  printf '%s %s\n' "$onto" "refs/remotes/origin/$BASE" >"$TASK_STATE/base"
}

# pr_checks -> markdown bullets describing what the run directory proves
pr_checks() {
  local d="$WT/$RUN_DIR" f gates reviews
  shopt -s nullglob
  gates=("$d"/gate-*.log)
  reviews=("$d"/review-*.md)
  shopt -u nullglob
  if ((${#gates[@]})); then
    f=$(printf '%s\n' "${gates[@]}" | sort -V | tail -n1)
    printf -- '- Gate %s passed (%s)\n' "\`$GATE\`" "$(basename "$f" .log)"
  else
    printf -- '- Gate: not run by Factory\n'
  fi
  if ((${#reviews[@]})); then
    while IFS= read -r f; do
      printf -- '- %s: %s\n' "$(basename "$f" .md)" "$(verdicts "$f")"
    done < <(printf '%s\n' "${reviews[@]}" | sort -V)
  fi
  waived && printf -- '- Protected paths allowed by the human: %s\n' "$(allowed_paths)"
  return 0
}

# pr_body: the pull request's description: the task, what the run proves, the plan, your answers
pr_body() {
  cat <<B
${TASK_DESC:-$TASK_TITLE}

Bead $TASK_ID.

$(pr_checks)

<details>
<summary>Plan</summary>

$(cat "$WT/$RUN_DIR/plan.md" 2>/dev/null || printf 'no plan file')

</details>
$(decisions_block)
B
}

# decisions_block: the human's answers on the task, as Factory keeps them, for the pull request,
# if there were any
decisions_block() {
  [[ -s $TASK_STATE/decisions.md ]] || return 0
  printf '\n<details>\n<summary>Decisions</summary>\n\n%s\n\n</details>\n' "$(<"$TASK_STATE/decisions.md")"
}

# gh_wt gh-args...: gh in the worktree, so {owner}/{repo} and the branch resolve from its origin.
gh_wt() { (cd "$WT" && gh "$@"); }

# existing_pr -> url of the branch's open pull request, empty if none
existing_pr() {
  gh_wt pr list --head "$BRANCH" --state open --json url -q '.[0].url // empty'
}

# raise_pr builder-agent: bring the branch up to date with origin's base, check its tip, push it
# and open its pull request, or take the one open. Sets PR_URL.
raise_pr() {
  need gh
  git -C "$WT" remote get-url origin >/dev/null 2>&1 || die "$WT has no origin remote"
  rebase_onto_base "$1"
  guarded || regate "$1" pr
  push_gated -q --force-with-lease || die "could not push $BRANCH to origin"
  # pushed by its id, the branch gets no upstream from git push -u: it tracks origin's from here
  git -C "$WT" branch -q --set-upstream-to="origin/$BRANCH" || warn "$BRANCH tracks no branch on origin"
  PR_URL=$(existing_pr) || die "gh could not list the pull requests of $BRANCH"
  if [[ -n $PR_URL ]]; then
    log "pull request already open, reusing it: $PR_URL"
  else
    PR_URL=$(gh_wt pr create --base "$BASE" --head "$BRANCH" --title "$TASK_ID: $TASK_TITLE" --body "$(pr_body)") \
      || die "gh could not open a pull request for $BRANCH"
    log "opened $PR_URL"
  fi
  metric pr url "$PR_URL"
}

# pull_request builder-agent: raise_pr, then Copilot's review rounds where they are on;
# COPILOT_NOTE says how those ended
pull_request() {
  COPILOT_NOTE=""
  raise_pr "$1"
  ((FACTORY_COPILOT)) || return 0
  copilot_loop "$1" "$PR_URL" || warn "Copilot loop ended without a clean review: $COPILOT_NOTE; see $PR_URL"
}

# pushed_holds: 0 when origin's copy of the branch is the commit Factory pushed; one an agent
# pushed there itself would be in the pull request unchecked
pushed_holds() {
  local theirs=""
  theirs=$(GIT_TERMINAL_PROMPT=0 git -C "$WT" ls-remote origin "refs/heads/$BRANCH" | cut -f1) || theirs=""
  [[ -n $theirs && $theirs == "$(recorded pushed)" ]]
}

# unpushed -> what the task's worktree holds that the commit Factory pushed, the pull
# request's, lacks: commits after it, changes not committed, or both; nothing when none
unpushed() {
  local pushed left=""
  pushed=$(recorded pushed)
  task_head
  [[ $HEAD_SHA == "$pushed" ]] || left="commits after ${pushed:0:7}"
  if tree_dirty "$WT"; then left="${left:+$left and }uncommitted changes"; fi
  printf '%s' "$left"
}

# --------------------------------------------------------------- copilot ----
# GitHub Copilot code review never approves formally; its review body carries a verdict heading
# such as "### 🟢 Approval recommended", below an overview header in newer reviews, and its
# inline comments are posted by the user "Copilot". Done means: the review of the head commit
# recommends approval, or has no comments.
# COPILOT_JQ: jq's copilot(login), a login of the Copilot reviewer, which reviews as
# copilot-pull-request-reviewer[bot] and comments as Copilot; and review_lines(sha), the lines
# of the body of its latest review of that commit, from the reviews
COPILOT_JQ="def copilot(\$login): (\$login // \"\") | ascii_downcase | startswith(\"copilot\");
def review_lines(\$sha): [.[] | select(copilot(.user.login) and .commit_id == \$sha)] | last | (.body // \"\") | split(\"\\n\");"

# copilot_request pr-number
copilot_request() {
  gh_wt api -X POST "repos/{owner}/{repo}/pulls/$1/requested_reviewers" -f "reviewers[]=$COPILOT_BOT" >/dev/null
}

# copilot_reviews pr-number -> the pull request's reviews, every page of them, as one JSON array
copilot_reviews() { gh_wt api --paginate "repos/{owner}/{repo}/pulls/$1/reviews" | jq -s 'add // []'; }

# copilot_reviewed pr-number sha: 0 once Copilot reviewed that commit
copilot_reviewed() {
  local n
  n=$(copilot_reviews "$1" | jq --arg sha "$2" "$COPILOT_JQ"'[.[] | select(copilot(.user.login) and .commit_id == $sha)] | length')
  [[ ${n:-0} -gt 0 ]]
}

# copilot_wait pr-number sha: wait until Copilot reviewed the commit, COPILOT_WAIT_S at
# most; its review takes minutes, so every 30 s is often enough
copilot_wait() { poll $((COPILOT_WAIT_S / 30 + 1)) 30 copilot_reviewed "$1" "$2"; }

# copilot_comments_of sha: the REST comments JSON on stdin as "path:line: body" lines, for Copilot's
# comments made on that commit. GitHub moves commit_id along with the head while a commented
# line survives; original_commit_id stays.
copilot_comments_of() {
  jq -r --arg sha "$1" "$COPILOT_JQ"'
    .[] | select(copilot(.user.login) and .original_commit_id == $sha) | "\(.path):\(.line // .original_line // "?"): \(.body | gsub("\r"; "") | gsub("\n"; "\n    "))"'
}

# comment_count: how many comments copilot_comments_of's lines on stdin hold: each starts a line,
# and its body's further lines are indented under it
comment_count() { grep -c '^[^ ]'; }

# copilot_verdict_of sha: the first `### ` heading of Copilot's review body for one commit, from
# reviews JSON on stdin. The body may open with an overview header above it.
copilot_verdict_of() {
  jq -r --arg sha "$1" "$COPILOT_JQ"'review_lines($sha) | map(select(startswith("### "))) | (.[0] // "") | ltrimstr("### ")'
}

# copilot_summary_of sha: the sentence under Copilot's verdict heading, from reviews JSON on stdin.
copilot_summary_of() {
  jq -r --arg sha "$1" "$COPILOT_JQ"'review_lines($sha)
    | (map(startswith("### ")) | index(true)) as $i | if $i == null then "" else (.[$i + 1:] | map(select(length > 0)) | (.[0] // "")) end | select(startswith("<") | not)'
}

# copilot_comments pr-number sha
copilot_comments() {
  gh_wt api --paginate "repos/{owner}/{repo}/pulls/$1/comments" | copilot_comments_of "$2"
}

# copilot_reply_body round sha comments-file response-file -> one pull request comment for the
# round: the comments the commit addressed, or, with no commit, that none changed anything; then
# the builder's reasons for what it left as it was
copilot_reply_body() {
  local round=$1 sha=$2 comments=$3 response=$4
  if [[ -n $sha ]]; then
    printf 'Addressed Copilot review round %s in %s:\n\n' "$round" "${sha:0:7}"
  else
    printf 'Answered Copilot review round %s without changes:\n\n' "$round"
  fi
  grep -oE '^[^ ]+:[0-9?]+:' "$comments" | sed 's/:$//; s/^/- /'
  if [[ -s $response ]]; then
    printf '\nNot changed, and why:\n\n%s\n' "$(<"$response")"
  fi
}

# copilot_reply pr-number round [sha]: the round's reply, naming the commit that addressed it
copilot_reply() {
  local body
  body=$(copilot_reply_body "$2" "${3:-}" "$WT/$RUN_DIR/copilot-$2.md" "$WT/$RUN_DIR/copilot-$2-response.md")
  gh_wt pr comment "$1" --body "$body" >/dev/null || warn "could not post the reply to Copilot's round $2 on the pull request"
}

# copilot_resolve pr-number sha: resolve Copilot's review threads that start on that commit,
# among the pull request's last 100, which are the newest: those of this round's review
copilot_resolve() {
  local ids id query mutation n=0
  query=$(
    cat <<'Q'
query($owner: String!, $repo: String!, $pr: Int!) {
  repository(owner: $owner, name: $repo) { pullRequest(number: $pr) {
    reviewThreads(last: 100) { nodes { id isResolved
      comments(first: 1) { nodes { author { login } originalCommit { oid } } } } } } } }
Q
  )
  mutation=$(
    cat <<'Q'
mutation($id: ID!) { resolveReviewThread(input: {threadId: $id}) { thread { isResolved } } }
Q
  )
  ids=$(gh_wt api graphql -F owner='{owner}' -F repo='{repo}' -F pr="$1" -f query="$query" \
    --jq "$COPILOT_JQ .data.repository.pullRequest.reviewThreads.nodes[]
      | select(.isResolved | not)
      | select(copilot(.comments.nodes[0].author.login) and .comments.nodes[0].originalCommit.oid == \"$2\")
      | .id") || {
    warn "could not list review threads"
    return 0
  }
  for id in $ids; do
    if gh_wt api graphql -f query="$mutation" -F id="$id" >/dev/null; then
      n=$((n + 1))
    else
      warn "could not resolve thread $id"
    fi
  done
  ((n == 0)) || log "resolved $n Copilot thread(s)"
}

# copilot_loop builder-agent pr-url: request reviews and act on their comments until a review has
# none or recommends approval, FACTORY_COPILOT_ROUNDS at most; COPILOT_NOTE says how it ended
copilot_loop() {
  local agent=$1 url=$2 n sha round=1 reviews comments verdict
  n=${url##*/}
  while ((round <= FACTORY_COPILOT_ROUNDS)); do
    sha=$(git -C "$WT" rev-parse HEAD)
    copilot_request "$n" || {
      COPILOT_NOTE="Copilot review could not be requested"
      return 1
    }
    log "Copilot review requested for ${sha:0:7} (round $round)"
    copilot_wait "$n" "$sha" || {
      COPILOT_NOTE="no Copilot review within $((COPILOT_WAIT_S / 60)) min"
      return 1
    }
    if ! reviews=$(copilot_reviews "$n") || ! verdict=$(copilot_verdict_of "$sha" <<<"$reviews") \
      || ! comments=$(copilot_comments "$n" "$sha"); then
      COPILOT_NOTE="could not read Copilot's review of ${sha:0:7}"
      return 1
    fi
    metric copilot round "$round" comments "$(comment_count <<<"$comments")"
    # Copilot's verdict line is the useful summary; keep it for the bead and the log.
    if [[ -z $comments ]]; then
      local summary
      summary=$(copilot_summary_of "$sha" <<<"$reviews")
      COPILOT_NOTE="Copilot: ${verdict:-reviewed}${summary:+: $summary}"
      log "$COPILOT_NOTE"
      return 0
    fi
    if [[ $verdict == *"Approval recommended"* ]]; then
      COPILOT_NOTE="Copilot: $verdict, $(comment_count <<<"$comments") nit(s) left open"
      log "$COPILOT_NOTE"
      return 0
    fi
    log "Copilot: $verdict"
    printf '%s\n' "$comments" >"$WT/$RUN_DIR/copilot-$round.md"
    rm -f "$WT/$RUN_DIR/copilot-$round-response.md" # an earlier run's would be posted as this round's
    log "Copilot left $(comment_count <"$WT/$RUN_DIR/copilot-$round.md") comment(s); asking the builder"
    ask "$agent" "$(copilot_fix_prompt "$round")"
    # changes not committed fail the guardrails, after however long the gate takes: a commit
    # the signer refused, say, locked while nobody was there to unlock it
    if tree_dirty "$WT"; then
      COPILOT_NOTE="the builder left its fixes for Copilot's round $round uncommitted"
      return 1
    fi
    if [[ $(git -C "$WT" rev-parse HEAD) == "$sha" ]]; then
      # the pushback alone, which another review would only repeat; a turn that neither changed
      # nor answered anything gets no reply, and the threads stay open
      if [[ ! -s $WT/$RUN_DIR/copilot-$round-response.md ]]; then
        COPILOT_NOTE="the builder neither changed anything nor answered Copilot's round $round"
        return 1
      fi
      copilot_reply "$n" "$round"
      copilot_resolve "$n" "$sha"
      COPILOT_NOTE="Copilot's comments answered without changes"
      return 1
    fi
    gate_then_guards "$agent" "copilot-$round" || {
      COPILOT_NOTE="gate or guardrails failed while addressing Copilot's comments"
      return 1
    }
    push_gated -q || {
      COPILOT_NOTE="could not push the fixes for round $round"
      return 1
    }
    copilot_reply "$n" "$round" "$(git -C "$WT" rev-parse HEAD)"
    copilot_resolve "$n" "$sha"
    round=$((round + 1))
  done
  COPILOT_NOTE="Copilot rounds used up; the fixes of round $FACTORY_COPILOT_ROUNDS went unreviewed"
  return 1
}

# --------------------------------------------------------------- prompts ----
# plan_prompt: the planner's task: explore, ask when the task is ambiguous, write the plan
plan_prompt() {
  cat <<P
Task $TASK_ID: $TASK_TITLE

$TASK_DESC

You are the planner. Explore this repo, then write a short, specific implementation plan to $RUN_DIR/plan.md: the design in a few lines (which parts change, their responsibilities and interfaces, as simple as the task allows), which files change and how, and how to verify. The gate that must pass is: $GATE
End the plan with one line, Protected paths: none, or Protected paths: and the paths the build must change, comma-separated and nothing else; once the human allows protected paths at approval, the build may change those and no others. Protected are these git pathspecs: $(protected_globs "$WT" | tr '\n' ' ')
Do not write the code itself and do not change any file outside $RUN_DIR/; Factory checks.
If the task is ambiguous in a way that would change the design, ask the human first with your AskUserQuestion tool (up to four questions, with options where they help); prefer a plan with stated assumptions when the ambiguity is minor.$([[ ! -s $TASK_STATE/decisions.md ]] || printf ' The human'"'"'s answers and decisions on this task so far are in %s; read them before asking again.' "$RUN_DIR/decisions.md")$(approval_rule plan)
$MEMORY
Once the file is written, reply with its content.
P
}

# build_prompt [resume]: the builder's task: implement the approved plan on the branch, gate
# green; a resumed build is told that part of it may be there already
build_prompt() {
  cat <<P
Task $TASK_ID: $TASK_TITLE

Re-read $RUN_DIR/plan.md now; it is final and may have changed since you checked it. Implement it on this branch ($BRANCH) in this worktree. Run the gate until it passes: $GATE
Commit when done; do not push, and do not rebase onto or merge $BASE: Factory brings the branch up to date itself. Factory tracks and closes bead $TASK_ID. Files under $RUN_DIR/ are ignored by git. $(protected_rule)
No skipped tests, suppressions or swallowed errors; fix things properly.$(approval_rule build)$([[ ${1:-} != resume ]] || printf '\nPart of it may already be implemented or committed on this branch from an earlier run; check the branch and continue from there.')
$MEMORY
Reply with just DONE when finished.
P
}

# approval_rule plan|build: how the human answers the approval, for the agent's prompt, where
# Factory asks for one (FACTORY_APPROVAL=ask); under auto those commands would refuse
approval_rule() {
  [[ $FACTORY_APPROVAL == ask ]] || return 0
  local allow=""
  [[ $1 != plan ]] || allow=" (--allow-protected to allow the protected paths it names)"
  printf '\nThe human approves, revises or aborts the %s in the dialog Factory has you show, or with !fy approve%s, %s or !fy abort; never run these, and when the human tells you such a thing in words, tell them which to type.' \
    "$1" "$allow" "!fy reject '<note>'"
}

# protected_rule: the builder's rule on the protected paths: leave them alone, but those the
# human allowed at the plan's approval, the ones the plan named
protected_rule() {
  local globs allowed
  globs=$(protected_globs "$WT" | tr '\n' ' ')
  allowed=$(allowed_paths)
  if [[ $allowed == none ]]; then
    printf 'Do not change: %s' "$globs"
  else
    printf 'The human allowed you to change these protected paths, which the plan names: %s. Change no others of: %s' "$allowed" "$globs"
  fi
}

# gate_fix_prompt logfile
gate_fix_prompt() {
  cat <<P
The gate failed ($GATE). Last lines of ${1#"$WT/"}:

$(tail -n "$GATE_LOG_TAIL" "$1")

Fix it, run the gate until green, and commit. Reply with just DONE.
P
}

# guard_fix_prompt violations
guard_fix_prompt() {
  cat <<P
Factory's guardrails rejected the branch:

$1

Fix the cause (no skipped tests, suppressions or swallowed errors, and no change to a protected path the human did not allow) and make sure everything is committed. Reply with just DONE.
P
}

# review_prompt round [human's note]
review_prompt() {
  cat <<P
Review task $TASK_ID: $TASK_TITLE
The plan is in $RUN_DIR/plan.md. The changes: git diff $(measured_base)...HEAD
Factory ran the gate on this commit and it passed; its log is $RUN_DIR/gate-$1.log. Do not run it again.
Look for bugs, missed requirements, shortcuts (skipped tests, suppressions, swallowed errors), security problems (unsafe input handling, injection, secrets, unsafe defaults), and design problems worth fixing now: tangled responsibilities, needless coupling or abstraction, duplicated logic. Be concrete and brief.$(build_recheck "$1" "" "${2:-}")
Write the review to $RUN_DIR/review-$1.md and end that file with two lines: CODE REVIEW round $1, then VERDICT: APPROVE or VERDICT: REVISE
Once the file is written, reply with its content.
P
}

# plan_review_prompt round [human's note]
plan_review_prompt() {
  cat <<P
Task $TASK_ID: $TASK_TITLE

$TASK_DESC

A planner wrote $RUN_DIR/plan.md. Check it against the task and the repo: does it cover the whole task, nothing more, is the design sound (clear responsibilities, no needless coupling or abstraction, fits how the codebase is built), and can it be verified with the gate ($GATE)? Note real gaps only.$(plan_recheck "$1" "$RUN_DIR/plan-review-$(($1 - 1)).md" "${2:-}")
Write your notes to $RUN_DIR/plan-review-$1.md and end that file with two lines: PLAN REVIEW round $1, then VERDICT: APPROVE or VERDICT: REVISE
Once the file is written, reply with its content.
P
}

# builder_plan_review_prompt round [human's note]
builder_plan_review_prompt() {
  cat <<P
Task $TASK_ID: $TASK_TITLE

$TASK_DESC

You will implement $RUN_DIR/plan.md next. Read it against this repo first: is it concrete enough to build, is its design the simplest that fits this codebase, does it miss anything the task needs, or add anything it does not? Note real gaps only.$(plan_recheck "$1" "$RUN_DIR/plan-review-$(($1 - 1))-build.md" "${2:-}")
Write your notes to $RUN_DIR/plan-review-$1-build.md and end that file with two lines: PLAN REVIEW round $1, then VERDICT: APPROVE or VERDICT: REVISE
Once the file is written, reply with its content.
P
}

# plan_recheck round notes [human's note]: from the second round on, a reviewer checks what
# changed since its notes; after a note from the human, against that note too
plan_recheck() {
  if (($1 > 1)); then
    printf '\nYour notes from the previous review round are in %s. Check what changed since against them and for anything it broke; ask for another revision only for a real problem, not for polish.' "$2"
  fi
  if [[ -n ${3:-} ]]; then
    printf '\nThe human sent this note on the plan: %s\n%s says what the planner changed for it, or why not. Check the plan against the note as well.' "$3" "$RUN_DIR/plan-changes.md"
  fi
  return 0
}

# build_recheck round suffix [human's note]: from the second round on, a reviewer checks what
# changed since its last notes (review-<k><suffix>.md), with the builder's answer to them, and
# after a note from the human, against that note too
build_recheck() {
  local k=$(($1 - 1))
  while ((k > 0)) && [[ ! -s $WT/$RUN_DIR/review-$k$2.md ]]; do k=$((k - 1)); done
  if ((k > 0)); then
    printf '\nYour notes from review round %s are in %s.' "$k" "$RUN_DIR/review-$k$2.md"
    [[ ! -s $WT/$RUN_DIR/response-$k.md ]] || printf ' The builder said why it left points as they were in %s.' "$RUN_DIR/response-$k.md"
    printf ' Check what changed since against them and for anything it broke; ask for another revision only for a real problem, not for polish.'
  fi
  [[ -z ${3:-} ]] || printf '\nThe human sent this note on the build: %s\nCheck the changes against the note as well.' "$3"
  return 0
}

# plan_note_prompt note
plan_note_prompt() {
