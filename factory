#!/usr/bin/env bash
# Factory: a simple software factory on Herdr. CLI name: factory.
# Claude Code plans (Fable) and builds (Opus), Codex reviews (GPT), Beads remembers.
set -euo pipefail

FACTORY_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
FACTORY_VERSION=0.1.6

# Knobs; factory help prints the current values. A repo's .factory/env fills in the
# ones the environment left unset (load_repo_env); flags override both.
ENV_KNOBS=$(compgen -A variable FACTORY_)
: "${FACTORY_PLAN_MODEL:=claude-fable-5-1}"
: "${FACTORY_BUILD_MODEL:=claude-opus-5}"
: "${FACTORY_REVIEW_MODEL:=gpt-6-astra}"
: "${FACTORY_ROUNDS:=3}"
: "${FACTORY_TURN_TIMEOUT_MS:=3600000}"
: "${FACTORY_CLAUDE_PERMISSIONS:=auto}"
: "${FACTORY_GUARDRAILS:=$FACTORY_HOME/guardrails.txt}"
: "${FACTORY_REQUIRE_TESTS:=1}"
: "${FACTORY_APPROVAL:=ask}"
: "${FACTORY_POLL_SECONDS:=5}"
: "${FACTORY_PR:=0}"
: "${FACTORY_COPILOT:=1}"
: "${FACTORY_COPILOT_ROUNDS:=3}"
: "${FACTORY_COPILOT_WAIT_S:=900}"
: "${FACTORY_BD_PUSH:=1}"
: "${FACTORY_FRESH:=0}"
COPILOT_BOT='copilot-pull-request-reviewer[bot]'
RUN_DIR=.factory/run
# files that look like tests, for the tests-required guardrail
TEST_PATH_RE='(^|/)(tests?|spec|specs|__tests__|bats)/|(^|/)test_[^/]*\.py$|_test\.[a-z]+$|\.(test|spec)\.[a-z]+$|Tests?\.(java|kt|scala|cs|swift)$|_spec\.rb$|\.bats$'

# ---------------------------------------------------------------- output ----
TAG=$'\033[34m[factory]\033[0m' # log's prefix, shared with the prompts that must not end the line
log() { printf '%s %s\n' "$TAG" "$*" >&2; }
warn() { printf '\033[33m[factory]\033[0m %s\n' "$*" >&2; }
die() {
  printf '\033[31m[factory] error:\033[0m %s\n' "$*" >&2
  # inside $(...) exit ends only the subshell, and a caller in a || list would carry on
  [[ -z ${FACTORY_PID:-} || $BASHPID == "$FACTORY_PID" ]] || kill -s USR1 "$FACTORY_PID"
  exit 1
}
need() { command -v "$1" >/dev/null 2>&1 || die "missing prerequisite: $1"; }
need_all() {
  local t
  for t in "$@"; do need "$t"; done
}
RUN_TOOLS=(herdr claude codex bd jq git)

row() { printf '  %-54s %s\n' "$1" "$2"; }

usage() {
  printf 'Factory %s: a simple software factory on Herdr\n\nusage:\n' "$FACTORY_VERSION"
  row 'factory run     <repo> <bead-id | "task title">' 'plan, build, gate, review one task'
  row 'factory next    <repo>' 'claim the next ready bead and run it'
  row 'factory queue   <repo> [max]' 'run ready beads one after another'
  row '  flags: --pr, --auto, --no-copilot, --fresh' 'open a PR; skip the human gates; no Copilot review; do not resume'
  row 'factory add     <repo> ["title" [description]]' 'file a task; no title opens your editor (or reads stdin)'
  row 'factory tasks   <repo> [--all]' 'list open tasks (beads); --all includes closed'
  row 'factory sync    <repo>' 'pull, then push the beads database to its git remote'
  row 'factory init    <repo> [bd init args...]' 'lean bd init, detect the gate, AGENTS.md stub'
  row 'factory approve <repo> <bead-id> [--allow-protected]' 'approve the waiting plan or build from any terminal'
  row 'factory reject  <repo> <bead-id> "note"' 'send a note back; the plan or build comes back revised'
  row 'factory answer  <repo> <bead-id> ["answers" | -]' 'answer the planner'"'"'s questions from any terminal'
  row 'factory pr      <repo> <bead-id>' 'push an existing task branch and open a pull request'
  row 'factory clean   <repo> [bead-id] [--force]' 'remove workspaces, worktrees and branches of merged tasks'
  row 'factory check   <worktree> <base>' 'run gate + guardrails on a branch, no agents'
  row 'factory status' 'live factory agents in Herdr'
  row 'factory doctor' 'check prerequisites'
  printf '\nknobs (env, or the repo'"'"'s .factory/env; current values):\n'
  row "FACTORY_PLAN_MODEL=$FACTORY_PLAN_MODEL" 'planner (Claude Code)'
  row "FACTORY_BUILD_MODEL=$FACTORY_BUILD_MODEL" 'builder (Claude Code)'
  row "FACTORY_REVIEW_MODEL=$FACTORY_REVIEW_MODEL" 'reviewer (Codex)'
  row "FACTORY_ROUNDS=$FACTORY_ROUNDS" 'build / review rounds before giving up'
  row "FACTORY_CLAUDE_PERMISSIONS=$FACTORY_CLAUDE_PERMISSIONS" 'Claude Code permission mode'
  row "FACTORY_TURN_TIMEOUT_MS=$FACTORY_TURN_TIMEOUT_MS" 'a stalled turn fails after this; a working one toasts you and goes on'
  row 'FACTORY_GATE=<command>' 'else .factory/gate, else the repo'"'"'s own convention'
  row "FACTORY_REQUIRE_TESTS=$FACTORY_REQUIRE_TESTS" 'code changes must touch a test file'
  row "FACTORY_APPROVAL=$FACTORY_APPROVAL" 'ask: you approve each plan and build; auto: skip'
  row "FACTORY_POLL_SECONDS=$FACTORY_POLL_SECONDS" 'seconds between checks for the approve, reject and answer files'
  row "FACTORY_PR=$FACTORY_PR" '1: push the approved branch and open a pull request'
  row "FACTORY_COPILOT=$FACTORY_COPILOT" '1: request a Copilot review on the PR and act on its comments'
  row "FACTORY_COPILOT_ROUNDS=$FACTORY_COPILOT_ROUNDS" 'Copilot review rounds before giving up'
  row "FACTORY_COPILOT_WAIT_S=$FACTORY_COPILOT_WAIT_S" 'seconds to wait for each Copilot review'
  row "FACTORY_BD_PUSH=$FACTORY_BD_PUSH" '1: push beads to their sync remote after tasks and adds'
  row "FACTORY_GUARDRAILS=$FACTORY_GUARDRAILS" 'forbidden-pattern list; a repo'"'"'s .factory/guardrails.txt replaces it'
  row "FACTORY_FRESH=$FACTORY_FRESH" '1: start the task over instead of resuming (--fresh)'
}

# ----------------------------------------------------------------- herdr ----
# h: run a herdr command, print its JSON, die on error JSON.
h() {
  local out
  if ! out=$(herdr "$@" 2>&1); then
    die "herdr $1 $2: $(herr_msg "$out")"
  fi
  printf '%s' "$out"
}

herr_code() { jq -r '.error.code // empty' <<<"$1" 2>/dev/null; }
herr_msg() { jq -r '.error.message // .' <<<"$1" 2>/dev/null || printf '%s' "$1"; }

toast() { # title body sound; the title is prefixed with the product name
  herdr notification show "Factory: $1" --body "$2" --sound "$3" >/dev/null 2>&1 || warn "toast failed: $1"
}

attention() { # agent message
  warn "$1 $2"
  toast "$TASK_ID" "$1 $2" request
}

agent_status() { h agent get "$1" | jq -r '.result.agent.agent_status'; }

# wait_for name timeout_ms state... : block until the agent reaches one of the states.
# Waits in one-minute chunks: every chunk re-checks the screen for a known dialog, every
# five minutes prints a heartbeat, so a long gate run is visibly a wait and not a hang.
wait_for() {
  local name=$1 timeout=$2 out code status waited=0 chunk=60000 nagged=0
  shift 2
  local args=()
  local s
  for s in "$@"; do args+=(--until "$s"); done
  while :; do
    if out=$(herdr agent wait "$name" "${args[@]}" --timeout "$chunk" 2>&1); then
      jq -r '.result.agent.agent_status' <<<"$out"
      return 0
    fi
    code=$(herr_code "$out")
    [[ $code == timeout ]] || die "$name: waiting for ${*}: $(herr_msg "$out")"
    waited=$((waited + chunk))
    status=$(agent_status "$name")
    if ((waited >= timeout)); then
      # a turn that is visibly working is a long build, not a stall: tell the human once and keep waiting
      [[ $status == working ]] || die "$name: no ${*} within $((timeout / 60000)) min and it is $status; look at its pane"
      if ((! nagged)); then
        nagged=1
        attention "$name" "is still working after $((timeout / 60000)) min; fine for a long build, Ctrl-C the run if it is stuck"
      fi
    fi
    [[ $status == idle || $status == "done" ]] || settle_dialogs "$name" quiet
    ((waited % 300000 == 0)) && log "still waiting on $name ($status, $((waited / 60000)) min)"
  done
}

# settle_dialogs name: clear the startup dialogs agents show in a fresh worktree
# (trust prompts, mode notices, Codex hook review). Herdr does not flag all of them
# as blocked, so this looks at the screen rather than the reported state.
settle_dialogs() {
  local name=$1 quiet=${2:-} i txt status
  for i in 1 2 3 4 5 6; do
    txt=$(herdr agent read "$name" --source visible 2>/dev/null) || txt=""
    if grep -qE 'Yes, I (trust|accept)' <<<"$txt"; then
      log "$name: accepting startup dialog (attempt $i)"
      herdr agent send-keys "$name" down >/dev/null
      sleep 0.5
      herdr agent send-keys "$name" enter >/dev/null
    elif grep -q 'Do you trust the contents of this directory' <<<"$txt"; then
      log "$name: accepting Codex trust dialog (attempt $i)"
      herdr agent send-keys "$name" enter >/dev/null
    elif grep -qE 'hooks need review|Press enter to view hooks' <<<"$txt"; then
      log "$name: closing Codex hooks dialog without enabling hooks (attempt $i)"
      herdr agent send-keys "$name" esc >/dev/null
    elif grep -qE 'q close +esc to edit prev|T R A N S C R I P T' <<<"$txt"; then
      # Codex opens its transcript overlay to show startup warnings (e.g. a failed MCP);
      # Herdr sees an idle agent, but typed prompts go nowhere until it is closed.
      log "$name: closing Codex transcript overlay (attempt $i)"
      herdr agent send-keys "$name" q >/dev/null
    else
      [[ -n $quiet ]] && return 0 # nothing on screen we know; the caller keeps waiting
      status=$(agent_status "$name")
      case $status in
        idle | done) return 0 ;;
        blocked) attention "$name" "is blocked on a dialog I do not recognize; answer it in its pane" ;;
      esac
    fi
    sleep 3
  done
  [[ -n $quiet ]] && return 0
  status=$(agent_status "$name")
  case $status in idle | done) return 0 ;; esac
  die "$name: still $status after startup; look at its pane"
}

# set_color agent colour: Claude Code's /color tints the session's prompt line, which is how
# the two Claude panes are told apart: the planner is purple, the builder cyan.
set_color() {
  # no --wait: /color finishes without a lifecycle change, which --wait would report as a stall
  if ! herdr agent prompt "$1" "/color $2" >/dev/null 2>&1; then
    warn "$1: could not set the session colour"
  fi
}

# close_extra_panes workspace keep-pane: drop agent-less panes left by exited sessions
close_extra_panes() {
  local ws=$1 keep=$2 pane
  while IFS= read -r pane; do
    [[ -n $pane && $pane != "$keep" ]] || continue
    herdr pane close "$pane" >/dev/null 2>&1 || warn "could not close leftover pane $pane"
  done < <(herdr pane list --workspace "$ws" 2>/dev/null | jq -r '.result.panes[] | select(.agent == null) | .pane_id')
}

# live_agents workspace name... -> how many of the named agents are alive in that workspace
live_agents() {
  local ws=$1
  shift
  herdr agent list 2>/dev/null | jq -r --arg ws "$ws" --argjson names "$(printf '%s\n' "$@" | jq -R . | jq -s .)" \
    '[.result.agents[] | select(.workspace_id == $ws and ((.name // "") as $n | $names | index($n)))] | length'
}

# prime_shell pane: run the env setup in the pane and make sure it actually ran. A fresh
# shell's line editor (ble.sh) sometimes swallows the Enter and sits in multiline mode;
# Ctrl-C gives a clean prompt again, then the command is retried.
prime_shell() {
  local pane=$1 i
  for i in 1 2 3; do
    h pane run "$pane" ". $RUN_DIR/env.sh && clear && printf 'factory-%s\\n' ready" >/dev/null
    herdr pane wait-output --match factory-ready --source visible --timeout 8000 "$pane" >/dev/null 2>&1 && return 0
    warn "pane $pane did not run its setup command; clearing the input line and retrying"
    herdr pane send-keys "$pane" c-c >/dev/null 2>&1
    sleep 1
  done
  die "pane $pane: the shell does not run commands; look at it"
}

# start_agent name kind pane [agent args...]
start_agent() {
  local name=$1 kind=$2 pane=$3 out code i
  shift 3
  for i in 1 2 3 4 5; do
    if out=$(herdr agent start "$name" --kind "$kind" --pane "$pane" --timeout 90000 -- "$@" 2>&1); then
      sleep 2
      settle_dialogs "$name"
      return 0
    fi
    code=$(herr_code "$out")
    case $code in
      agent_not_ready)
        settle_dialogs "$name"
        return 0
        ;;
      pane_not_available | pane_busy | shell_not_ready)
        sleep 1
        ;;
      agent_start_failed)
        # usually "timed out waiting for agent startup": the pane's shell never ran the
        # command (line editor stuck in multiline mode); clear its input and try again
        grep -q 'timed out' <<<"$out" || die "start $name: $(herr_msg "$out")"
        warn "$name: startup timed out; clearing the pane's input line and retrying"
        herdr pane send-keys "$pane" c-c >/dev/null 2>&1
        sleep 2
        ;;
      *) die "start $name: $(herr_msg "$out")" ;;
    esac
  done
  die "start $name: pane $pane never became an available shell"
}

# ask name text: send a prompt and wait for the turn to settle, handing blocks to the human.
ask() {
  local name=$1 text=$2 out status stalls=0
  while :; do
    if out=$(herdr agent prompt "$name" "$text" --wait --timeout 60000 2>&1); then
      break
    fi
    case $(herr_code "$out") in
      agent_prompt_stalled)
        stalls=$((stalls + 1))
        ((stalls < 3)) || die "$name: prompt stalled 3 times; look at its pane"
        settle_dialogs "$name"
        ;;
      agent_blocked)
        unblock "$name"
        ;;
      timeout)
        status=$(wait_for "$name" "$FACTORY_TURN_TIMEOUT_MS" idle "done" blocked)
        [[ $status == blocked ]] && unblock "$name"
        return 0
        ;;
      *) die "$name: $(herr_msg "$out")" ;;
    esac
  done
  status=$(jq -r '.result.agent.agent_status' <<<"$out")
  [[ $status == blocked ]] && unblock "$name"
  return 0
}

# unblock name: a blocked agent gets the dialog settler first; only an unknown dialog
# goes to the human. Returns once the agent is idle or done.
unblock() {
  local name=$1 status
  settle_dialogs "$name" quiet
  status=$(agent_status "$name")
  while [[ $status == blocked ]]; do
    attention "$name" "is waiting for your input"
    status=$(wait_for "$name" "$FACTORY_TURN_TIMEOUT_MS" idle "done")
  done
}

# ask_for_file name text file: like ask, but the turn only counts once the file exists.
ask_for_file() {
  local name=$1 text=$2 file=$3
  ask "$name" "$text"
  [[ -s $file ]] && return 0
  warn "$name replied but $file is missing; asking again"
  ask "$name" "You replied, but $file does not exist. Write it now and reply DONE."
  [[ -s $file ]] || die "$name never wrote $file"
}

# ----------------------------------------------------------------- beads ----
bd_field() { # repo id jq-expr
  bd -C "$1" show "$2" --json 2>/dev/null | jq -r "if type == \"array\" then .[0] else . end | $3"
}

# need_beads repo: the commands that touch tasks want a bd init first
need_beads() { [[ -d $1/.beads ]] || die "no beads in $1; run: factory init $1"; }

# bd_note repo id text: a comment on the bead, tagged so it reads as the factory's in bd show
bd_note() { bd -C "$1" comment "$2" "Factory: $3" >/dev/null; }

is_bead_id() { [[ $1 =~ ^[a-z][a-z0-9]*-[a-z0-9]+$ ]]; }

# slugify text -> lowercase, dashes for anything else, at most 40 characters
slugify() {
  # C locale: only ASCII letters and digits survive, so branch names stay plain
  printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-40 | sed -E 's/-+$//'
}

# branch_of repo bead-id -> the task's existing branch (factory/<id> or factory/<id>-<slug>), or empty
branch_of() {
  git -C "$1" branch --list "factory/$2" "factory/$2-*" --format='%(refname:short)' | head -n1
}

# bead_of_branch branch -> the bead id in a factory branch name
bead_of_branch() { sed -E 's#^factory/([a-z][a-z0-9]*-[a-z0-9]+).*#\1#' <<<"$1"; }

# resolve_task repo arg -> TASK_ID TASK_TITLE TASK_DESC
resolve_task() {
  local repo=$1 arg=$2
  need_beads "$repo"
  if is_bead_id "$arg" && bd -C "$repo" show "$arg" --json >/dev/null 2>&1; then
    TASK_ID=$arg
    TASK_TITLE=$(bd_field "$repo" "$arg" '.title')
    TASK_DESC=$(bd_field "$repo" "$arg" '.description // ""')
  else
    TASK_ID=$(bd -C "$repo" create "$arg" --silent)
    TASK_TITLE=$arg
    TASK_DESC=""
    log "filed $TASK_ID: $arg"
  fi
}

# bd_push repo: push the beads database to its Dolt sync remote (refs/dolt/data on the
# git remote), so tasks, comments and memories survive this machine. Skips when no
# remote is configured; warns, never fails, when the push does not work.
bd_push() {
  ((FACTORY_BD_PUSH)) || return 0
  local remote out
  remote=$(bd -C "$1" config get sync.remote 2>/dev/null) || remote=""
  if [[ -z $remote || $remote == *"not set"* ]]; then
    log "beads: no sync remote configured, nothing pushed (bd dolt remote add origin git+<url>)"
    return 0
  fi
  if out=$(bd -C "$1" dolt push 2>&1); then
    log "beads pushed to $remote"
  else
    warn "beads push failed: $(tail -n1 <<<"$out")"
  fi
}

memory_block() { # repo -> text to append to prompts, empty if no memories
  local mem
  mem=$(bd -C "$1" memories 2>/dev/null) || mem=""
  if [[ -z $mem ]] || grep -q 'No memories stored' <<<"$mem"; then return 0; fi
  printf '\nNotes from earlier work on this repo (bd memories; bd recall <key> for details):\n%s\n' "$mem"
}

# ------------------------------------------------------- gate and guards ----
# find_gate repo: the gate command, or 1 when the repo has none.
find_gate() {
  if [[ -n ${FACTORY_GATE:-} ]]; then
    printf '%s' "$FACTORY_GATE"
  elif [[ -f $1/.factory/gate ]]; then
    printf 'bash .factory/gate'
  else
    detect_gate "$1"
  fi
}

resolve_gate() { # repo
  find_gate "$1" || die "no gate for $1: set FACTORY_GATE, or add .factory/gate (factory init writes one when it can)"
}

# detect_gate repo -> the command a repo's own convention suggests, empty if none.
detect_gate() {
  local r=$1 t
  if [[ -x $r/bin/test ]]; then
    printf './bin/test'
    return 0
  fi
  if [[ -f $r/justfile ]] && grep -qE '^ci:' "$r/justfile"; then
    printf 'just ci'
    return 0
  fi
  if [[ -f $r/Makefile ]]; then
    for t in ci check test; do
      if grep -qE "^$t:" "$r/Makefile"; then
        printf 'make %s' "$t"
        return 0
      fi
    done
  fi
  if [[ -f $r/Cargo.toml ]]; then
    printf 'cargo fmt --all --check && cargo clippy --all-targets -- -D warnings && cargo test'
    return 0
  fi
  if [[ -f $r/package.json ]] && jq -e '.scripts.test' "$r/package.json" >/dev/null 2>&1; then
    printf 'npm test'
    return 0
  fi
  if [[ -f $r/pyproject.toml ]]; then
    printf 'python3 -m pytest -q'
    return 0
  fi
  if [[ -f $r/go.mod ]]; then
    printf 'go vet ./... && go test ./...'
    return 0
  fi
  if [[ -f $r/mix.exs ]]; then
    printf 'mix test'
    return 0
  fi
  if [[ -x $r/gradlew ]]; then
    printf './gradlew check'
    return 0
  fi
  if [[ -f $r/pom.xml ]]; then
    printf 'mvn -q verify'
    return 0
  fi
  return 1
}

# write_gate repo command: a committed script the factory runs as the definition of done.
write_gate() {
  mkdir -p "$1/.factory"
  cat >"$1/.factory/gate" <<G
#!/usr/bin/env bash
# The factory's definition of done. Detected by factory init; make it as strict as you like.
set -euo pipefail
$2
G
  chmod +x "$1/.factory/gate"
}

# guardrails_file worktree -> the repo's own .factory/guardrails.txt if present, else Factory's
guardrails_file() {
  if [[ -f $1/.factory/guardrails.txt ]]; then printf '%s' "$1/.factory/guardrails.txt"; else printf '%s' "$FACTORY_GUARDRAILS"; fi
}

protected_globs() { # repo -> one glob per line
  printf '%s\n' .factory/gate .factory/protected .factory/guardrails.txt .factory/env
  [[ -f $1/.factory/protected ]] && grep -vE '^\s*(#|$)' "$1/.factory/protected"
  return 0
}

run_gate() { # worktree gate logfile
  local pid waited=0 rc=0
  log "gate: $2"
  (cd "$1" && bash -c "$2") >"$3" 2>&1 &
  pid=$!
  # heartbeat every five minutes: a cold build can be silent for a long time
  while kill -0 "$pid" 2>/dev/null; do
    sleep 5
    waited=$((waited + 5))
    ((waited % 300 == 0)) && log "gate still running ($((waited / 60)) min, log: $3)"
  done
  wait "$pid" || rc=$?
  if ((rc == 0)); then
    log "gate passed"
    return 0
  fi
  warn "gate failed, log: $3"
  return 1
}

# tree_dirty worktree: 0 when files outside .factory/ changed or appeared
tree_dirty() {
  [[ -n $(git -C "$1" status --porcelain --untracked-files=all -- . ':(exclude).factory') ]]
}

# guard_check worktree base: mechanical guardrails on the branch. Prints violations.
guard_check() {
  local wt=$1 base=$2 bad=0 f globs
  if tree_dirty "$wt"; then
    printf 'uncommitted changes in the worktree; commit your work (ignore build artifacts, do not commit them)\n'
    bad=1
  fi
  if [[ $(git -C "$wt" rev-list --count "$base..HEAD") -eq 0 ]]; then
    printf 'no commits on the branch since %s\n' "$base"
    bad=1
  fi
  while IFS= read -r f; do
    printf 'build artifact committed: %s\n' "$f"
    bad=1
  done < <(git -C "$wt" diff --name-only --diff-filter=A "$base...HEAD" | grep -E '(^|/)(__pycache__/|node_modules/|\.DS_Store$|.*\.pyc$|.*\.class$|.*\.o$)')
  if ((FACTORY_REQUIRE_TESTS)) && ! tests_changed_with_source "$wt" "$base"; then
    printf 'source files changed but no test files did; add or adjust a test\n'
    bad=1
  fi
  if [[ -e $wt/$RUN_DIR/allow-protected ]]; then
    printf 'note: protected-path check waived by the human for this task\n' >&2
  else
    mapfile -t globs < <(protected_globs "$wt")
    while IFS= read -r f; do
      printf 'protected path changed: %s\n' "$f"
      bad=1
    done < <(git -C "$wt" diff --name-only "$base...HEAD" -- "${globs[@]}")
  fi
  local hits=0
  local rules
  rules=$(guardrails_file "$wt")
  while IFS= read -r f; do
    if git -C "$wt" diff -U0 "$base...HEAD" -- "$f" | grep -E '^\+[^+]' \
      | grep -E -f <(grep -vE '^\s*(#|$)' "$rules") | sed "s|^+|$f: |"; then
      hits=1
    fi
  done < <(git -C "$wt" diff --name-only "$base...HEAD" -- . ':(exclude).factory')
  if ((hits)); then
    printf 'the lines above match a forbidden pattern (see %s)\n' "$rules"
    bad=1
  fi
  return $bad
}

# tests_changed_with_source worktree base: true unless code changed and no test file did.
tests_changed_with_source() {
  local files src tests
  files=$(git -C "$1" diff --name-only "$2...HEAD" -- . ':(exclude).factory')
  src=$(grep -E '\.(py|js|jsx|ts|tsx|go|rs|java|kt|kts|scala|sh|bash|rb|ex|exs|c|cc|cpp|h|hpp|cs|swift|php|lua|clj|el)$' <<<"$files" | grep -vE "$TEST_PATH_RE") || src=""
  tests=$(grep -E "$TEST_PATH_RE" <<<"$files") || tests=""
  [[ -z $src || -n $tests ]]
}
verdict_of() { # review file -> APPROVE | REVISE | (empty)
  grep -oE '^VERDICT:\s*(APPROVE|REVISE)' "$1" 2>/dev/null | tail -n1 | grep -oE 'APPROVE|REVISE'
}

verdicts() { # files... -> one word per file, NONE when missing
  local f v out=""
  for f in "$@"; do
    v=$(verdict_of "$f") || v=NONE
    out+="${out:+ }$v"
  done
  printf '%s' "$out"
}

# ------------------------------------------------------------------- pr ----
rebase_fix_prompt() { # upstream files
  cat <<P
Rebasing this branch onto $1 stopped on conflicts in:
$2
Resolve them so both sides' intent survives, git add the files, and run git rebase --continue until the rebase is done (repeat if it stops again). Do not skip commits or abort. Then run the gate: $GATE
Commit anything the gate needed. Reply with just DONE.
P
}

rebase_in_progress() { # worktree
  [[ -d $(git -C "$1" rev-parse --path-format=absolute --git-path rebase-merge) ||
  -d $(git -C "$1" rev-parse --path-format=absolute --git-path rebase-apply) ]]
}

# rebase_onto_base builder-agent: bring the branch up to date with the base before a PR.
# Returns 0 when nothing changed, 10 when the branch was rebased (gate and guards must rerun).
rebase_onto_base() {
  local agent=$1 upstream="$BASE" files
  if git -C "$WT" remote get-url origin >/dev/null 2>&1 && git -C "$WT" fetch -q origin "$BASE" 2>/dev/null; then
    upstream="origin/$BASE"
  fi
  if git -C "$WT" merge-base --is-ancestor "$upstream" HEAD 2>/dev/null; then
    return 0
  fi
  log "rebasing $BRANCH onto $upstream"
  if git -C "$WT" rebase -q "$upstream" >/dev/null 2>&1; then
    return 10
  fi
  files=$(git -C "$WT" diff --name-only --diff-filter=U | paste -sd' ')
  warn "rebase conflicts in: $files; asking the builder"
  ask "$agent" "$(rebase_fix_prompt "$upstream" "$files")"
  if rebase_in_progress "$WT"; then
    die "the rebase onto $upstream is still in progress in $WT; finish or abort it"
  fi
  tree_dirty "$WT" && die "the worktree is dirty after the rebase; commit or clean it"
  git -C "$WT" merge-base --is-ancestor "$upstream" HEAD || die "$BRANCH is still not on top of $upstream"
  return 10
}

# base_ref: the rev the branch is measured against: the local base branch or origin's copy,
# whichever the branch forked from later. Origin's after the pull request rebase, also once
# origin has moved on again (a stale local base would blame the branch for what the upstream
# added); the local one while it carries commits origin does not, or without an origin.
base_ref() {
  local origin="origin/$BASE" lo ro
  if lo=$(git -C "$WT" merge-base "$BASE" HEAD 2>/dev/null) \
    && ro=$(git -C "$WT" merge-base "$origin" HEAD 2>/dev/null) \
    && git -C "$WT" merge-base --is-ancestor "$lo" "$ro"; then
    printf '%s' "$origin"
  else
    printf '%s' "$BASE"
  fi
}

# gate_then_guards builder-agent label: gate with one fix round, then guardrails. 1 on failure.
gate_then_guards() {
  local agent=$1 gate_log="$WT/$RUN_DIR/gate-$2.log"
  if ! run_gate "$WT" "$GATE" "$gate_log"; then
    ask "$agent" "$(gate_fix_prompt "$gate_log")"
    run_gate "$WT" "$GATE" "$gate_log" || return 1
  fi
  local violations
  if ! violations=$(guard_check "$WT" "$(base_ref)"); then
    warn "guardrails failed after $2:"
    printf '%s\n' "$violations" >&2
    return 1
  fi
}

# regate builder-agent label: after a rebase, gate and guards must hold again.
regate() { gate_then_guards "$1" "rebase-$2" || die "gate or guardrails fail after the rebase; see $WT/$RUN_DIR"; }

pr_checks() { # -> markdown bullets describing what the run directory proves
  local d="$WT/$RUN_DIR" f v gates reviews
  shopt -s nullglob
  gates=("$d"/gate-*.log)
  reviews=("$d"/review-*.md)
  shopt -u nullglob
  if ((${#gates[@]})); then
    f=$(printf '%s\n' "${gates[@]}" | sort -V | tail -n1)
    printf -- '- Gate %s passed (%s)\n' "\`$GATE\`" "$(basename "$f" .log)"
  else
    printf -- '- Gate: not run by the factory\n'
  fi
  if ((${#reviews[@]})); then
    while IFS= read -r f; do
      v=$(verdict_of "$f") || v=NONE
      printf -- '- %s: %s\n' "$(basename "$f" .md)" "$v"
    done < <(printf '%s\n' "${reviews[@]}" | sort -V)
  fi
  [[ -e $d/allow-protected ]] && printf -- '- Protected-path check waived by the human\n'
  return 0
}

pr_body() {
  cat <<B
${TASK_DESC:-$TASK_TITLE}

Bead $TASK_ID.

$(pr_checks)

<details>
<summary>Plan</summary>

$(cat "$WT/$RUN_DIR/plan.md" 2>/dev/null || printf 'no plan file')

</details>
B
}

# gh_wt gh-args...: gh in the worktree, so {owner}/{repo} and the branch resolve from its origin.
gh_wt() { (cd "$WT" && gh "$@"); }

# existing_pr -> url of the branch's open pull request, empty if none
existing_pr() {
  gh_wt pr view "$BRANCH" --json url,state -q 'select(.state == "OPEN") | .url' 2>/dev/null || printf ''
}

raise_pr() { # builder-agent -> prints the PR url
  need gh
  git -C "$WT" remote get-url origin >/dev/null 2>&1 || die "$WT has no origin remote"
  local rc=0 url
  rebase_onto_base "$1" || rc=$?
  ((rc == 10)) && regate "$1" pr
  git -C "$WT" push -q -u --force-with-lease origin "$BRANCH" || die "could not push $BRANCH to origin"
  url=$(existing_pr)
  if [[ -n $url ]]; then
    log "pull request already open, reusing it"
    printf '%s\n' "$url"
    return 0
  fi
  gh_wt pr create --base "$BASE" --head "$BRANCH" --title "$TASK_ID: $TASK_TITLE" --body "$(pr_body)"
}

# ------------------------------------------------------------- copilot ----
# GitHub Copilot code review never approves formally; its review body starts with a verdict
# line such as "### 🟢 Approval recommended", and its inline comments are posted by the user
# "Copilot". Done means: the review of the head commit recommends approval, or has no comments.
copilot_request() { # pr-number
  gh_wt api -X POST "repos/{owner}/{repo}/pulls/$1/requested_reviewers" -f "reviewers[]=$COPILOT_BOT" >/dev/null
}

copilot_reviewed() { # pr-number sha -> 0 once Copilot reviewed that commit
  local n
  n=$(gh_wt api "repos/{owner}/{repo}/pulls/$1/reviews" \
    --jq "[.[] | select((.user.login | ascii_downcase | startswith(\"copilot\")) and .commit_id == \"$2\")] | length")
  [[ ${n:-0} -gt 0 ]]
}

copilot_wait() { # pr-number sha
  local waited=0
  until copilot_reviewed "$1" "$2"; do
    ((waited < FACTORY_COPILOT_WAIT_S)) || return 1
    sleep 30
    waited=$((waited + 30))
  done
}

# copilot_comments_of sha: the REST comments JSON on stdin as "path:line: body" lines, for Copilot's
# comments made on that commit. GitHub moves commit_id along with the head while a commented
# line survives; original_commit_id stays.
copilot_comments_of() { # sha
  jq -r --arg sha "$1" \
    '.[] | select(((.user.login // "") | ascii_downcase | startswith("copilot")) and .original_commit_id == $sha) | "\(.path):\(.line // .original_line // "?"): \(.body | gsub("\r"; "") | gsub("\n"; "\n    "))"'
}

# copilot_verdict_of: first line of Copilot's review body for one commit, from reviews JSON on stdin.
copilot_verdict_of() { # sha
  jq -r --arg sha "$1" \
    '[.[] | select(((.user.login // "") | ascii_downcase | startswith("copilot")) and .commit_id == $sha)] | last | (.body // "") | split("\n") | (.[0] // "") | ltrimstr("### ")'
}

copilot_verdict() { # pr-number sha
  gh_wt api "repos/{owner}/{repo}/pulls/$1/reviews" | copilot_verdict_of "$2"
}

# copilot_summary_of: the sentence under Copilot's verdict line, from reviews JSON on stdin.
copilot_summary_of() { # sha
  jq -r --arg sha "$1" \
    '[.[] | select(((.user.login // "") | ascii_downcase | startswith("copilot")) and .commit_id == $sha)] | last | (.body // "") | split("\n") | map(select(length > 0)) | (.[1] // "") | select(startswith("<") | not)'
}

copilot_summary() { # pr-number sha
  gh_wt api "repos/{owner}/{repo}/pulls/$1/reviews" | copilot_summary_of "$2"
}

copilot_comments() { # pr-number sha
  gh_wt api --paginate "repos/{owner}/{repo}/pulls/$1/comments" | copilot_comments_of "$2"
}

# copilot_reply_body round sha comments-file [response-file] -> one PR comment for the round
copilot_reply_body() {
  local round=$1 sha=$2 comments=$3 response=${4:-}
  printf 'Addressed Copilot review round %s in %s:\n\n' "$round" "${sha:0:7}"
  grep -oE '^[^ ]+:[0-9?]+:' "$comments" | sed 's/:$//; s/^/- /'
  if [[ -n $response && -s $response ]]; then
    printf '\nNot changed, and why:\n\n%s\n' "$(cat "$response")"
  fi
}

copilot_reply() { # pr-number round sha
  local body
  body=$(copilot_reply_body "$2" "$3" "$WT/$RUN_DIR/copilot-$2.md" "$WT/$RUN_DIR/copilot-$2-response.md")
  gh_wt pr comment "$1" --body "$body" >/dev/null || warn "could not comment on the PR"
}

# copilot_resolve pr-number sha: resolve Copilot's review threads that start on that commit.
copilot_resolve() {
  local ids id query mutation
  query=$(
    cat <<'Q'
query($owner: String!, $repo: String!, $pr: Int!) {
  repository(owner: $owner, name: $repo) { pullRequest(number: $pr) {
    reviewThreads(first: 100) { nodes { id isResolved
      comments(first: 1) { nodes { author { login } originalCommit { oid } } } } } } } }
Q
  )
  mutation=$(
    cat <<'Q'
mutation($id: ID!) { resolveReviewThread(input: {threadId: $id}) { thread { isResolved } } }
Q
  )
  ids=$(gh_wt api graphql -F owner='{owner}' -F repo='{repo}' -F pr="$1" -f query="$query" \
    --jq ".data.repository.pullRequest.reviewThreads.nodes[]
      | select(.isResolved | not)
      | select((.comments.nodes[0].author.login // \"\" | ascii_downcase | startswith(\"copilot\")) and .comments.nodes[0].originalCommit.oid == \"$2\")
      | .id") || {
    warn "could not list review threads"
    return 0
  }
  for id in $ids; do
    gh_wt api graphql -f query="$mutation" -F id="$id" >/dev/null || warn "could not resolve thread $id"
  done
  [[ -n $ids ]] && log "resolved $(grep -c '' <<<"$ids") Copilot thread(s)"
  return 0
}

copilot_fix_prompt() { # round
  cat <<P
GitHub Copilot reviewed the pull request and left the comments in $RUN_DIR/copilot-$1.md (file:line: comment).
Fix what is right. For anything you disagree with, say why in $RUN_DIR/copilot-$1-response.md instead.
The gate must pass: $GATE
Commit; do not push. Reply with just DONE.
P
}

# copilot_loop builder-agent pr-url: request reviews and act on comments until a review is clean.
copilot_loop() {
  local agent=$1 url=$2 n sha round=1 comments verdict
  n=${url##*/}
  while ((round <= FACTORY_COPILOT_ROUNDS)); do
    sha=$(git -C "$WT" rev-parse HEAD)
    copilot_request "$n" || {
      COPILOT_NOTE="Copilot review could not be requested"
      warn "$COPILOT_NOTE on $url"
      return 1
    }
    log "Copilot review requested for ${sha:0:7} (round $round)"
    copilot_wait "$n" "$sha" || {
      COPILOT_NOTE="no Copilot review within $((FACTORY_COPILOT_WAIT_S / 60)) min"
      warn "$COPILOT_NOTE"
      return 1
    }
    verdict=$(copilot_verdict "$n" "$sha")
    comments=$(copilot_comments "$n" "$sha")
    # Copilot's verdict line is the useful summary; keep it for the bead and the log.
    if [[ -z $comments ]]; then
      local summary
      summary=$(copilot_summary "$n" "$sha")
      COPILOT_NOTE="Copilot: ${verdict:-reviewed}${summary:+: $summary}"
      log "$COPILOT_NOTE"
      return 0
    fi
    if [[ $verdict == *"Approval recommended"* ]]; then
      COPILOT_NOTE="Copilot: $verdict, $(grep -c '' <<<"$comments") nit(s) left open"
      log "$COPILOT_NOTE"
      return 0
    fi
    log "Copilot: $verdict"
    printf '%s\n' "$comments" >"$WT/$RUN_DIR/copilot-$round.md"
    log "Copilot left $(grep -c '' "$WT/$RUN_DIR/copilot-$round.md") comment(s); asking the builder"
    ask "$agent" "$(copilot_fix_prompt "$round")"
    if [[ $(git -C "$WT" rev-parse HEAD) == "$sha" ]] && ! tree_dirty "$WT"; then
      copilot_reply "$n" "$round" "$sha" # the pushback alone; another review would say the same
      copilot_resolve "$n" "$sha"
      COPILOT_NOTE="Copilot's comments answered without changes"
      warn "$COPILOT_NOTE; see $url"
      return 1
    fi
    gate_then_guards "$agent" "copilot-$round" || {
      COPILOT_NOTE="gate or guardrails failed while addressing Copilot's comments"
      return 1
    }
    git -C "$WT" push -q || {
      COPILOT_NOTE="could not push the fixes for round $round"
      warn "$COPILOT_NOTE"
      return 1
    }
    copilot_reply "$n" "$round" "$(git -C "$WT" rev-parse HEAD)"
    copilot_resolve "$n" "$sha"
    round=$((round + 1))
  done
  COPILOT_NOTE="Copilot comments remain after $FACTORY_COPILOT_ROUNDS rounds"
  warn "$COPILOT_NOTE; see $url"
  return 1
}

