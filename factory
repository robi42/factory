# ----------------------------------------------------------- human gates ----
# human_gate plan|build agent dir: show the plan, or the branch's commits and diff stat,
# and wait for the human: an answer in this terminal, or the files `factory approve` and
# `factory reject` write into dir. A plan note goes to the planner and the plan is shown
# again; a build note is left in HUMAN_NOTE and 4 is returned for another round. 3 aborts.
human_gate() {
  local kind=$1 agent=$2 dir=$3 answer note stdin_open=1 rc keys='a, p, r or b'
  [[ $FACTORY_APPROVAL == ask ]] || return 0
  [[ $kind == plan ]] || keys='a, r or b'
  rm -f "$dir/approved" "$dir/reject.md"
  while :; do
    toast "$TASK_ID $kind ready" "$TASK_TITLE. Approve it in the Factory terminal or with: factory approve" request
    show_for_approval "$kind" "$dir"
    while :; do
      if [[ -s $dir/reject.md ]]; then
        note=$(<"$dir/reject.md")
        rm -f "$dir/reject.md"
        printf '\n' >&2
        log "note received via file"
        take_note "$kind" "$agent" "$note" || return $?
        continue 2
      fi
      if [[ -e $dir/approved ]]; then
        rm -f "$dir/approved"
        printf '\n' >&2
        log "approved via file"
        return 0
      fi
      if ((stdin_open)); then
        rc=0
        read -r -t "$FACTORY_POLL_SECONDS" answer || rc=$?
        if ((rc == 0)); then
          case $answer in
            a | A) return 0 ;;
            p | P)
              if [[ $kind == plan ]]; then
                : >"$dir/allow-protected"
                log "protected-path check waived for this task"
                return 0
              fi
              ;;
            r | R)
              printf '%s note for the %s: ' "$TAG" "$(role_of "$kind")" >&2
              read -r note || return 3
              if [[ -n $note ]]; then
                take_note "$kind" "$agent" "$note" || return $?
                continue 2
              fi
              ;;
            b | B) return 3 ;;
          esac
          printf '%s %s? ' "$TAG" "$keys" >&2 # only the keys shown mean anything; ask again in place
        elif ((rc <= 128)); then
          stdin_open=0
          printf '\n' >&2
          log "no terminal to answer from; waiting for: factory approve <repo> $TASK_ID  (or reject)"
        fi
      else
        sleep "$FACTORY_POLL_SECONDS"
      fi
    done
  done
}

role_of() { case $1 in plan) printf planner ;; *) printf builder ;; esac }

# take_note kind agent note: a plan note goes straight to the planner; a build note ends
# the gate with 4 so the caller runs another round
take_note() {
  case $1 in
    plan) ask "$2" "$(plan_note_prompt "$3")" ;;
    build)
      HUMAN_NOTE=$3
      return 4
      ;;
  esac
}

# show_md file: Markdown for the human, rendered by glow when it is installed. glow reads
# stdin instead of the file whenever stdin is not a terminal, and the human's answer may be
# waiting there, so it gets none.
show_md() {
  if command -v glow >/dev/null 2>&1; then glow "$1" </dev/null >&2; else sed 's/^/    /' "$1" >&2; fi
}

show_for_approval() { # kind dir
  printf '\n%s ' "$TAG" >&2
  if [[ $1 == plan ]]; then
    printf 'plan for %s (%s):\n\n' "$TASK_ID" "$2/plan.md" >&2
    show_md "$2/plan.md"
    if [[ -s $2/plan-changes.md ]]; then # written by the planner after a note; shown once
      printf '\n%s what the planner changed after your note (%s):\n\n' "$TAG" "$2/plan-changes.md" >&2
      show_md "$2/plan-changes.md"
      rm -f "$2/plan-changes.md"
    fi
    printf '\n%s [a]pprove (edit the file or talk to the planner first if you like), a[p]prove and allow protected paths, [r]evise with a note, a[b]ort? (a/p/r/b) ' "$TAG" >&2
  else
    printf 'build for %s on %s, reviews in %s:\n\n' "$TASK_ID" "$BRANCH" "$2" >&2
    {
      git -C "$WT" log --oneline "$(base_ref)..HEAD"
      git -C "$WT" diff --stat "$(base_ref)...HEAD"
    } 2>/dev/null | sed 's/^/    /' >&2 || warn "could not show the branch"
    printf '\n%s [a]pprove (look at the worktree or talk to the builder first if you like), [r]evise with a note, a[b]ort? (a/r/b) ' "$TAG" >&2
  fi
}

# collect_answers questions-file: show the planner's questions and wait for the human.
# Answers come from this terminal (lines until one containing only ".") or from
# `factory answer`, which writes answers.md next to the questions. Prints the answers.
collect_answers() {
  local q=$1 dir line stdin_open=1 rc answers=""
  dir=$(dirname "$q")
  rm -f "$dir/answers.md"
  toast "$TASK_ID has questions" "$TASK_TITLE. Answer in the Factory terminal or with: factory answer" request
  printf '\n%s the planner asks (%s):\n\n' "$TAG" "$q" >&2
  show_md "$q"
  printf '\n%s answer below, finish with a line containing only "."  (or: factory answer <repo> %s "...")\n' "$TAG" "$TASK_ID" >&2
  while :; do
    if [[ -s $dir/answers.md ]]; then
      answers=$(<"$dir/answers.md")
      rm -f "$dir/answers.md"
      log "answers received via file"
      printf '%s' "$answers"
      return 0
    fi
    if ((stdin_open)); then
      rc=0
      read -r -t "$FACTORY_POLL_SECONDS" line || rc=$?
      if ((rc == 0)); then
        [[ $line == . ]] && break
        answers+="${answers:+$'\n'}$line"
      elif ((rc <= 128)); then
        stdin_open=0
        [[ -n $answers ]] && break
        log "no terminal to answer from; waiting for: factory answer <repo> $TASK_ID \"...\""
      fi
    else
      sleep "$FACTORY_POLL_SECONDS"
    fi
  done
  [[ -n $answers ]] || return 3
  printf '%s' "$answers"
}

# planner_kept_hands_off planner-agent: the planner must not change code; give it one chance to revert.
planner_kept_hands_off() {
  tree_dirty "$WT" || return 0
  warn "the planner changed files; asking it to revert"
  ask "$1" "You changed files in the worktree, but planning must leave the code untouched (only $RUN_DIR/ is yours). Revert every change outside $RUN_DIR/ (git checkout -- . and remove new files), keep the plan, and reply DONE."
  tree_dirty "$WT" || return 0
  die "the planner left changes in $WT; planning must not touch code"
}

# plan_or_interview planner-agent: ask for a plan; relay questions and answers until one exists.
plan_or_interview() {
  local plan_agent=$1 q="$WT/$RUN_DIR/questions.md" file="$WT/$RUN_DIR/plan.md" rounds=0 answers
  rm -f "$q"
  ask "$plan_agent" "$(plan_prompt)"
  while [[ ! -s $file ]]; do
    if [[ -s $q ]]; then
      rounds=$((rounds + 1))
      ((rounds <= 3)) || die "planner still has questions after 3 rounds; talk to it in its pane"
      log "planner has questions (round $rounds)"
      answers=$(collect_answers "$q") || return 3
      rm -f "$q"
      ask "$plan_agent" "$(answers_prompt "$answers")"
    else
      warn "$plan_agent replied but wrote neither plan.md nor questions.md; asking again"
      ask "$plan_agent" "You replied, but neither $RUN_DIR/plan.md nor $RUN_DIR/questions.md exists. Write one of them and reply again."
      [[ -s $file || -s $q ]] || die "$plan_agent never wrote $RUN_DIR/plan.md"
    fi
  done
}

# ------------------------------------------------------------ workspace ----
# worktrees_dir -> Herdr's worktree directory ([worktrees] directory in its config, else its default)
worktrees_dir() {
  local d
  d=$(awk -F'"' '/^\[worktrees\]/ {in_section = 1; next} /^\[/ {in_section = 0} in_section && /^directory *=/ {print $2}' "${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}" 2>/dev/null)
  d=${d:-~/.herdr/worktrees}
  printf '%s' "${d/#\~/$HOME}"
}

worktree_of() { # repo bead-id -> checkout path of the task's branch, empty if none
  git -C "$1" worktree list --porcelain | awk -v b="^refs/heads/factory/$2(-|$)" '$1 == "worktree" {p = $2} $1 == "branch" && $2 ~ b {print p}'
}

# worktree_path repo bead-id -> where the task's checkout goes: <worktrees dir>/<repo>/factory-<id>,
# short on purpose; the branch carries the title slug, the directory does not.
worktree_path() { printf '%s/%s/factory-%s' "$(worktrees_dir)" "$(basename "$1")" "$2"; }

open_workspace() { # repo branch label -> WS WT BUILD_PANE
  local out
  # Herdr checks out an existing branch too; open is the fallback for a checkout that already exists.
  if ! out=$(herdr worktree create --cwd "$1" --branch "$2" --path "$(worktree_path "$1" "$TASK_ID")" --label "$3" --no-focus 2>&1); then
    log "worktree create failed ($(herr_msg "$out" | tail -n1)); trying to open it"
    out=$(h worktree open --cwd "$1" --branch "$2" --label "$3" --no-focus)
  fi
  WS=$(jq -r '.result.workspace.workspace_id' <<<"$out")
  WT=$(jq -r '.result.worktree.path' <<<"$out")
  BUILD_PANE=$(jq -r '.result.root_pane.pane_id' <<<"$out")
  [[ -n $WS && -n $WT && -n $BUILD_PANE ]] || die "unexpected worktree response: $out"
}

# ------------------------------------------------------------- pipeline ----
# Shared task state: setup_task sets TASK_ID TASK_TITLE TASK_DESC GATE BASE BRANCH MEMORY and
#   PLAN_AGENT BUILD_AGENT REVIEW_AGENT; open_task_workspace sets WS WT BUILD_PANE; build_phase
#   (run_task on resume) sets ROUND VERDICT GATE_LOG; HUMAN_NOTE, COPILOT_NOTE and STEP pass
#   between the human gates, the Copilot loop and on_interrupt.

# task_context repo: from TASK_ID and TASK_TITLE, derive GATE BASE BRANCH and the agent names.
task_context() {
  local slug
  GATE=$(resolve_gate "$1")
  BASE=$(git -C "$1" rev-parse --abbrev-ref HEAD)
  BRANCH=$(branch_of "$1" "$TASK_ID")
  if [[ -z $BRANCH ]]; then
    slug=$(slugify "$TASK_TITLE")
    BRANCH="factory/$TASK_ID${slug:+-$slug}"
  fi
  PLAN_AGENT="$TASK_ID-plan"
  BUILD_AGENT="$TASK_ID-build"
  REVIEW_AGENT="$TASK_ID-review"
}

setup_task() { # repo arg
  local repo=$1 arg=$2 st
  resolve_task "$repo" "$arg"
  task_context "$repo"
  MEMORY=$(memory_block "$repo")
  log "task $TASK_ID: $TASK_TITLE"
  log "models: plan=$FACTORY_PLAN_MODEL build=$FACTORY_BUILD_MODEL review=$FACTORY_REVIEW_MODEL"
  log "gate: $GATE$([[ -n ${FACTORY_GATE:-} || -f $repo/.factory/gate ]] || printf ' (detected from the repo; add .factory/gate to make it explicit)') | base: $BASE | rounds: $FACTORY_ROUNDS | claude: $FACTORY_CLAUDE_PERMISSIONS"
  if ! bd -C "$repo" update "$TASK_ID" --claim >/dev/null 2>&1; then
    st=$(bd_field "$repo" "$TASK_ID" '.status')
    die "cannot claim $TASK_ID (status: ${st:-unknown}); reopen it with: bd -C $repo reopen $TASK_ID"
  fi
}

open_task_workspace() { # repo
  local exclude
  open_workspace "$1" "$BRANCH" "$TASK_ID $TASK_TITLE"
  mkdir -p "$WT/$RUN_DIR"
  exclude="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  grep -qsxF '.factory/run/' "$exclude" || printf '.factory/run/\n' >>"$exclude"
  log "workspace $WS at $WT"
}

# start_or_adopt_agents repo: three agents in three panes, or the task's live ones on a rerun.
start_or_adopt_agents() {
  local repo=$1 live plan_pane review_pane pane repo_root
  live=$(live_agents "$WS" "$PLAN_AGENT" "$BUILD_AGENT" "$REVIEW_AGENT")
  if [[ $live == 3 ]]; then
    log "reusing the live agents of $TASK_ID in workspace $WS"
    settle_dialogs "$PLAN_AGENT" quiet
    settle_dialogs "$BUILD_AGENT" quiet
    settle_dialogs "$REVIEW_AGENT" quiet
    return 0
  fi
  [[ $live == 0 ]] || die "some agents of $TASK_ID are still alive in workspace $WS; run: factory clean $repo $TASK_ID --force"
  close_extra_panes "$WS" "$BUILD_PANE"
  # builder left, planner over reviewer right; equal columns, the planner a little taller
  plan_pane=$(h pane split --pane "$BUILD_PANE" --direction right --ratio 0.5 --cwd "$WT" --no-focus | jq -r '.result.pane.pane_id')
  review_pane=$(h pane split --pane "$plan_pane" --direction down --ratio 0.6 --cwd "$WT" --no-focus | jq -r '.result.pane.pane_id')
  h pane rename "$BUILD_PANE" build >/dev/null
  h pane rename "$plan_pane" plan >/dev/null
  h pane rename "$review_pane" review >/dev/null
  sleep 1
  # Give the agents the factory's PATH (bd, gate tools) via a short command; a long
  # inline export trips line editors such as ble.sh into multiline mode.
  printf "export PATH='%s'\n" "$PATH" >"$WT/$RUN_DIR/env.sh"
  for pane in "$BUILD_PANE" "$plan_pane" "$review_pane"; do
    prime_shell "$pane"
  done
  repo_root=$(git -C "$repo" rev-parse --show-toplevel)
  start_agent "$PLAN_AGENT" claude "$plan_pane" --model "$FACTORY_PLAN_MODEL" --permission-mode "$FACTORY_CLAUDE_PERMISSIONS" --name plan
  start_agent "$BUILD_AGENT" claude "$BUILD_PANE" --model "$FACTORY_BUILD_MODEL" --permission-mode "$FACTORY_CLAUDE_PERMISSIONS" --name build
  set_color "$PLAN_AGENT" purple
  set_color "$BUILD_AGENT" cyan
  start_agent "$REVIEW_AGENT" codex "$review_pane" -m "$FACTORY_REVIEW_MODEL" -a never -s workspace-write --search \
    -c "projects.\"$repo_root\".trust_level=\"trusted\"" \
    -c "sandbox_workspace_write.writable_roots=[\"$repo_root/.beads\"]"
  log "agents up: $PLAN_AGENT $BUILD_AGENT $REVIEW_AGENT"
}

# Resume: the run directory records the last completed milestone ("planned" once the human
# approved the plan, "built <round>" once the reviews approved the build). A rerun skips
# what is done; --fresh starts over.
mark() { printf '%s\n' "$*" >"$WT/$RUN_DIR/state"; }
resume_point() { # -> reviewed | planned | built <round> | (empty)
  if ((FACTORY_FRESH)); then
    rm -f "$WT/$RUN_DIR/state"
    return 0
  fi
  cat "$WT/$RUN_DIR/state" 2>/dev/null || printf ''
}

# stop_task repo what: a human gate ended the run; leave the workspace for them.
stop_task() {
  bd_note "$1" "$TASK_ID" "stopped at $2. workspace $WS, worktree $WT"
  die "stopped at $2 for $TASK_ID; the workspace stays open"
}

# plan_phase repo: plan (with questions), dual plan review, one revision, human approval.
plan_phase() {
  local verdict
  log "planning"
  plan_or_interview "$PLAN_AGENT" || stop_task "$1" "planner questions"
  planner_kept_hands_off "$PLAN_AGENT"
  log "plan review: $REVIEW_AGENT and $BUILD_AGENT"
  ask_for_file "$REVIEW_AGENT" "$(plan_review_prompt)" "$WT/$RUN_DIR/plan-review.md"
  ask_for_file "$BUILD_AGENT" "$(plan_build_check_prompt)" "$WT/$RUN_DIR/plan-review-build.md"
  verdict=$(verdicts "$WT/$RUN_DIR/plan-review.md" "$WT/$RUN_DIR/plan-review-build.md")
  log "plan verdicts: $verdict"
  if [[ $verdict != "APPROVE APPROVE" ]]; then
    log "plan revision"
    ask "$PLAN_AGENT" "$(plan_fix_prompt)"
    planner_kept_hands_off "$PLAN_AGENT"
  fi
  mark reviewed
  approve_plan "$1"
}

# approve_plan repo: your gate on the reviewed plan. An abort here leaves the reviewed
# marker, so a rerun comes straight back to this prompt instead of planning again.
approve_plan() {
  human_gate plan "$PLAN_AGENT" "$WT/$RUN_DIR" || stop_task "$1" "plan approval"
  mark planned
}

# build_phase repo [resume]: build, then gate, guardrails, dual review and the human's
# approval per round. Sets ROUND VERDICT GATE_LOG.
build_phase() {
  local repo=$1 violations rc
  log "building"
  if [[ ${2:-} == resume ]]; then
    ask "$BUILD_AGENT" "$(build_prompt) Part of it may already be implemented or committed on this branch from an earlier run; check the branch and continue from there."
  else
    ask "$BUILD_AGENT" "$(build_prompt)"
  fi
  ROUND=1
  VERDICT=""
  while ((ROUND <= FACTORY_ROUNDS)); do
    GATE_LOG="$WT/$RUN_DIR/gate-$ROUND.log"
    if ! run_gate "$WT" "$GATE" "$GATE_LOG"; then
      ask "$BUILD_AGENT" "$(gate_fix_prompt "$GATE_LOG")"
      ROUND=$((ROUND + 1))
      continue
    fi
    if ! violations=$(guard_check "$WT" "$(base_ref)"); then
      warn "guardrails: $violations"
      ask "$BUILD_AGENT" "$(guard_fix_prompt "$violations")"
      ROUND=$((ROUND + 1))
      continue
    fi
    log "review round $ROUND: $REVIEW_AGENT and $PLAN_AGENT"
    ask_for_file "$REVIEW_AGENT" "$(review_prompt "$ROUND")" "$WT/$RUN_DIR/review-$ROUND.md"
    ask_for_file "$PLAN_AGENT" "$(plan_check_prompt "$ROUND")" "$WT/$RUN_DIR/review-$ROUND-plan.md"
    VERDICT=$(verdicts "$WT/$RUN_DIR/review-$ROUND.md" "$WT/$RUN_DIR/review-$ROUND-plan.md")
    log "verdicts: $VERDICT"
    if [[ $VERDICT == "APPROVE APPROVE" ]]; then
      rc=0
      human_gate build "$BUILD_AGENT" "$WT/$RUN_DIR" || rc=$?
      case $rc in
        0)
          VERDICT=APPROVE
          mark built "$ROUND"
          return 0
          ;;
        4)
          VERDICT=REVISE
          log "note for the builder; another round"
          ask "$BUILD_AGENT" "$(build_note_prompt "$HUMAN_NOTE")"
          ROUND=$((ROUND + 1))
          continue
          ;;
        *) stop_task "$repo" "build approval" ;;
      esac
    fi
    VERDICT=REVISE
    ask "$BUILD_AGENT" "$(revise_prompt "$ROUND")"
    ROUND=$((ROUND + 1))
  done
}

# finish_task repo: memories, then close the bead (with PR and Copilot review) or hand over.
finish_task() {
  local repo=$1 pr="" next="merge $BRANCH" copilot=""
  local summary="branch $BRANCH, worktree $WT, herdr workspace $WS, rounds used: $ROUND, verdict: ${VERDICT:-none}"
  ask "$BUILD_AGENT" "$(memory_prompt)"
  if [[ $VERDICT != APPROVE ]] || [[ ! -f $GATE_LOG ]] || ! guard_check "$WT" "$(base_ref)" >/dev/null; then
    bd_note "$repo" "$TASK_ID" "needs a human. $summary"
    toast "$TASK_ID needs you" "$TASK_TITLE. See workspace $WS." request
    warn "not approved after $FACTORY_ROUNDS rounds: $summary"
    bd_push "$repo"
    return 2
  fi
  if ((FACTORY_PR)); then
    pr=$(raise_pr "$BUILD_AGENT")
    next="review $pr"
    log "opened $pr"
    if ((FACTORY_COPILOT)); then
      COPILOT_NOTE=""
      copilot_loop "$BUILD_AGENT" "$pr" || warn "Copilot loop ended without a clean review: $COPILOT_NOTE"
      copilot=", $COPILOT_NOTE"
    fi
  fi
  bd_note "$repo" "$TASK_ID" "approved. $summary${pr:+, pr $pr}$copilot"
  bd -C "$repo" close "$TASK_ID" -r "Factory: gate green, review approved; $next" >/dev/null
  toast "$TASK_ID done" "$TASK_TITLE. ${next^}." "done"
  log "done: $summary${pr:+, pr $pr}"
  rm -f "$WT/$RUN_DIR/state"
  bd_push "$repo"
}

# on_interrupt repo: the run was killed or Ctrl-C'd; leave a note on the bead, the state
# lives in the worktree and the agents, and the same command resumes.
on_interrupt() {
  trap - INT TERM
  printf '\n' >&2
  warn "interrupted during $STEP; workspace ${WS:-?} stays open, rerun the same command to continue"
  [[ -n ${TASK_ID:-} ]] && bd_note "$1" "$TASK_ID" "interrupted during $STEP. workspace ${WS:-?}, worktree ${WT:-?}; rerun the same command" 2>/dev/null
  exit 130
}

run_task() { # repo arg
  local repo
  repo=$(cd "$1" && pwd)
  git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$repo is not a git repo"
  STEP=setup
  trap 'on_interrupt "$repo"' INT TERM
  setup_task "$repo" "$2"
  open_task_workspace "$repo"
  STEP=agents
  start_or_adopt_agents "$repo"
  local point
  point=$(resume_point)
  [[ -z $point ]] || log "resuming after: $point (use --fresh to start over)"
  case $point in
    built*)
      VERDICT=APPROVE
      ROUND=${point#built }
      GATE_LOG="$WT/$RUN_DIR/gate-$ROUND.log"
      ;;
    reviewed)
      STEP=planning
      approve_plan "$repo"
      STEP=building
      build_phase "$repo"
      ;;
    planned)
      STEP=building
      build_phase "$repo" resume
      ;;
    *)
      STEP=planning
      plan_phase "$repo"
      STEP=building
      build_phase "$repo"
      ;;
  esac
  STEP=finishing
  finish_task "$repo"
  trap - INT TERM
}

# --------------------------------------------------------------- commands ----
cmd_doctor() {
  local ok=0 t
  for t in "${RUN_TOOLS[@]}"; do
    if command -v "$t" >/dev/null 2>&1; then printf '  ok       %s\n' "$t"; else
      printf '  MISSING  %s\n' "$t"
      ok=1
    fi
  done
  if herdr agent list >/dev/null 2>&1; then printf '  ok       herdr server\n'; else
    printf '  MISSING  herdr server (start herdr first)\n'
    ok=1
  fi
  # Claude Code runs its shell commands from a fresh login shell, not the pane's environment,
  # so bd must resolve there (e.g. mise use -g, or a symlink in ~/.local/bin).
  if bash -lc 'bd version' >/dev/null 2>&1; then printf '  ok       bd from a fresh login shell\n'; else
    printf '  MISSING  bd from a fresh login shell (agents will not be able to use beads)\n'
    ok=1
  fi
  [[ -f $FACTORY_GUARDRAILS ]] && printf '  ok       guardrails %s\n' "$FACTORY_GUARDRAILS"
  return $ok
}

cmd_status() {
  local color=0 name status ws task role c reset='' labels last=""
  [[ -t 1 ]] && color=1
  ((color)) && reset=$'\033[0m'
  labels=$(h workspace list | jq -r '.result.workspaces[] | "\(.workspace_id)\t\(.label)"')
  local rows
  rows=$(h agent list | jq -r '.result.agents[] | select(.name // "" | test("-(plan|build|review)$")) |
    "\(.name)\t\(.agent_status)\t\(.workspace_id)"' | sort)
  if [[ -z $rows ]]; then
    log "no factory agents running"
    return 0
  fi
  printf '%-14s %-8s %-9s %-5s %s\n' TASK ROLE STATE WS LABEL
  while IFS=$'\t' read -r name status ws; do
    task=${name%-*}
    role=${name##*-}
    c=""
    if ((color)); then
      case $status in
        working) c=$'\033[36m' ;;
        idle | done) c=$'\033[32m' ;;
        blocked) c=$'\033[31m' ;;
        *) c=$'\033[2m' ;;
      esac
    fi
    printf '%-14s %-8s %s%-9s%s %-5s %s\n' "$task" "$role" "$c" "$status" "$reset" "$ws" \
      "$([[ $task != "$last" ]] && awk -F'\t' -v w="$ws" '$1 == w {print $2}' <<<"$labels" | sed "s/^$task //")"
    last=$task
  done <<<"$rows"
}

cmd_init() {
  local repo=$1
  shift
  [[ -d $repo/.git ]] || die "$repo is not a git repo"
  git -C "$repo" config beads.role >/dev/null 2>&1 || git -C "$repo" config beads.role maintainer
  if [[ -d $repo/.beads ]]; then log "beads already set up in $repo"; else
    # No generated AGENTS.md/CLAUDE.md, hooks, or editor files: the prompts carry what agents need.
    (cd "$repo" && BD_NON_INTERACTIVE=1 bd init --non-interactive --skip-agents --skip-hooks "$@")
  fi
  local gate
  if [[ -f $repo/.factory/gate ]]; then
    log "gate: .factory/gate already exists"
  elif gate=$(detect_gate "$repo"); then
    write_gate "$repo" "$gate"
    log "wrote .factory/gate running: $gate  (review it, then commit it; runs need it committed)"
  else
    warn "no gate detected: write $repo/.factory/gate (a script that runs your checks) and commit it"
  fi
  if [[ ! -e $repo/AGENTS.md && ! -e $repo/CLAUDE.md ]]; then
    write_agents_stub "$repo"
    log "wrote a short AGENTS.md stub (CLAUDE.md links to it); fill in what the code cannot tell a new engineer"
  fi
}

write_agents_stub() { # repo
  local gate
  gate=$(find_gate "$1") || gate="<your gate command>"
  cat >"$1/AGENTS.md" <<STUB
# $(basename "$1")

One or two lines on what this project is.

## Run and verify

- Gate: \`$gate\` must pass. It is the definition of done.

## Layout

- Short notes on where things live, only where the tree is not self-explanatory.

## Rules that the code cannot tell you

- What not to touch, and why.
- External systems, credentials, environments.
- Deliberate odd choices and their reasons.
STUB
  ln -s AGENTS.md "$1/CLAUDE.md"
}

# compose_task: title on the first line, blank line, description. Uses $VISUAL/$EDITOR
# when there is a terminal, otherwise reads the same format from stdin (until Ctrl-D).
# Sets TASK_TITLE and TASK_DESC; fails on an empty title.
compose_task() {
  local editor=${VISUAL:-${EDITOR:-}} f body
  f=$(mktemp)
  if [[ -n $editor && -t 0 ]]; then
    printf '\n\n# First line: title. Then a blank line and the description (markdown is fine).\n# Lines starting with # are dropped. An empty title aborts.\n' >"$f"
    ${editor} "$f"
  else
    log "title on the first line, blank line, then the description; finish with Ctrl-D"
    cat >"$f"
  fi
  body=$(grep -vE '^#' "$f") || body=""
  rm -f "$f"
  TASK_TITLE=$(sed -n '/[^[:space:]]/{p;q}' <<<"$body" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [[ -n $TASK_TITLE ]] || die "empty title, nothing filed"
  TASK_DESC=$(sed '1,/[^[:space:]]/d' <<<"$body" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' | sed '/./,$!d')
}

cmd_add() {
  local repo=$1
  shift
  need_beads "$repo"
  if (($# == 0)); then
    compose_task
  else
    TASK_TITLE=$1
    TASK_DESC=${2:-}
  fi
  bd -C "$repo" create "$TASK_TITLE" -d "$TASK_DESC" -q # -q drops bd's tip about its own agent integration
  bd_push "$repo"
}

cmd_sync() { # repo: pull (when the remote has beads data), then push
  local repo=$1 out
  need_beads "$repo"
  if out=$(bd -C "$repo" dolt pull 2>&1); then
    log "beads: $(tail -n1 <<<"$out")"
  elif [[ $out == *"no branches found"* ]]; then
    log "beads: remote has no beads data yet, nothing to pull"
  else
    die "beads pull failed: $(tail -n1 <<<"$out")"
  fi
  FACTORY_BD_PUSH=1 bd_push "$repo"
}

cmd_tasks() { # repo [bd list args...]
  local repo=$1
  shift
  need_beads "$repo"
  bd -C "$repo" list "$@"
}

cmd_next() {
  local repo=$1 id
  # --claim is atomic, so several fy next in parallel never pick the same bead
  id=$(bd -C "$repo" ready --claim --json 2>/dev/null | jq -r 'if type == "array" then .[0].id // empty else .id // empty end') || id=""
  [[ -n $id ]] || {
    log "nothing ready in $repo"
    return 3
  }
  run_task "$repo" "$id"
}

cmd_queue() {
  local repo=$1 max=${2:-0} n=0 rc
  while ((max == 0 || n < max)); do
    rc=0
    cmd_next "$repo" || rc=$?
    ((rc == 3)) && break
    ((rc == 0)) || warn "task stopped with status $rc; continuing with the next one"
    n=$((n + 1))
  done
  log "queue finished after $n task(s)"
}

# task_run_dir repo bead-id -> the task's .factory/run directory, or die. The human-gate
# commands below talk to a waiting run by writing files there.
task_run_dir() {
  local wt
  wt=$(worktree_of "$1" "$2")
  [[ -n $wt ]] || die "no worktree for task $2 in $1"
  printf '%s/%s' "$wt" "$RUN_DIR"
}

cmd_approve() { # repo bead-id [--allow-protected]
  local dir
  dir=$(task_run_dir "$1" "$2") || return 1
  if [[ ${3:-} == --allow-protected ]]; then
    : >"$dir/allow-protected"
    log "protected-path check waived for $2"
  fi
  : >"$dir/approved"
  log "approved $2"
}

cmd_reject() { # repo bead-id note
  local dir
  dir=$(task_run_dir "$1" "$2") || return 1
  printf '%s\n' "$3" >"$dir/reject.md"
  log "sent your note to $2"
}

cmd_answer() { # repo bead-id [text | -]
  local dir text=${3:-}
  dir=$(task_run_dir "$1" "$2") || return 1
  if [[ -z $text || $text == - ]]; then text=$(cat); fi
  [[ -n $text ]] || die "empty answer"
  printf '%s\n' "$text" >"$dir/answers.md"
  log "sent your answers to the planner of $2"
}

cmd_pr() { # repo bead-id: open a pull request for an existing task branch
  local repo url note=""
  repo=$(cd "$1" && pwd)
  WT=$(worktree_of "$repo" "$2")
  [[ -n $WT ]] || die "no worktree for task $2 in $repo"
  TASK_ID=$2
  TASK_TITLE=$(bd_field "$repo" "$2" '.title')
  TASK_DESC=$(bd_field "$repo" "$2" '.description // ""')
  task_context "$repo"
  tree_dirty "$WT" && die "$WT has uncommitted changes"
  herdr agent get "$BUILD_AGENT" >/dev/null 2>&1 || die "no live builder agent for $2 to handle a rebase; rebase by hand, or rerun the task"
  url=$(raise_pr "$BUILD_AGENT")
  log "opened $url"
  if ((FACTORY_COPILOT)); then
    COPILOT_NOTE=""
    copilot_loop "$BUILD_AGENT" "$url" || warn "Copilot loop ended without a clean review: $COPILOT_NOTE"
    note=", $COPILOT_NOTE"
  fi
  bd_note "$repo" "$2" "pull request opened by hand: $url$note"
  bd_push "$repo"
  printf '%s\n' "$url"
}

# merged_into repo branch base: 0 when the branch is merged (ancestor of base, or its PR merged).
merged_into() {
  local repo=$1 branch=$2 base=$3
  git -C "$repo" merge-base --is-ancestor "refs/heads/$branch" "refs/heads/$base" 2>/dev/null && return 0
  if git -C "$repo" remote get-url origin >/dev/null 2>&1 && command -v gh >/dev/null 2>&1; then
    [[ $(cd "$repo" && gh pr view "$branch" --json state -q .state 2>/dev/null) == MERGED ]] && return 0
  fi
  return 1
}

# cmd_clean repo [bead-id] [--force]: remove finished task workspaces, worktrees and branches.
cmd_clean() {
  local repo only="" force=0 a base ws branch path id status why n=0
  repo=$(cd "$1" && pwd)
  shift
  for a in "$@"; do
    case $a in
      --force) force=1 ;;
      *) only=$a ;;
    esac
  done
  base=$(git -C "$repo" rev-parse --abbrev-ref HEAD)
  # every factory branch, with its Herdr workspace and checkout when there is one
  while IFS='|' read -r branch ws path; do
    [[ -n $branch ]] || continue
    id=$(bead_of_branch "$branch")
    [[ -z $only || $only == "$id" ]] || continue
    if ((force)) || merged_into "$repo" "$branch" "$base"; then
      if [[ -n $ws ]]; then
        h worktree remove --workspace "$ws" --force >/dev/null
      elif [[ -n $path ]]; then
        git -C "$repo" worktree remove --force "$path"
      fi
      git -C "$repo" worktree prune
      git -C "$repo" branch -D "$branch" >/dev/null
      status=$(bd_field "$repo" "$id" '.status' 2>/dev/null) || status=""
      if [[ -n $status && $status != closed ]]; then
        why=merged
        ((force)) && why=dropped
        bd -C "$repo" close "$id" -r "Factory clean: branch $branch $why" >/dev/null
      fi
      log "cleaned $branch${ws:+ (workspace $ws)}"
      n=$((n + 1))
    else
      log "keeping $branch: not merged into $base (factory clean $repo $id --force to drop it)"
    fi
  done < <(clean_targets "$repo")
  git -C "$repo" worktree prune # stale entries from anywhere, not only ours
  log "cleaned $n task branch(es)"
  ((n == 0)) || bd_push "$repo"
}

# clean_targets repo -> "branch|workspace|path" for every factory/* branch (fields may be empty)
clean_targets() {
  local repo=$1 known
  known=$(herdr worktree list --cwd "$repo" 2>/dev/null | jq -r '.result.worktrees[]? | select((.branch // "") | startswith("factory/")) | "\(.branch)|\(.open_workspace_id // "")|\(.path)"') || known=""
  git -C "$repo" branch --list 'factory/*' --format='%(refname:short)' | while IFS= read -r branch; do
    grep -m1 -F "$branch|" <<<"$known" || printf '%s||%s\n' "$branch" "$(worktree_of "$repo" "$(bead_of_branch "$branch")")"
  done
}

cmd_check() { # worktree base
  local gate
  gate=$(resolve_gate "$1")
  CHECK_LOG=$(mktemp)
  trap 'rm -f "$CHECK_LOG"' EXIT
  run_gate "$1" "$gate" "$CHECK_LOG" || {
    tail -n 40 "$CHECK_LOG"
    return 1
  }
  guard_check "$1" "$2" && log "guardrails passed"
}

# load_repo_env repo: FACTORY_NAME=value lines from repo/.factory/env set the knobs the
# environment left unset. Parsed, never sourced: values are taken verbatim, no quotes, no
# expansion; blank lines and # comments are skipped; anything else is an error.
load_repo_env() {
  local file=$1/.factory/env line name applied=()
  [[ -f $file ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    [[ $line =~ ^(FACTORY_[A-Z0-9_]+)=(.*)$ ]] || die "$file: expected FACTORY_NAME=value, got: $line"
    name=${BASH_REMATCH[1]}
    [[ $name == FACTORY_HOME || $name == FACTORY_VERSION ]] && die "$file: $name is not a knob"
    grep -qxF "$name" <<<"$ENV_KNOBS" && continue
    printf -v "$name" '%s' "${BASH_REMATCH[2]}"
    applied+=("$name")
  done <"$file"
  ((${#applied[@]})) && log "knobs from $file: ${applied[*]}"
  return 0
}

# take_flags args...: consume --pr, --auto, --no-copilot and --fresh anywhere in the args; the rest land in ARGS.
take_flags() {
  ARGS=()
  local a
  for a in "$@"; do
    case $a in
      --pr) FACTORY_PR=1 ;;
      --no-copilot) FACTORY_COPILOT=0 ;;
      --auto) FACTORY_APPROVAL=auto ;;
      --fresh) FACTORY_FRESH=1 ;;
      --*) die "unknown flag: $a" ;;
      *) ARGS+=("$a") ;;
    esac
  done
}

main() {
  local cmd=${1:-help} a
  if (($# > 0)); then shift; fi
  for a in "$@"; do # the first non-flag argument names the repo
    if [[ $a != --* ]]; then
      load_repo_env "$a"
      break
    fi
  done
  case $cmd in
    run)
      take_flags "$@"
      ((${#ARGS[@]} == 2)) || die "usage: factory run [--pr] [--auto] [--no-copilot] [--fresh] <repo> <bead-id | task>"
      need_all "${RUN_TOOLS[@]}"
      run_task "${ARGS[0]}" "${ARGS[1]}"
      ;;
    next)
      take_flags "$@"
      ((${#ARGS[@]} == 1)) || die "usage: factory next [--pr] [--auto] [--no-copilot] [--fresh] <repo>"
      need_all "${RUN_TOOLS[@]}"
      cmd_next "${ARGS[0]}"
      ;;
    queue)
      take_flags "$@"
      ((${#ARGS[@]} >= 1)) || die "usage: factory queue [--pr] [--auto] [--no-copilot] [--fresh] <repo> [max]"
      need_all "${RUN_TOOLS[@]}"
      cmd_queue "${ARGS[@]}"
      ;;
    sync)
      (($# == 1)) || die "usage: factory sync <repo>"
      need bd
      cmd_sync "$1"
      ;;
    tasks)
      (($# >= 1)) || die "usage: factory tasks <repo> [--all | bd list args...]"
      need bd
      cmd_tasks "$@"
      ;;
    add)
      (($# >= 1)) || die "usage: factory add <repo> [\"title\" [description]]"
      need bd
      cmd_add "$@"
      ;;
    init)
      (($# >= 1)) || die "usage: factory init <repo> [bd init args...]"
      need bd
      cmd_init "$@"
      ;;
    approve)
      (($# == 2 || $# == 3)) || die "usage: factory approve <repo> <bead-id> [--allow-protected]"
      cmd_approve "$@"
      ;;
    reject)
      (($# == 3)) || die "usage: factory reject <repo> <bead-id> \"note\""
      cmd_reject "$1" "$2" "$3"
      ;;
    answer)
      (($# >= 2)) || die "usage: factory answer <repo> <bead-id> [\"answers\" | -]  (stdin when omitted or -)"
      cmd_answer "$@"
      ;;
    pr)
      take_flags "$@"
      ((${#ARGS[@]} == 2)) || die "usage: factory pr [--no-copilot] <repo> <bead-id>"
      need_all gh bd jq git
      cmd_pr "${ARGS[0]}" "${ARGS[1]}"
      ;;
    clean)
      (($# >= 1)) || die "usage: factory clean <repo> [bead-id] [--force]"
      need_all herdr bd jq git
      cmd_clean "$@"
      ;;
    check)
      (($# == 2)) || die "usage: factory check <worktree> <base>"
      need git
      cmd_check "$1" "$2"
      ;;
    status) need herdr && cmd_status ;;
    doctor) cmd_doctor ;;
    -h | --help | help) usage ;;
    -V | --version) printf 'factory %s\n' "$FACTORY_VERSION" ;;
    *) die "unknown command: $cmd (try: factory help)" ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  FACTORY_PID=$$
  trap 'exit 1' USR1 # a die in a subshell, see die
  main "$@"
  exit # never read on past this: a run takes hours, and the file on disk may have changed
fi
